@@ -1439,6 +1447,36 @@ void xroar_init_finish(void) {
 		}
 	}
 
+	// Inject raw binaries straight into RAM (-load-ram), after any snapshot.
+	load_ram_apply();
+
+	// -export-ram FILE: tool mode. Dump the loaded snapshot's flat physical
+	// RAM (machine->dump_ram, same writer as a .ram trap-snap) and exit.
+	// This is the ONE supported way to get at snapshot RAM from outside;
+	// external tools must not parse the serialised snapshot format.
+	if (private_cfg.file.export_ram) {
+		if (!private_cfg.file.snapshot) {
+			fprintf(stderr, "xroar: -export-ram requires -load SNAPSHOT\n");
+			exit(1);
+		}
+		if (!xroar.machine || !xroar.machine->dump_ram) {
+			fprintf(stderr, "xroar: -export-ram: machine does not support RAM dump\n");
+			exit(1);
+		}
+		FILE *xfd = fopen(private_cfg.file.export_ram, "wb");
+		if (!xfd) {
+			fprintf(stderr, "xroar: -export-ram %s: %s\n",
+			        private_cfg.file.export_ram, strerror(errno));
+			exit(1);
+		}
+		xroar.machine->dump_ram(xroar.machine, xfd);
+		long xlen = ftell(xfd);
+		fclose(xfd);
+		fprintf(stderr, "[export-ram] wrote %s (%ld bytes)\n",
+		        private_cfg.file.export_ram, xlen);
