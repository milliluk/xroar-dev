From aa5c0cfb24618f07f15b00fb861495cf3c52d81e Mon Sep 17 00:00:00 2001
From: milliluk-erik <build@localhost>
Date: Mon, 3 Aug 2026 12:40:57 -0400
Subject: [PATCH 16/49] physical-ram: -load-ram (raw/decb/hex/srec loader) +

The raw loader looked up the machine's RAM part by the id "RAM" only, and
the MC-10 splits its RAM across two parts, RAM0/RAM1 -- so on that
machine a raw -load-ram warned "machine has no RAM to load into" despite
the RAM being right there under different ids.  The lookup now goes
through flat_ram_resolve (patch 9): every machine's flat RAM as an
ordered pair, "RAM" alone everywhere else, the MC-10's RAM0 at [0, size0)
with RAM1 above it, so addr= reaches the whole machine, 16K expansion
included.  (The parts keep their names: their organisations differ -- 2K
banks vs 4K banks -- so they could never have merged into one part, and
renaming was only ever cosmetic.)

The MC-10's dump_ram wrote a file no flat address described: RAM0's
present banks, then RAM1's present banks in CREATION order -- 1,2,3,0,
because the expansion adds bank 0 last -- with absent banks silently
skipped.  -export-ram (and every later dump_ram consumer) promises file
offset == flat physical address == what addr= means here, and the coco3
and dragon dumps already keep that promise, so the MC-10 dump now writes
both parts' banks in index order with absent banks zero-filled.
---
 src/mc10.c  |  29 ++++---
 src/xroar.c | 215 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 232 insertions(+), 12 deletions(-)

diff --git a/src/mc10.c b/src/mc10.c
index f38847e..fa1229f 100644
--- a/src/mc10.c
+++ b/src/mc10.c
@@ -855,18 +855,23 @@ static void mc10_op_rts(struct machine *m) {
 
 static void mc10_dump_ram(struct machine *m, FILE *fd) {
 	struct mc10 *mp = (struct mc10 *)m;
-	struct ram *ram0 = mp->RAM0;
-	for (unsigned bank = 0; bank < ram0->nbanks; bank++) {
-		if (ram0->d && ram0->d[bank]) {
-			fwrite(ram0->d[bank], ram0->bank_nelems, 1, fd);
-		}
-	}
-	struct ram *ram1 = mp->RAM1;
-	if (ram1) {
-		for (unsigned i = 0; i < ram1->nbanks; i++) {
-			unsigned bank = (i + 1) & 3;
-			if (ram1->d && ram1->d[bank]) {
-				fwrite(ram1->d[bank], ram1->bank_nelems, 1, fd);
+	// Both parts, banks in index order, absent banks zero-filled, so that
+	// file offset == flat physical address (RAM0 at 0, RAM1 above it) ==
+	// the addressing -load-ram's addr= uses.  Upstream wrote only the
+	// PRESENT banks, RAM1's in creation order (1,2,3,0 -- the expansion
+	// adds bank 0 last), which matched no address space at all.
+	struct ram *rams[2] = { mp->RAM0, mp->RAM1 };
+	for (unsigned i = 0; i < 2; i++) {
+		struct ram *ram = rams[i];
+		if (!ram)
+			continue;
+		for (unsigned bank = 0; bank < ram->nbanks; bank++) {
+			if (ram->d && ram->d[bank]) {
+				fwrite(ram->d[bank], ram->bank_nelems, 1, fd);
+			} else {
+				for (size_t z = 0; z < ram->bank_nelems; z++) {
+					fputc(0, fd);
+				}
 			}
 		}
 	}
