+// Physical fetch-range breakpoints.  Kept in list[0] of a watchpoint set --
+// the range-matching is identical, only the event differs (instruction fetch
+// rather than data access).  Dispatched from the instruction hook wrapper
+// below, which pays the one translation per fetch only while non-empty.
+static void coco3_add_pbreak(struct machine *m, uint32_t Astart, uint32_t Aend,
+			     DELEGATE_T3(void, bool, uint32, uint8) handler) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	bp_watchpoint_add(&mcc3->pbreak_set, 0, Astart, Aend, handler);
+	coco3_instruction_hook_update(mcc3);
+}
+
+static void coco3_remove_pbreak(struct machine *m, uint32_t Astart, uint32_t Aend,
+				DELEGATE_T3(void, bool, uint32, uint8) handler) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	bp_watchpoint_remove(&mcc3->pbreak_set, 0, Astart, Aend, handler);
+	coco3_instruction_hook_update(mcc3);
+}
+
+// Instruction hook wrapper: logical dispatch always; physical fetch-range
+// dispatch (one translation) only while pbreak ranges exist.
+static void coco3_instruction_hook(void *sptr, uint32_t A) {
+	struct coco3 *mcc3 = sptr;
+	bp_instruction_hook(&mcc3->breakpoint_set, A);
+	if (mcc3->pbreak_set.list[0]) {
+		uint32_t phys = tcc1014_logical_to_physical(mcc3->GIME, (uint16_t)A);
+		bp_check_watchpoints(&mcc3->pbreak_set, 0, phys, 0);
+	}
+}
+
+// One decision over everything that needs the CPU fetch hook.
+static void coco3_instruction_hook_update(struct coco3 *mcc3) {
+	if (bp_breakpoint_set_active(&mcc3->breakpoint_set) || mcc3->pbreak_set.list[0]) {
+		mcc3->CPU->instruction_hook = DELEGATE_AS1(void, uint32, coco3_instruction_hook, mcc3);
+	} else {
+		mcc3->CPU->instruction_hook.func = NULL;
+	}
+}
