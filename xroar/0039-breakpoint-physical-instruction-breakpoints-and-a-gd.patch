@@ -869,10 +897,31 @@ static int send_char(struct gdb_interface_private *gip, char c) {
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 
+// The stop reply.  A 'T' packet on every machine.  On a GIME machine it
+// carries the physical context of the stop -- the same four values qxroar.xpc
+// / .block / .task / .paddr answer, computed here at the moment of the stop.
+// A logical PC alone does not say where a stop happened on that machine: the
+// same $6xxx can be any of eleven banks.  Sending it with the stop saves the
+// client a query round trip per stop, and more importantly makes the answer
+// atomic with the stop rather than "whatever is mapped by the time you ask".
+// A machine with no MMU sends the same packet without the MMU pairs -- 'T'
+// rather than 'S', so a machine-independent field added to this reply reaches
+// every machine instead of riding the GIME branch.
 static void send_last_signal(struct gdb_interface_private *gip) {
-	char tmpbuf[4];
-	snprintf(tmpbuf, sizeof(tmpbuf), "S%02x", gip->last_signal);
-	send_packet(gip, tmpbuf, 3);
+	char tmpbuf[64];
+	uint16_t pc = mc6809_get_pc(gip->cpu);
+	// With no MMU the physical PC is the logical PC -- the same degrade
+	// trap_fast_phys() applies everywhere else in this fork.
+	unsigned xpc = pc;
+	int n = snprintf(tmpbuf, sizeof(tmpbuf), "T%02x", gip->last_signal);
+	if (gip->gime) {
+		xpc = tcc1014_logical_to_physical(gip->gime, pc) & 0x7ffff;
+		n += snprintf(tmpbuf + n, sizeof(tmpbuf) - (size_t)n,
+			      "xpc:%05x;block:%02x;task:%02x;paddr:%05x;",
+			      xpc, (xpc >> 13) & 0xff,
+			      tcc1014_get_task(gip->gime), gip->gime->Z & 0x7ffff);
+	}
+	send_packet_string(gip, tmpbuf);
 }
 
