+			// Qxroar.pbreak:PADDR[,LEN] / Qxroar.pbreak-:PADDR[,LEN] --
+			// set or clear an instruction breakpoint on a flat PHYSICAL
+			// address (hex, no prefix; LEN bytes, default 1). The
+			// breakpoint matches the physical address the MMU maps the PC
+			// to at each fetch, so it fires only in the bank that owns
+			// the code, and it reaches every bank -- neither of which a
+			// logical Z0 can do on a machine that pages eleven blocks
+			// through one window. Replaces the client-side idiom of
+			// stopping on a logical address, querying the block, and
+			// continuing past every wrong-bank hit.
+			char *addrs = strsep(&args, ",");
+			if (!addrs || !*addrs) { send_packet_string(gip, "E00"); return; }
+			unsigned long A = strtoul(addrs, NULL, 16);
+			unsigned long len = (args && *args) ? strtoul(args, NULL, 16) : 1;
+			if (!len || A > 0x7ffff || (A + len - 1) > 0x7ffff) {
+				send_packet_string(gip, "E00");
+				return;
+			}
+			if (set[6] == '-')
+				machine_remove_hbreak_phys(gip->machine, (uint32_t)A, (uint32_t)(A + len - 1));
+			else
+				machine_add_hbreak_phys(gip->machine, (uint32_t)A, (uint32_t)(A + len - 1));
+			send_packet_string(gip, "OK");
+			return;
+		}
+		if (0 == strcmp(set, "pwatch") || 0 == strcmp(set, "pwatch-")) {
+			// Qxroar.pwatch:T,PADDR[,LEN] / Qxroar.pwatch-:T,PADDR[,LEN]
+			// -- set or clear a PHYSICAL watchpoint, matched against the
+			// address the machine's own decode produced for the RAM cycle.
+			// T is the Z packet's type number (2 write, 3 read, 4 access)
+			// so one numbering serves both. A logical Z2 sees a write only
+			// through the window it was set in; this sees it wherever the
+			// byte is banked, without the eight-slot-alias workaround that
+			// needed one stop per wrong alias.
+			char *types = strsep(&args, ",");
+			if (!types || !args) { send_packet_string(gip, "E00"); return; }
+			// Z-packet numbering: 2 write, 3 read, 4 access.
+			unsigned type = (unsigned)strtoul(types, NULL, 16);
+			if (type < 2 || type > 4) {
+				send_packet_string(gip, "E00");
+				return;
+			}
+			char *addrs = strsep(&args, ",");
+			if (!addrs || !*addrs) { send_packet_string(gip, "E00"); return; }
+			unsigned long A = strtoul(addrs, NULL, 16);
+			unsigned long len = (args && *args) ? strtoul(args, NULL, 16) : 1;
+			// 19 bits stock, 21 with a DAT board -- the same bound the
+			// -trap read=/write=/access= physical path takes.
+			if (!len || A > 0x1fffff || (A + len - 1) > 0x1fffff) {
+				send_packet_string(gip, "E00");
+				return;
+			}
+			if (set[6] == '-') {
+				if (type == 2 || type == 4)
+					machine_remove_hwatch_phys(gip->machine, 0, (uint32_t)A, (uint32_t)(A + len - 1));
+				if (type == 3 || type == 4)
+					machine_remove_hwatch_phys(gip->machine, 1, (uint32_t)A, (uint32_t)(A + len - 1));
