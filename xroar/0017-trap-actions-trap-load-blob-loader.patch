-// Inlined watchpoint match & dispatch
-inline void bp_check_watchpoints(struct bp_watchpoint_set *set, bool RnW, uint32_t A) {
+			  DELEGATE_T3(void, bool, uint32, uint8) handler);
+
+// Inlined watchpoint match & dispatch.  D is the byte on the CPU data bus at
+// dispatch time: authoritative for writes (the byte being written), best
+// effort for reads on machines that check before the bus settles.  Carried so
+// value-qualified traps and trap actions can see what moved without a
+// re-read that would hit I/O twice.
+inline void bp_check_watchpoints(struct bp_watchpoint_set *set, bool RnW, uint32_t A, uint8_t D) {
 	struct bp_watchpoint *list = set->list[RnW];
 	struct bp_watchpoint *next;
 	for (struct bp_watchpoint *iter = list; iter; iter = next) {
 		next = iter->next;
 		if (A >= iter->Astart && A <= iter->Aend) {
-			DELEGATE_CALL(iter->handler, RnW, A);
+			DELEGATE_CALL(iter->handler, RnW, A, D);
 		}
 	}
 }
