+// Headless render instance for -trap-screenshot.  The null UI hands back a
+// vo_interface with no renderer, so the machine's per-scanline render calls go
+// to a no-op and nothing is buffered to capture.  When a screenshot trap is
+// configured we attach a software vo_render here (no display, no GL): the
+// machine's palette / active-area / render delegates then land on it via
+// vo_set_renderer(), every frame is rasterised into a CPU buffer, and
+// screenshot_write_png() reads it through line_to_rgb().  This mirrors the
+// renderer setup in vo_opengl_new() with the GL texture path removed.
+
+#define SS_MAX_VIEWPORT_WIDTH  (800)
+#define SS_MAX_VIEWPORT_HEIGHT (300)
+
+int screenshot_setup_render(struct vo_interface *vo) {
+	if (!vo)
+		return -1;
+	if (vo->renderer)
+		return 0;               // real display build already has one
+
+	struct vo_render *vr = vo_render_new(VO_RENDER_FMT_RGBA8);
+	if (!vr) {
+		LOG_MOD_ERROR("screenshot", "could not create render instance\n");
+		return -1;
+	}
+	// Wires render_line + the palette/active-area delegates the machine
+	// drives, and sets vo->renderer.
+	vo_set_renderer(vo, vr);
+
+	void *buffer = xmalloc(SS_MAX_VIEWPORT_WIDTH * SS_MAX_VIEWPORT_HEIGHT * 4);
+	memset(buffer, 0, SS_MAX_VIEWPORT_WIDTH * SS_MAX_VIEWPORT_HEIGHT * 4);
+	vo_render_set_buffer(vr, buffer);
+
+	// Full CoCo3/Dragon viewport, same defaults vo_opengl uses before any
+	// UI resize.  buffer_pitch must match the viewport width.
+	vo_render_set_viewport(vr, 640, 240);
+	vr->buffer_pitch = 640;
+
+	LOG_MOD_DEBUG(1, "screenshot", "headless render instance ready\n");
+	return 0;
+}
+
+// --- Deferred ("when=next") capture -----------------------------------------
+// By default a trap screenshot is deferred to the next fully-rendered frame so
+// a page flip / VIEW the trap-triggering code just performed is actually
+// visible.  "when=now" restores the historical behaviour of grabbing the buffer
+// as-is at the trap instant.  The buffer, the renderer and the pending slot are
+// all global (one VO), so this state is module-global too.
+
+static int ss_defer = 1;          // 1 = wait for next clean frame (default)
+static char *ss_pending = NULL;   // filename awaiting a clean frame, or NULL
+static int ss_wait_fields = 0;    // rendered fields still to wait
+
+void screenshot_set_defer(int defer) {
+	ss_defer = defer ? 1 : 0;
+}
+
+void screenshot_flush(struct vo_interface *vo) {
+	if (!ss_pending)
+		return;
+	screenshot_write_png(ss_pending, vo);
+	free(ss_pending);
+	ss_pending = NULL;
+	ss_wait_fields = 0;
+}
+
+void screenshot_request(const char *filename, struct vo_interface *vo) {
+	if (!ss_defer) {
+		screenshot_write_png(filename, vo);
+		return;
+	}
+	// Don't drop an earlier pending capture if a second trap fires first.
+	if (ss_pending)
+		screenshot_flush(vo);
+	ss_pending = xstrdup(filename);
+	// The field in progress at the trap latched the old GIME state and may be
+	// torn, so it finishes at the next vsync but isn't trustworthy.  The field
+	// after that is the first one rendered wholly post-trap: capture it.
+	ss_wait_fields = 2;
+}
+
+void screenshot_on_vsync(struct vo_interface *vo, int draw) {
+	if (!ss_pending || !draw)
+		return;
+	if (--ss_wait_fields > 0)
+		return;
+	screenshot_write_png(ss_pending, vo);
+	free(ss_pending);
+	ss_pending = NULL;
+}
