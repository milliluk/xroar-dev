+// lwasm emuext LOG screenshot commands (CMD 1 = now, CMD 2 = next frame).  The
+// core hands over one byte of defer flag (0 = now, 1 = defer to vsync) followed
+// by the raw filename template from ROM; everything policy-shaped lives here.
+// One shared copy, for every machine that wires the delegate -- nothing in it
+// touches machine state, so a per-machine copy would only be a copy.
+//
+// Template tokens:
+//   {##}   two-digit auto index, 00 upward, one step per shot this run.
+//   an optional "basename:" prefix is stripped -- it is a readability marker
+//   in ROM source, nothing more; the output is always a basename in a fixed
+//   directory regardless.
+//
+// Safety: the template comes from emulated RAM, so a wild pointer must not be
+// able to scribble outside the sandbox.  Any '/' in the template is rewritten
+// to '_' and the result is dropped into a fixed output dir ($XROAR_DEV_SHOT_DIR,
+// or the current directory).  ROM cannot choose an absolute path through a
+// debug opcode, by design.
+//
+// Cap: 99 shots per process, counted at REQUEST time.  A deferred shot that
+// never reaches its vsync (the run ends first) still burns an index -- the cap
+// is a runaway guard, and counting requests is what stops a deferred loop from
+// queueing thousands of names.  The cost is that a CMD 2 fired on the very last
+// instruction of a run may not land on disk; shoot it CMD 1, or leave the
+// machine a frame to run.  Hit 99 and the command stops writing and stays
+// silent, no wrap, no overwrite.
+#define EMUEXT_SHOT_CAP 99
+
+void emuext_shot(const char *arg) {
+	static unsigned shot_count = 0;
+
+	if (shot_count >= EMUEXT_SHOT_CAP)
+		return;                          // cap reached: silent, as specified
+
+	int defer = (arg[0] != 0);               // byte 0: 0 = now, 1 = next frame
+	const char *tmpl = arg + 1;
+
+	// Drop an optional "basename:" readability prefix.
+	const char *src = tmpl;
+	const char *colon = strchr(tmpl, ':');
+	if (colon && (size_t)(colon - tmpl) == strlen("basename") &&
+	    0 == strncmp(tmpl, "basename", strlen("basename")))
+		src = colon + 1;
+
+	// Expand into a basename buffer: {##} -> two-digit index, '/' -> '_'.
+	char base[256];
+	unsigned b = 0;
+	_Bool had_index = 0;
+	for (unsigned i = 0; src[i] && b < sizeof(base) - 3; i++) {
+		if (src[i] == '{' && src[i+1] == '#' && src[i+2] == '#' && src[i+3] == '}') {
+			b += snprintf(base + b, sizeof(base) - b, "%02u", shot_count);
+			had_index = 1;
+			i += 3;                      // step past "##}" (loop's i++ eats '{')
+			continue;
+		}
+		base[b++] = (src[i] == '/') ? '_' : src[i];
+	}
+	base[b] = 0;
+	if (b == 0) {                            // empty template: give it a name
+		snprintf(base, sizeof(base), "emushot-%02u", shot_count);
+		had_index = 1;
+	}
+	if (!strchr(base, '.')) {                // no extension: it is a PNG
+		size_t l = strlen(base);
+		snprintf(base + l, sizeof(base) - l, ".png");
+	}
+
+	// "." and not "/tmp": this fork builds for Windows as a first-class
+	// target, where /tmp does not exist and guest-requested shots would
+	// land nowhere at all, silently.  The cwd exists everywhere, and the
+	// sandbox property is unchanged -- base is still a sanitised basename.
+	const char *dir = getenv("XROAR_DEV_SHOT_DIR");
+	if (!dir || !*dir) dir = ".";
+	char path[512];
+	snprintf(path, sizeof(path), "%s/%s", dir, base);
+
+	// The headless render instance is normally attached at init when a
+	// screenshot trap is present (see xroar.c).  With -emuext we attach it
+	// there too, so by here vo_interface->renderer exists and holds a real
+	// frame.  Belt and braces: attach on demand if somehow missing.
+	if (!xroar.vo_interface || !xroar.vo_interface->renderer)
+		screenshot_setup_render(xroar.vo_interface);
+
+	// CMD 1 grabs the buffer as-is at the LOG instant; CMD 2 parks the name
+	// and lets screenshot_on_vsync fire it at the next completed frame, so a
+	// page flip / VIEW this code just did is actually visible.
+	screenshot_set_defer(defer);
+	screenshot_request(path, xroar.vo_interface);
+
+	LOG_MOD_DEBUG(1, "emu", "SHOT %u (%s) -> %s%s\n", shot_count,
+	              defer ? "next" : "now", path,
+	              had_index ? "" : " (no {##}: each shot overwrites)");
+	shot_count++;
+}
