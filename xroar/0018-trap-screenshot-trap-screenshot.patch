diff --git a/src/mc6809/mc6809_common.c b/src/mc6809/mc6809_common.c
index 16dfb44..6a964ab 100644
--- a/src/mc6809/mc6809_common.c
+++ b/src/mc6809/mc6809_common.c
@@ -124,6 +124,84 @@ static _Bool mc6809_emuext_supported(struct MC6809 *cpu) {
 	return cpu->debug.cpu.debug_read.func != NULL;
 }
 
+// LOG command forms.  A format string whose FIRST byte is 0 is not text (an
+// empty string prints nothing) so it is free to mean "command".  Byte 0 is the
+// sentinel, byte 1 selects the command, the rest is that command's payload.
+// Only 0-then-nonzero is a command; a lone 0 stays an empty text log.  Each
+// command consumes no argument pointers, so PC advances past just the single
+// format pointer (the 2 opcode bytes were already stepped over by the decoder).
+//
+//   CMD 1  screenshot NOW.   Grab the rendered buffer at the instant this LOG
+//                            executes.  Point sample for a specific moment.
+//   CMD 2  screenshot NEXT.  Defer to the next completed video frame, so a
+//                            page flip / VIEW this code just did is visible.
+//          Both take a filename template, NUL-terminated:
+//          "basename:my-shot-{##}".  {##} expands to a two-digit auto index,
+//          00 upward, one per shot this run.  The machine side clamps the
+//          path to a basename in a fixed output dir and caps the run at 99.
+//
+// Extend by claiming another CMD byte; the text path never sees any of this.
+#define EMUEXT_CMD_SHOT_NOW  1
+#define EMUEXT_CMD_SHOT_NEXT 2
+
+static _Bool mc6809_emuext_command(struct MC6809 *cpu, uint16_t fmt, uint16_t after) {
+	uint8_t b0 = DELEGATE_CALL(cpu->debug.cpu.debug_read, fmt);
+	if (b0 != 0)
+		return 0;                        // ordinary text (or an empty log)
+	uint8_t cmd = DELEGATE_CALL(cpu->debug.cpu.debug_read, fmt + 1);
+	if (cmd == 0)
+		return 0;                        // bare 0: an empty text log, not a command
+
+	// -emuext off: a command can't run, and there is nothing useful to
+	// print.  Warn ONCE, then leave PC on the operands so the program runs
+	// into its own data and faults -- same "you forgot -emuext" outcome as a
+	// text log, so the failure teaches the same lesson.  The warning explains
+	// the crash that is about to happen.
+	if (!cpu->debug.cpu.emuext) {
+		static _Bool warned = 0;
+		if (!warned) {
+			warned = 1;
+			fprintf(stderr, "[emu] LOG command hit with -emuext off; "
+			        "PC not advanced, the program will now crash. "
+			        "Pass -emuext.\n");
+		}
+		return 1;                        // handled: do NOT advance PC
+	}
+
+	if (cmd == EMUEXT_CMD_SHOT_NOW || cmd == EMUEXT_CMD_SHOT_NEXT) {
+		// Read the template (byte 2 onward) into a local buffer, with the
+		// defer flag as a one-byte prefix so the single instruction_shot
+		// delegate carries both.  The machine-side handler does token
+		// expansion, the path clamp and the 99 cap; the core just ferries
+		// the string across, same shape as instruction_log.
+		char arg[258];
+		arg[0] = (cmd == EMUEXT_CMD_SHOT_NEXT) ? 1 : 0;   // 1 = defer to vsync
+		unsigned t = 1;
+		for (unsigned i = 2; t < sizeof(arg) - 1; i++) {
+			uint8_t c = DELEGATE_CALL(cpu->debug.cpu.debug_read, fmt + i);
+			if (c == 0) break;
+			arg[t++] = c;
+		}
+		arg[t] = 0;
+		REG_PC = after;                  // consume the format pointer
+		DELEGATE_SAFE_CALL(cpu->debug.cpu.instruction_shot, arg);
+		return 1;
+	}
+
+	// Unknown command: advance past the pointer so a newer ROM talking to an
+	// older emulator skips cleanly instead of crashing, and say so once.
+	{
+		static _Bool warned_unknown = 0;
+		if (!warned_unknown) {
+			warned_unknown = 1;
+			fprintf(stderr, "[emu] LOG command %u unknown to this build; "
+			        "skipped.\n", (unsigned)cmd);
+		}
+	}
+	REG_PC = after;
+	return 1;
+}
+
 static void mc6809_emuext_log(struct MC6809 *cpu) {
 	if (!mc6809_emuext_supported(cpu))
 		return;                  // no emuext here: native illegal opcode
@@ -131,6 +209,12 @@ static void mc6809_emuext_log(struct MC6809 *cpu) {
 	uint16_t fmt = DELEGATE_CALL(cpu->debug.cpu.debug_read, p) << 8; p++;
 	fmt |= DELEGATE_CALL(cpu->debug.cpu.debug_read, p); p++;
 
+	// Command form (format string starts 0, CMD): handled entirely here, no
+	// text formatting.  p already points past the single format pointer.
+	if (mc6809_emuext_command(cpu, fmt, p))
+		return;
+
+
 	char out[1024];
 	unsigned o = 0;
 	_Bool terminated = 0;
