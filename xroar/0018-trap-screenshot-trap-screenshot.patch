+// as-is at the trap instant (historical behaviour).
+void screenshot_set_defer(int defer);
+
+// Take a screenshot per the current timing mode: write now, or arm a deferred
+// capture serviced by screenshot_on_vsync().
+void screenshot_request(const char *filename, struct vo_interface *vo);
+
+// Service a pending deferred capture; call once per field sync.  draw matches
+// vo_vsync()'s draw flag (0 during frameskip) so only rendered fields count.
+void screenshot_on_vsync(struct vo_interface *vo, int draw);
+
+// Write any pending deferred capture immediately (e.g. at shutdown).
+void screenshot_flush(struct vo_interface *vo);
+
 #endif
