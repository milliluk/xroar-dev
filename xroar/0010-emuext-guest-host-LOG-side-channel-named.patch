index 9bbb24e..1e12781 100644
--- a/src/mc6809/hd6309.c
+++ b/src/mc6809/hd6309.c
@@ -481,6 +481,10 @@ static void hd6309_run(struct MC6809 *cpu) {
 			hcpu->state = hd6309_state_label_a;
 			switch (op) {
 
+			// emuext (pragma emuext): LOG $103E (page 2), BREAK $113E (page 3)
+			case 0x023e: mc6809_emuext_log(cpu); break;
