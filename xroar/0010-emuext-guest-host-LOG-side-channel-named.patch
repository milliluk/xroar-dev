 			// 0x50 - 0x5f inherent B register ops
diff --git a/src/mc6809/mc6809.c b/src/mc6809/mc6809.c
index acafec4..e136ee0 100644
--- a/src/mc6809/mc6809.c
+++ b/src/mc6809/mc6809.c
@@ -1315,8 +1315,12 @@ static void mc6809_run(struct MC6809 *cpu) {
 				NVMA_CYCLE;
 			} break;
 
-			// 0x103e SWI2 inherent, illegal
+			// 0x103e LOG (emuext) / SWI2 inherent, illegal
 			case 0x023e:
+				mc6809_emuext_log(cpu);
+				if (cpu->debug_cpu.emuext)
+					break;
+				// -emuext off: native illegal behaviour (no live patch)
 				peek_byte(cpu, REG_PC);
 				push_irq_registers(cpu);
 				instruction_posthook(cpu);
@@ -1331,8 +1335,12 @@ static void mc6809_run(struct MC6809 *cpu) {
 				take_interrupt(cpu, 0, MC6809_INT_VEC_SWI2);
 				continue;
 
-			// 0x113e FIRQ inherent, illegal [hoglet67]
+			// 0x113e BREAK (emuext) / FIRQ inherent, illegal [hoglet67]
 			case 0x033e:
+				mc6809_emuext_break(cpu);
+				if (cpu->debug_cpu.emuext)
+					break;
+				// -emuext off: native illegal behaviour (no live patch)
 				peek_byte(cpu, REG_PC);
 				push_irq_registers(cpu);
 				instruction_posthook(cpu);
diff --git a/src/mc6809/mc6809_common.c b/src/mc6809/mc6809_common.c
index ff4907a..296960d 100644
--- a/src/mc6809/mc6809_common.c
+++ b/src/mc6809/mc6809_common.c
@@ -87,6 +87,161 @@ static void store_byte(struct MC6809 *cpu, uint16_t a, uint8_t d) {
 #define peek_byte(c,a) ((void)fetch_byte_notrace(c,a))
 #define NVMA_CYCLE (peek_byte(cpu, 0xffff))
 
+/*
+ * lwasm emulator-extension opcodes (pragma emuext): LOG ($103E) and BREAK
+ * ($113E).  Always decoded so behaviour is well defined, and routed to the
+ * machine through debug_cpu delegates.
+ *
+ * LOG operands (in the instruction stream, after the opcode): a 16-bit pointer
+ * to a printf-style format string, then one 16-bit pointer per conversion.
+ * Args are passed by pointer; 'h' is 16-bit, 'hh' is 8-bit.  Reads go through
+ * the normal bus (mem_cycle), so they respect the MMU and cost cycles.
+ *
+ * With emuext enabled the operands are consumed (PC advanced past 2 + 2N
+ * bytes) and the text is emitted.  With emuext *disabled* a genuine LOG (a
+ * terminated format string containing a conversion) is still echoed to stderr
+ * as a courtesy, but PC is NOT advanced: the trailing pointers then execute as
+ * instructions, the intended "you forgot -emuext" failure.  Nothing is patched
+ * to keep a disabled program running.
+ */
+
+static void mc6809_emuext_log(struct MC6809 *cpu) {
+	uint16_t p = REG_PC;             // cursor over operands; REG_PC untouched
+	uint16_t fmt = DELEGATE_CALL(cpu->debug_cpu.debug_read, p) << 8; p++;
+	fmt |= DELEGATE_CALL(cpu->debug_cpu.debug_read, p); p++;
+
+	char out[1024];
+	unsigned o = 0;
+	_Bool terminated = 0;
+	_Bool has_conv = 0;
+
+	for (unsigned i = 0; i < 256 && o < sizeof(out) - 1; i++) {
+		uint8_t c = DELEGATE_CALL(cpu->debug_cpu.debug_read, fmt + i);
+		if (c == 0) { terminated = 1; break; }
+
+		// ${name}: read CPU/machine state directly, consumes NO argument
+		// pointer. Names match the gdb qxroar.* query vocabulary:
+		//   a b cc dp   8-bit  -> 2 hex     d x y u s pc  16-bit -> 4 hex
+		//   xpc paddr   phys   -> 5 hex     block task    -> 2 hex
+		//   cycles      event_current_tick -> decimal
+		// A bare '$' not followed by '{' is emitted literally.
+		if (c == '$') {
+			uint8_t n1 = DELEGATE_CALL(cpu->debug_cpu.debug_read, fmt + i + 1);
+			if (n1 != '{') { out[o++] = c; continue; }  // literal $
+			char name[16];
+			unsigned nl = 0;
+			unsigned j = i + 2;
+			while (j < 256 && nl < sizeof(name) - 1) {
+				uint8_t nc = DELEGATE_CALL(cpu->debug_cpu.debug_read, fmt + j);
+				if (nc == '}' || nc == 0) break;
+				name[nl++] = nc;
+				j++;
+			}
+			name[nl] = 0;
+			i = j;  // advance past '}' (loop's i++ steps over it)
+			has_conv = 1;
+
+			extern uint32_t event_current_tick;
+			char piece[32];
+			if      (0 == strcmp(name, "a"))   snprintf(piece, sizeof(piece), "%02x", REG_A);
+			else if (0 == strcmp(name, "b"))   snprintf(piece, sizeof(piece), "%02x", REG_B);
+			else if (0 == strcmp(name, "cc"))  snprintf(piece, sizeof(piece), "%02x", REG_CC);
+			else if (0 == strcmp(name, "dp"))  snprintf(piece, sizeof(piece), "%02x", REG_DP);
+			else if (0 == strcmp(name, "d"))   snprintf(piece, sizeof(piece), "%04x", REG_D);
+			else if (0 == strcmp(name, "x"))   snprintf(piece, sizeof(piece), "%04x", REG_X);
+			else if (0 == strcmp(name, "y"))   snprintf(piece, sizeof(piece), "%04x", REG_Y);
+			else if (0 == strcmp(name, "u"))   snprintf(piece, sizeof(piece), "%04x", REG_U);
+			else if (0 == strcmp(name, "s"))   snprintf(piece, sizeof(piece), "%04x", REG_S);
+			else if (0 == strcmp(name, "pc"))  snprintf(piece, sizeof(piece), "%04x", REG_PC);
+			else if (0 == strcmp(name, "cycles")) snprintf(piece, sizeof(piece), "%u", (unsigned)event_current_tick);
+			else if (cpu->debug_cpu.state_read.func) {
+				// xpc/paddr/block/task -- machine-specific, routed via a
+				// named state delegate wired in coco3.c.
+				int32_t sv = DELEGATE_CALL(cpu->debug_cpu.state_read, name);
+				if (sv < 0)
+					snprintf(piece, sizeof(piece), "${%s}", name);  // unknown: echo back
+				else if (0 == strcmp(name, "xpc") || 0 == strcmp(name, "paddr"))
+					snprintf(piece, sizeof(piece), "%05x", (unsigned)sv & 0x7ffff);
+				else
+					snprintf(piece, sizeof(piece), "%02x", (unsigned)sv & 0xff);
+			} else {
+				snprintf(piece, sizeof(piece), "${%s}", name);  // unknown: echo back
+			}
+			for (unsigned k = 0; piece[k] && o < sizeof(out) - 1; k++)
+				out[o++] = piece[k];
+			continue;
+		}
+
+		if (c != '%') { out[o++] = c; continue; }
+
+		unsigned hcount = 0;
+		uint8_t cv = 0;
+		for (;;) {
+			i++;
+			cv = (i < 256) ? DELEGATE_CALL(cpu->debug_cpu.debug_read, fmt + i) : 0;
+			if (cv == 'h') { hcount++; continue; }
+			break;
+		}
+		if (cv == '%') { out[o++] = '%'; continue; }  // literal %, no arg
+		has_conv = 1;
+
+		uint16_t ap = DELEGATE_CALL(cpu->debug_cpu.debug_read, p) << 8; p++;
+		ap |= DELEGATE_CALL(cpu->debug_cpu.debug_read, p); p++;
+		unsigned width = (hcount >= 2) ? 1 : 2;  // hh = 8-bit, h/none = 16-bit
+		uint32_t v = DELEGATE_CALL(cpu->debug_cpu.debug_read, ap);
+		if (width == 2) v = (v << 8) | DELEGATE_CALL(cpu->debug_cpu.debug_read, ap + 1);
+
+		char piece[300];
+		switch (cv) {
+		case 'd': case 'i':
+			snprintf(piece, sizeof(piece), "%d",
+			         (int)((width == 1) ? (int8_t)v : (int16_t)v));
+			break;
+		case 'u': snprintf(piece, sizeof(piece), "%u", (unsigned)v); break;
+		case 'x': snprintf(piece, sizeof(piece), "%x", (unsigned)v); break;
+		case 'X': snprintf(piece, sizeof(piece), "%X", (unsigned)v); break;
+		case 'o': snprintf(piece, sizeof(piece), "%o", (unsigned)v); break;
+		case 'c': snprintf(piece, sizeof(piece), "%c", (int)(v & 0xff)); break;
+		case 's': {
+			unsigned q = 0;
+			for (unsigned k = 0; k < sizeof(piece) - 1 && k < 256; k++) {
+				uint8_t sc = DELEGATE_CALL(cpu->debug_cpu.debug_read, ap + k);
+				if (!sc) break;
+				piece[q++] = sc;
+			}
+			piece[q] = 0;
+			break;
+		}
+		default: {  // unsupported conversion: echo spec, arg already consumed
+			unsigned q = 0;
+			piece[q++] = '%';
+			for (unsigned h = 0; h < hcount && h < 2; h++) piece[q++] = 'h';
+			piece[q++] = cv;
+			piece[q] = 0;
+			break;
+		}
+		}
+		for (unsigned k = 0; piece[k] && o < sizeof(out) - 1; k++)
+			out[o++] = piece[k];
+	}
+	out[o] = 0;
+
+	if (cpu->debug_cpu.emuext) {
+		// enabled: consume operands, emit (machine adds gdb mirror)
+		REG_PC = p;
+		if (terminated)
+			DELEGATE_SAFE_CALL(cpu->debug_cpu.instruction_log, out);
+	} else if (terminated && has_conv) {
+		// disabled: echo a genuine LOG, but leave PC at the operands so
+		// the program runs into them and fails -- no live patch
+		DELEGATE_SAFE_CALL(cpu->debug_cpu.instruction_log, out);
+	}
+}
+
+static void mc6809_emuext_break(struct MC6809 *cpu) {
+	DELEGATE_SAFE_CALL(cpu->debug_cpu.instruction_break);
+}
