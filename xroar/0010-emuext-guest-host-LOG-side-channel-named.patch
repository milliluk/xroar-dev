+bool gdb_connected(struct gdb_interface *gi);
+void gdb_console_output(struct gdb_interface *gi, const char *s);
 bool gdb_signal_lock(struct gdb_interface *gi, int sig);
 
 #endif
diff --git a/src/mc6809/hd6309.c b/src/mc6809/hd6309.c
index 9bbb24e..1e12781 100644
--- a/src/mc6809/hd6309.c
+++ b/src/mc6809/hd6309.c
@@ -481,6 +481,10 @@ static void hd6309_run(struct MC6809 *cpu) {
 			hcpu->state = hd6309_state_label_a;
