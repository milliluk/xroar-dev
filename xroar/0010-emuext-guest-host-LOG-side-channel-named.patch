+// lwasm emuext opcode handlers (wired into the CPU's debug_cpu delegates)
+static void dragon_emubreak(void *sptr);
+static void dragon_emulog(void *sptr, const char *s);
+static uint8_t dragon_emuread(void *sptr, uint16_t A);
+static int32_t dragon_emustate(void *sptr, const char *name);
+
 static void single_bit_feedback(void *sptr, bool level);
 static void update_audio_from_tape(void *sptr, float value);
 static void cart_firq(void *sptr, bool level);
@@ -628,6 +634,18 @@ bool dragon_finish_common(struct dragon *md) {
 	}
 #endif
 
+	// lwasm emulator extensions (pragma emuext).  The Dragon family runs the
+	// same 6809 core as the CoCo 3, which decodes LOG and BREAK for whatever
+	// machine it is driving -- so this is not optional decoration, it is the
+	// other half of a contract the core already entered into.  Wiring it here
+	// covers every machine built on dragon_finish_common(): Dragon 32/64,
+	// Dragon Professional, CoCo 1/2 and the Deluxe CoCo.
+	md->CPU->debug.cpu.emuext = xroar.cfg.debug.emuext;
+	md->CPU->debug.cpu.instruction_break = DELEGATE_AS0(void, dragon_emubreak, md);
+	md->CPU->debug.cpu.instruction_log = DELEGATE_AS1(void, charcp, dragon_emulog, md);
+	md->CPU->debug.cpu.debug_read = DELEGATE_AS1(uint8, uint16, dragon_emuread, md);
+	md->CPU->debug.cpu.state_read = DELEGATE_AS1(int32, charcp, dragon_emustate, md);
+
 	// XXX until we serialise sound information
 	update_sound_mux_source(md);
 	sound_set_mux_enabled(md->snd, PIA_VALUE_CB2(md->PIA1));
@@ -883,6 +901,52 @@ static void dragon_signal(struct machine *m, int sig) {
 	md->CPU->running = 0;
 }
 
+// lwasm emuext BREAK / LOG / debug read.  Bodies are shared with every other
+// machine that implements emuext; see debug.c.
+static void dragon_emubreak(void *sptr) {
+	struct dragon *md = sptr;
+	emuext_break(&md->public, EMUEXT_GDB(md),
+	             DELEGATE_CALL(md->CPU->debug.cpu.get_pc));
+}
+
+static void dragon_emulog(void *sptr, const char *s) {
+	struct dragon *md = sptr;
+	emuext_log(EMUEXT_GDB(md), s);
+}
+
+static uint8_t dragon_emuread(void *sptr, uint16_t A) {
+	struct dragon *md = sptr;
+	return emuext_read(&md->public, A);
+}
+
+// Named machine-state read for LOG ${name}.  The CoCo 3 answers these out of
+// the GIME's MMU; there is no MMU here, so most of them have no Dragon-family
+// meaning and are deliberately NOT approximated:
+//
+//   xpc    the extended (physical) PC.  With no translation, this genuinely
+//          IS the logical PC, so answer it.
+//   block  the 8K block the PC sits in.  Follows directly from the PC, but
+//          note it is a LOGICAL block here where the CoCo 3 reports a
+//          physical one -- callers comparing the two across machines are
+//          comparing different things.
+//   paddr  the last physical address the bus touched (the CoCo 3 reads the
+//          GIME's Z latch).  Nothing here latches that, and returning the PC
+//          instead would be a plausible-looking wrong answer -- the worst
+//          kind for a debug channel.  Unknown.
+//   task   the MMU task register.  There is no MMU.  Unknown.
+//
+// -1 means "this machine cannot answer that", and the LOG handler echoes the
+// ${name} back untouched so it reads as unanswered rather than as data.
+static int32_t dragon_emustate(void *sptr, const char *name) {
+	struct dragon *md = sptr;
+	uint16_t pc = mc6809_get_pc(md->CPU);
+	if (0 == strcmp(name, "xpc"))
+		return (int32_t)pc;
+	if (0 == strcmp(name, "block"))
+		return (int32_t)((pc >> 13) & 0xff);
+	return -1;
+}
+
