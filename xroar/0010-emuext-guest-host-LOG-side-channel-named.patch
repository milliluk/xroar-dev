diff --git a/src/gdb.c b/src/gdb.c
index 78ce7d5..209fd2e 100644
--- a/src/gdb.c
+++ b/src/gdb.c
@@ -104,6 +104,9 @@ struct gdb_interface_private {
 	// The listener thread retries bind+listen before accepting.
 	_Bool rebind_pending;
 
+	// True while a gdb client is connected (between accept and close).
+	_Bool client_connected;
+
 	// Session state
 	bool no_ack_mode;
 
@@ -290,6 +293,32 @@ void gdb_run_unlock(struct gdb_interface *gi) {
 	pthread_mutex_unlock(&gip->run_state_mt);
 }
 
+// True if a gdb client is currently attached.
+bool gdb_connected(struct gdb_interface *gi) {
+	struct gdb_interface_private *gip = (struct gdb_interface_private *)gi;
+	return gip && gip->client_connected;
+}
+
+// Send text to the gdb client's console via an 'O' packet (hex-encoded).
+// No-op if no client is attached.  Called from the CPU thread for LOG mirror;
+// the listener thread is in recv() while the CPU runs, so they don't race on
+// send().
+void gdb_console_output(struct gdb_interface *gi, const char *s) {
+	struct gdb_interface_private *gip = (struct gdb_interface_private *)gi;
+	if (!gip || !gip->client_connected || !s || !*s)
+		return;
+	size_t n = strlen(s);
+	char *buf = xmalloc(2 * n + 1);
+	static const char hexd[] = "0123456789abcdef";
+	buf[0] = 'O';
+	for (size_t i = 0; i < n; i++) {
+		buf[1 + 2*i] = hexd[((uint8_t)s[i] >> 4) & 0xf];
+		buf[2 + 2*i] = hexd[(uint8_t)s[i] & 0xf];
+	}
+	send_packet(gip, buf, 2 * n + 1);
+	free(buf);
+}
+
 static void gdb_handle_signal(struct gdb_interface_private *gip, int sig, bool ack) {
 	gip->last_signal = sig;
 	if (ack)
@@ -403,6 +432,7 @@ static void *handle_tcp_sock(void *sptr) {
 			setsockopt(gip->sockfd, IPPROTO_TCP, TCP_NODELAY, (void const *)&flag, sizeof(flag));
 		}
 		LOG_MOD_DEBUG_GDB(LOG_GDB_CONNECT, "gdb", "connection accepted\n");
+		gip->client_connected = 1;
 
 		gip->no_ack_mode = 0;
 
@@ -513,6 +543,7 @@ static void *handle_tcp_sock(void *sptr) {
 			}
 		}
 		close(gip->sockfd);
+		gip->client_connected = 0;
 		gdb_continue(gip);
 		LOG_MOD_DEBUG_GDB(LOG_GDB_CONNECT, "gdb", "connection closed\n");
 	}
diff --git a/src/gdb.h b/src/gdb.h
