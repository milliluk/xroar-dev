--- a/src/debug.c
+++ b/src/debug.c
@@ -19,6 +19,7 @@
 #include "top-config.h"
 
 #include <assert.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -28,7 +29,10 @@
 #include "slist.h"
 
 #include "debug.h"
+#include "gdb.h"
 #include "logging.h"
+#include "machine.h"
+#include "xroar.h"
 
 // Some built-in composite types used in target descriptions
 
@@ -316,3 +320,47 @@ int debug_set_register_composite(struct debug_target *target, int regno,
 		DELEGATE_CALL(dpart->set_register, reg_num, value);
 	return n;
 }
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+// Shared emuext delegate bodies.  See debug.h for why these live here and not
+// in each machine.  The caller passes its own gdb_interface (EMUEXT_GDB) since
+// that member is private to the machine struct.
+
+// lwasm emuext BREAK ($113E).  With -emuext and a gdb client attached, halt
+// into the debugger exactly as a hardware breakpoint would.  Otherwise (no
+// -emuext, or no client) just note it at debug level and continue; BREAK has
+// no operands, so continuing is safe.
+void emuext_break(struct machine *m, struct gdb_interface *gdb, unsigned pc) {
+#ifdef WANT_GDB_TARGET
+	if (xroar.cfg.debug.emuext && gdb && gdb_connected(gdb)) {
+		m->signal(m, MACHINE_SIGTRAP);
+		return;
+	}
+#else
+	(void)gdb;
+#endif
+	(void)m;
+	LOG_MOD_DEBUG(1, "emu", "BREAK at $%04x\n", pc);
+}
+
+// lwasm emuext LOG ($103E).  The core has already formatted the text; emit it
+// verbatim to stderr and, with -emuext and a client attached, mirror it to the
+// gdb console.
+void emuext_log(struct gdb_interface *gdb, const char *s) {
+	fprintf(stderr, "%s", s);
+	fflush(stderr);
+#ifdef WANT_GDB_TARGET
+	if (xroar.cfg.debug.emuext && gdb && gdb_connected(gdb)) {
+		gdb_console_output(gdb, s);
+	}
+#else
+	(void)gdb;
+#endif
+}
+
+// Side-effect-free read for the emuext LOG handler.  Uses the machine debug
+// read path (same as gdb memory reads): no clock advance, no interrupt latch.
+uint8_t emuext_read(struct machine *m, uint16_t A) {
+	return m->read_byte(m, A, 0);
+}
diff --git a/src/debug.h b/src/debug.h
index 7fd2be9..1ffb2bf 100644
--- a/src/debug.h
+++ b/src/debug.h
@@ -55,6 +55,28 @@ struct debug_cpu {
 	// Get/set processor flags
 	DELEGATE_T1(bool, int) get_flag;
 	DELEGATE_T2(void, int, bool) set_flag;
+	// lwasm emulator-extension opcodes (pragma emuext).  Called by the CPU
+	// core when it decodes BREAK ($113E) or LOG ($103E).  The machine wires
+	// these to route to gdb / stderr; see coco3.c, mc10.c.
+	_Bool emuext;                               // -emuext: consume + act
+	DELEGATE_T0(void) instruction_break;        // BREAK
+	DELEGATE_T1(void, charcp) instruction_log;  // LOG, arg = formatted text
+
+	// Side-effect-free memory read for the LOG handler.  Routes to the
+	// machine's debug read_byte (no clock advance, no interrupt latching),
+	// so formatting a LOG string does not desync cycle accounting or fire
+	// spurious interrupts.  Also doubles as the "this machine implements
+	// emuext at all" flag; see mc6809_emuext_supported() in mc6809_common.c.
+	DELEGATE_T1(uint8, uint16) debug_read;
+
+	// Named machine-state read for LOG ${name} references that aren't plain
+	// CPU registers: xpc, paddr, block, task (the same values the gdb
+	// qxroar.* queries expose).  Returns the value, or -1 for a name this
+	// machine cannot answer -- which the LOG handler echoes back verbatim
+	// rather than substituting something plausible.  The CPU-register names
+	// are handled directly in the LOG handler and never reach this delegate.
+	DELEGATE_T1(int32, charcp) state_read;
+
 };
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
@@ -203,5 +225,32 @@ int debug_get_register_composite(struct debug_target *target, int regno,
 int debug_set_register_composite(struct debug_target *target, int regno,
 				 unsigned nbytes, const uint8_t *buf);
 
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+// Shared emuext delegate bodies (debug.c).
+//
+// Three of the four emuext delegates do the same job on every machine: report
+// a BREAK, emit LOG text, read a byte without side effects.  Only state_read
+// is genuinely machine-specific (it answers for the MMU, if there is one), so
+// only state_read is written per machine.  Keeping one copy of the rest is
+// what stops a fix to any of them -- the LOG output sanitising in particular
+// -- from having to be remembered in two files.
+
+struct gdb_interface;
+struct machine;
+
+// The machine's gdb_interface member only exists in a WANT_GDB_TARGET build.
+// Both machine structs name it identically, so this keeps that #ifdef out of
+// every emuext call site.
+#ifdef WANT_GDB_TARGET
+#define EMUEXT_GDB(md) ((md)->gdb_interface)
+#else
+#define EMUEXT_GDB(md) ((struct gdb_interface *)0)
+#endif
+
+void emuext_break(struct machine *m, struct gdb_interface *gdb, unsigned pc);
+void emuext_log(struct gdb_interface *gdb, const char *s);
+uint8_t emuext_read(struct machine *m, uint16_t A);
+
 #endif
 
