+// lwasm emuext opcode handlers (wired into the CPU's debug_cpu delegates)
+static void coco3_emubreak(void *sptr);
+static void coco3_emulog(void *sptr, const char *s);
+static uint8_t coco3_emuread(void *sptr, uint16_t A);
+static int32_t coco3_emustate(void *sptr, const char *name);
+
 static const struct partdb_entry_funcs coco3_funcs = {
 	.allocate = coco3_allocate,
 	.initialise = coco3_initialise,
@@ -696,6 +702,15 @@ static bool coco3_finish(struct part *p) {
 	}
 #endif
 
+	// lwasm emulator extensions (pragma emuext): wire the CPU's BREAK/LOG
+	// delegates regardless of -emuext, so a disabled program still gets a
+	// stderr courtesy from the handler; debug_cpu.emuext gates the action.
+	mcc3->CPU->debug.cpu.emuext = xroar.cfg.debug.emuext;
+	mcc3->CPU->debug.cpu.instruction_break = DELEGATE_AS0(void, coco3_emubreak, mcc3);
+	mcc3->CPU->debug.cpu.instruction_log = DELEGATE_AS1(void, charcp, coco3_emulog, mcc3);
+	mcc3->CPU->debug.cpu.debug_read = DELEGATE_AS1(uint8, uint16, coco3_emuread, mcc3);
+	mcc3->CPU->debug.cpu.state_read = DELEGATE_AS1(int32, charcp, coco3_emustate, mcc3);
+
 	// XXX until we serialise sound information
 	update_sound_mux_source(mcc3);
 	sound_set_mux_enabled(mcc3->snd, PIA_VALUE_CB2(mcc3->PIA1));
@@ -931,6 +946,68 @@ static void coco3_signal(struct machine *m, int sig) {
 	mcc3->CPU->running = 0;
 }
 
+static void coco3_trap(void *sptr) {
+	struct machine *m = sptr;
+	coco3_signal(m, MACHINE_SIGTRAP);
+}
+
+// lwasm emuext BREAK / LOG / debug read.  Bodies are shared with every other
+// machine that implements emuext; see debug.c.
+static void coco3_emubreak(void *sptr) {
+	struct coco3 *mcc3 = sptr;
+	emuext_break(&mcc3->public, EMUEXT_GDB(mcc3),
+	             DELEGATE_CALL(mcc3->CPU->debug.cpu.get_pc));
+}
+
+static void coco3_emulog(void *sptr, const char *s) {
+	struct coco3 *mcc3 = sptr;
+	emuext_log(EMUEXT_GDB(mcc3), s);
+}
+
+static uint8_t coco3_emuread(void *sptr, uint16_t A) {
+	struct coco3 *mcc3 = sptr;
+	return emuext_read(&mcc3->public, A);
+}
+
+// Named machine-state read for LOG ${name}: xpc, paddr, block, task -- the
+// same values gdb's qxroar.* queries expose.  Returns -1 for an unknown name.
+// This is the one emuext delegate that CANNOT be shared: it answers for the
+// GIME's MMU, and a machine without one must answer differently or not at all.
+static int32_t coco3_emustate(void *sptr, const char *name) {
+	struct coco3 *mcc3 = sptr;
+	uint16_t pc = mc6809_get_pc(mcc3->CPU);
+	if (0 == strcmp(name, "xpc"))
+		return (int32_t)(tcc1014_logical_to_physical(mcc3->GIME, pc) & 0x7ffff);
+	if (0 == strcmp(name, "paddr"))
+		return (int32_t)(mcc3->GIME->Z & 0x7ffff);
+	if (0 == strcmp(name, "block"))
+		return (int32_t)((tcc1014_logical_to_physical(mcc3->GIME, pc) >> 13) & 0xff);
+	if (0 == strcmp(name, "task"))
+		return (int32_t)tcc1014_get_task(mcc3->GIME);
+	return -1;
+}
+
+static void coco3_bp_add_n(struct machine *m, struct machine_bp *list, int n, void *sptr) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	for (int i = 0; i < n; i++) {
+		if (list[i].add_cond & BP_CRC_COMBINED)
+			continue;
+		if ((list[i].add_cond & BP_CRC_EXT) && (!mcc3->has_secb || !crclist_match(list[i].cond_crc_extbas, mcc3->crc_secb)))
+			continue;
+		if (list[i].add_cond & BP_CRC_BAS)
+			continue;
+		list[i].bp.handler.sptr = sptr;
+		bp_add(mcc3->bp_session, &list[i].bp);
+	}
+}
+
+static void coco3_bp_remove_n(struct machine *m, struct machine_bp *list, int n) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	for (int i = 0; i < n; i++) {
+		bp_remove(mcc3->bp_session, &list[i].bp);
+	}
+}
+
