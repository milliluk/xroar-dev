diff --git a/portalib/delegate.h b/portalib/delegate.h
index 72fa91e..1e4dd90 100644
--- a/portalib/delegate.h
+++ b/portalib/delegate.h
@@ -71,6 +71,8 @@ typedef DELEGATE_S2(void, int, uint8_t *) DELEGATE_T2(void, int, uint8p);
 typedef DELEGATE_S2(void, int, uint16_t *) DELEGATE_T2(void, int, uint16p);
 typedef DELEGATE_S2(void, int, uint32_t) DELEGATE_T2(void, int, uint32);
 typedef DELEGATE_S1(void, unsigned) DELEGATE_T1(void, unsigned);
+typedef DELEGATE_S1(void, char const *) DELEGATE_T1(void, charcp);
+typedef DELEGATE_S1(int32_t, char const *) DELEGATE_T1(int32, charcp);
 typedef DELEGATE_S2(void, unsigned, int) DELEGATE_T2(void, unsigned, int);
 typedef DELEGATE_S2(void, unsigned, unsigned) DELEGATE_T2(void, unsigned, unsigned);
 typedef DELEGATE_S3(void, unsigned, unsigned, unsigned) DELEGATE_T3(void, unsigned, unsigned, unsigned);
@@ -202,6 +204,7 @@ DELEGATE_DEF_PROTO3(uint8_t *, uint8p, unsigned, unsigned, unsigned, unsigned, u
 DELEGATE_DEF_PROTO1(int, int, bool, bool);
 DELEGATE_DEF_PROTO3(int, int, int, int, unsigned, unsigned, uint8_t *, uint8p);
 DELEGATE_DEF_PROTO3(int, int, int, int, unsigned, unsigned, const uint8_t *, cuint8p);
+DELEGATE_DEF_PROTO1(int32_t, int32, char const *, charcp);
 DELEGATE_DEF_PROTO3(float, float, uint32_t, uint32, int, int, float *, floatp);
 
 #define DELEGATE_DEFAULT0(N) DELEGATE_AS0(N, DELEGATE_DEFAULT_F0(N), NULL)
diff --git a/src/coco3.c b/src/coco3.c
index 1e7c45f..f1fbe68 100644
--- a/src/coco3.c
+++ b/src/coco3.c
@@ -362,6 +362,12 @@ static void coco3_initialise(struct part *p, void *options);
 static bool coco3_finish(struct part *p);
 static void coco3_free(struct part *p);
 
+// lwasm emuext opcode handlers (wired into the CPU's debug_cpu delegates)
+static void coco3_emubreak(void *sptr);
+static void coco3_emulog(void *sptr, const char *s);
+static uint8_t coco3_emuread(void *sptr, uint16_t A);
+static int32_t coco3_emustate(void *sptr, const char *name);
+
 static const struct partdb_entry_funcs coco3_funcs = {
 	.allocate = coco3_allocate,
 	.initialise = coco3_initialise,
@@ -696,6 +702,15 @@ static bool coco3_finish(struct part *p) {
 	}
 #endif
 
+	// lwasm emulator extensions (pragma emuext): wire the CPU's BREAK/LOG
+	// delegates regardless of -emuext, so a disabled program still gets a
+	// stderr courtesy from the handler; debug_cpu.emuext gates the action.
+	mcc3->CPU->debug.cpu.emuext = xroar.cfg.debug.emuext;
+	mcc3->CPU->debug.cpu.instruction_break = DELEGATE_AS0(void, coco3_emubreak, mcc3);
+	mcc3->CPU->debug.cpu.instruction_log = DELEGATE_AS1(void, charcp, coco3_emulog, mcc3);
+	mcc3->CPU->debug.cpu.debug_read = DELEGATE_AS1(uint8, uint16, coco3_emuread, mcc3);
+	mcc3->CPU->debug.cpu.state_read = DELEGATE_AS1(int32, charcp, coco3_emustate, mcc3);
+
 	// XXX until we serialise sound information
 	update_sound_mux_source(mcc3);
 	sound_set_mux_enabled(mcc3->snd, PIA_VALUE_CB2(mcc3->PIA1));
@@ -931,6 +946,88 @@ static void coco3_signal(struct machine *m, int sig) {
 	mcc3->CPU->running = 0;
 }
 
+static void coco3_trap(void *sptr) {
+	struct machine *m = sptr;
+	coco3_signal(m, MACHINE_SIGTRAP);
+}
+
+// lwasm emuext BREAK ($113E).  With -emuext and a gdb client attached, halt
+// into the debugger exactly as a hardware breakpoint would.  Otherwise (no
+// -emuext, or no client) just note it at debug level and continue; BREAK has
+// no operands, so continuing is safe.
+static void coco3_emubreak(void *sptr) {
+	struct coco3 *mcc3 = sptr;
+#ifdef WANT_GDB_TARGET
+	if (xroar.cfg.debug.emuext && mcc3->gdb_interface
+	    && gdb_connected(mcc3->gdb_interface)) {
+		coco3_signal(&mcc3->public, MACHINE_SIGTRAP);
+		return;
+	}
+#endif
+	unsigned pc = DELEGATE_CALL(mcc3->CPU->debug.cpu.get_pc);
+	LOG_MOD_DEBUG(1, "emu", "BREAK at $%04x\n", pc);
+}
+
+// lwasm emuext LOG ($103E).  The core has already formatted the text; emit it
+// verbatim to stderr and, with -emuext and a client attached, mirror it to the
+// gdb console.
+static void coco3_emulog(void *sptr, const char *s) {
+	struct coco3 *mcc3 = sptr;
+	(void)mcc3;
+	fprintf(stderr, "%s", s);
+	fflush(stderr);
+#ifdef WANT_GDB_TARGET
+	if (xroar.cfg.debug.emuext && mcc3->gdb_interface
+	    && gdb_connected(mcc3->gdb_interface)) {
+		gdb_console_output(mcc3->gdb_interface, s);
+	}
+#endif
+}
+
+// Side-effect-free read for the emuext LOG handler.  Uses the machine debug
+// read path (same as gdb memory reads): no clock advance, no interrupt latch.
+static uint8_t coco3_emuread(void *sptr, uint16_t A) {
+	struct coco3 *mcc3 = sptr;
+	return mcc3->public.read_byte(&mcc3->public, A, 0);
+}
+
+// Named machine-state read for LOG ${name}: xpc, paddr, block, task -- the
+// same values gdb's qxroar.* queries expose.  Returns -1 for an unknown name.
+static int32_t coco3_emustate(void *sptr, const char *name) {
+	struct coco3 *mcc3 = sptr;
+	uint16_t pc = mc6809_get_pc(mcc3->CPU);
+	if (0 == strcmp(name, "xpc"))
+		return (int32_t)(tcc1014_logical_to_physical(mcc3->GIME, pc) & 0x7ffff);
+	if (0 == strcmp(name, "paddr"))
+		return (int32_t)(mcc3->GIME->Z & 0x7ffff);
+	if (0 == strcmp(name, "block"))
+		return (int32_t)((tcc1014_logical_to_physical(mcc3->GIME, pc) >> 13) & 0xff);
+	if (0 == strcmp(name, "task"))
+		return (int32_t)tcc1014_get_task(mcc3->GIME);
+	return -1;
+}
+
+static void coco3_bp_add_n(struct machine *m, struct machine_bp *list, int n, void *sptr) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	for (int i = 0; i < n; i++) {
+		if (list[i].add_cond & BP_CRC_COMBINED)
+			continue;
+		if ((list[i].add_cond & BP_CRC_EXT) && (!mcc3->has_secb || !crclist_match(list[i].cond_crc_extbas, mcc3->crc_secb)))
+			continue;
+		if (list[i].add_cond & BP_CRC_BAS)
+			continue;
+		list[i].bp.handler.sptr = sptr;
+		bp_add(mcc3->bp_session, &list[i].bp);
+	}
+}
+
+static void coco3_bp_remove_n(struct machine *m, struct machine_bp *list, int n) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	for (int i = 0; i < n; i++) {
+		bp_remove(mcc3->bp_session, &list[i].bp);
+	}
+}
+
