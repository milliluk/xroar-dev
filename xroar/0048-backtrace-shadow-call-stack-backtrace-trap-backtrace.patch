--- /dev/null
+++ b/src/backtrace.c
@@ -0,0 +1,212 @@
+/** \file
+ *
+ *  \brief Shadow call stack and symbolized backtrace.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ */
+
+#include "top-config.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "delegate.h"
+
+#include "backtrace.h"
+#include "logging.h"
+#include "machine.h"
+#include "part.h"
+#include "ram.h"
+#include "symfile.h"
+#include "tcc1014/tcc1014.h"
+
+// Deep enough for any sane program; a runaway recursion hits the protect
+// checks or the breakpoint long before frame 128 is interesting.  On
+// overflow the OUTERMOST frame is dropped: the innermost frames are the
+// ones a crash report is for.
+#define BACKTRACE_MAX (128)
+
+struct bt_frame {
+	uint32_t call_phys;   // physical PC of the call (or interrupted) instruction
+	uint32_t target_phys; // physical PC of the callee's (or handler's) first instruction
+	uint16_t call_pc;     // logical forms of the same
+	uint16_t target_pc;
+	uint16_t s_after;     // S once the return context was pushed
+	uint8_t irq;          // interrupt frame, not a call
+};
+
+static struct bt_frame frames[BACKTRACE_MAX];
+static unsigned bt_depth = 0;
+static unsigned long bt_dropped = 0;
+
+static struct machine *bt_machine = NULL;
+static struct TCC1014 *bt_gime = NULL;
+static struct flat_ram bt_ram;
+
+// Per-instruction state carried to the next boundary.  The hook fires
+// BEFORE an instruction executes, so a call is recognised one boundary
+// late: by its callee's first instruction, when the return address is
+// already on the stack and S says everything there is to know.
+static _Bool bt_primed = 0;
+static uint8_t bt_prev_op = 0;
+static uint16_t bt_prev_pc = 0;
+static uint32_t bt_prev_phys = 0;
+static unsigned bt_prev_irq = 0;
+
+static uint32_t bt_phys(uint16_t pc) {
+	if (!bt_gime)
+		return pc;
+	return tcc1014_logical_to_physical(bt_gime, pc) & 0x7ffff;
+}
+
+// JSR direct/indexed/extended, BSR, LBSR.  First bytes only: neither $10
+// nor $11 prefixes a call, so a prefixed opcode can never alias one.
+static _Bool bt_is_call(uint8_t op) {
+	return op == 0x8d || op == 0x17 ||
+	       op == 0x9d || op == 0xad || op == 0xbd;
+}
+
+static void bt_push(uint16_t pc, uint32_t phys, unsigned s, _Bool irq_frame) {
+	if (bt_depth == BACKTRACE_MAX) {
+		memmove(&frames[0], &frames[1],
+		        (BACKTRACE_MAX - 1) * sizeof(frames[0]));
+		bt_depth--;
+		bt_dropped++;
+	}
+	struct bt_frame *f = &frames[bt_depth++];
+	f->call_phys = bt_prev_phys;
+	f->call_pc = bt_prev_pc;
+	f->target_phys = phys;
+	f->target_pc = pc;
+	f->s_after = (uint16_t)s;
+	f->irq = irq_frame;
+}
+
+static void bt_hook(void *sptr, uint32_t A) {
+	(void)sptr;
+	struct machine *m = bt_machine;
+	if (!m)
+		return;
+	uint16_t pc = (uint16_t)A;
+	unsigned s = DELEGATE_CALL(m->debug.cpu.get_sp);
+	unsigned irq = DELEGATE_CALL(m->debug.cpu.get_irq_depth);
+	uint32_t phys = bt_phys(pc);
+
+	if (bt_primed) {
+		// The one rule of the return path: a frame whose post-call S
+		// is below the current S has been left, however it was left.
+		while (bt_depth && frames[bt_depth - 1].s_after < (uint16_t)s)
+			bt_depth--;
+		if (irq > bt_prev_irq) {
+			// An interrupt dispatched since the last boundary; this
+			// instruction is its handler's first.  A call in the
+			// same window lost the race and its frame -- see the
+			// header -- but S accounting stays exact.
+			bt_push(pc, phys, s, 1);
+		} else if (bt_is_call(bt_prev_op)) {
+			bt_push(pc, phys, s, 0);
+		}
+	}
+
+	// The opcode ABOUT to execute, peeked from flat physical RAM.  NOT
+	// machine->read_byte: the debug bus read routes through the same
+	// memory path the audit map and the protect checks watch, and a
+	// per-instruction peek classified with the previous cycle's stale
+	// access class faulted -protect-mode-read on the program's own code.
+	// The flat peek touches no machine state at all.  Its one lie is a PC
+	// executing from ROM, where the MMU translation is fiction and the
+	// peek reads whatever RAM sits behind it -- boot-time frames may be
+	// junk; frames after the program takes over are exact.
+	int op = flat_ram_peek(&bt_ram, phys);
+	bt_prev_op = (op < 0) ? 0 : (uint8_t)op;
+	bt_prev_pc = pc;
+	bt_prev_phys = phys;
+	bt_prev_irq = irq;
+	bt_primed = 1;
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+void backtrace_attach(struct machine *m) {
+	if (!m || bt_machine == m)
+		return;
+	// If a previous machine was attached, its hook died with it; only the
+	// bookkeeping needs resetting.
+	bt_machine = NULL;
+	if (!m->debug.cpu.get_sp.func || !m->debug.cpu.get_irq_depth.func) {
+		LOG_MOD_WARN("backtrace", "this machine's CPU exposes no stack "
+		             "pointer; backtrace not armed\n");
+		return;
+	}
+	bt_depth = 0;
+	bt_dropped = 0;
+	bt_primed = 0;
+	// Resolve the flat RAM pair ONCE, here: the per-instruction peek in
+	// bt_hook must never pay for a part lookup.  (Academic on the MC-10
+	// itself -- its 6803 core fails the get_sp check above -- but the
+	// lookup should not be the thing that breaks a future machine with
+	// the same two-part naming.)
+	if (!flat_ram_resolve(&bt_ram, &m->part)) {
+		LOG_MOD_WARN("backtrace", "this machine exposes no flat RAM; "
+		             "backtrace not armed\n");
+		return;
+	}
+	bt_machine = m;
+	bt_gime = (struct TCC1014 *)part_component_by_id_is_a(&m->part, "GIME", "TCC1014");
+	machine_add_instruction_hook(m, DELEGATE_AS1(void, uint32, bt_hook, NULL));
+}
+
+void backtrace_detach(struct machine *m) {
+	if (bt_machine && m == bt_machine)
+		machine_remove_instruction_hook(m, DELEGATE_AS1(void, uint32, bt_hook, NULL));
+	bt_machine = NULL;
+	bt_gime = NULL;
+	bt_ram = (struct flat_ram){0};
+	bt_depth = 0;
+	bt_primed = 0;
+}
+
+_Bool backtrace_attached(void) {
+	return bt_machine != NULL;
+}
+
+void backtrace_dump(FILE *f) {
+	if (!bt_machine) {
+		fprintf(f, "backtrace: not armed (pass -backtrace)\n");
+		return;
+	}
+	if (!bt_depth) {
+		fprintf(f, "backtrace: no frames (top level, or nothing called yet)\n");
+		return;
+	}
+	fprintf(f, "backtrace: %u frame(s), innermost first", bt_depth);
+	if (bt_dropped)
+		fprintf(f, " (%lu outermost dropped)", bt_dropped);
+	fprintf(f, ":\n");
+	unsigned n = 0;
+	for (unsigned d = bt_depth; d-- > 0; n++) {
+		const struct bt_frame *fr = &frames[d];
+		const char *in_w = symfile_whereis(fr->target_phys, 0);
+		const char *at_w = symfile_whereis(fr->call_phys, 0);
+		const char *at_l = symfile_line(fr->call_phys);
+		fprintf(f, "backtrace: #%-2u %s 0x%05X%s%s%s <- 0x%05X%s%s%s%s%s s=%04X\n",
+		        n, fr->irq ? "irq" : "in ",
+		        fr->target_phys,
+		        in_w ? " (" : "", in_w ? in_w : "", in_w ? ")" : "",
+		        fr->call_phys,
+		        at_w ? " (" : "", at_w ? at_w : "", at_w ? ")" : "",
+		        at_l ? " " : "", at_l ? at_l : "",
+		        fr->s_after);
+	}
+}
