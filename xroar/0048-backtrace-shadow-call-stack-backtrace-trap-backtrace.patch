+	cpu->debug.cpu.get_irq_depth = DELEGATE_AS0(unsigned, mc6809_get_irq_depth, cpu);
 	cpu->debug.cpu.get_flag = DELEGATE_AS1(bool, int, mc6809_get_flag, cpu);
