@@ -0,0 +1,63 @@
+/** \file
+ *
+ *  \brief Shadow call stack and symbolized backtrace.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ *
+ *  The 6809 has no frame pointer, so walking the S stack after the fact is
+ *  guesswork: return addresses interleave with pushed registers and locals,
+ *  and an interrupt drops a 12-byte frame wherever S points.  An emulator
+ *  does not have to guess.  This watches the machine run -- one callback per
+ *  instruction, the hook -trap-history already rides -- and keeps the call
+ *  stack the program actually built:
+ *
+ *   - the instruction after a JSR/BSR/LBSR opens a frame (call site,
+ *     target, S after the return address was pushed);
+ *   - a rise in the core's interrupt depth opens an interrupt frame;
+ *   - any frame whose recorded S is below the current S has been returned
+ *     from -- or discarded with LEAS/PULS/LDS -- and closes.  RTS, RTI,
+ *     `puls pc` and stack-unwinding longjmp tricks all fall out of that one
+ *     rule, with no opcode knowledge on the return path at all.
+ *
+ *  What it cannot follow: a program that runs multiple stacks (a task
+ *  switcher pointing S at another task's stack leaves the old task's frames
+ *  interleaved), and a JSR whose target is preempted by an interrupt before
+ *  its first instruction loses that one frame.  Both degrade the dump, not
+ *  the emulation.
+ */
+
+#ifndef XROAR_BACKTRACE_H_
+#define XROAR_BACKTRACE_H_
+
+#include <stdio.h>
+
+struct machine;
+
+// Install the per-instruction hook on this machine and start (or restart)
+// the shadow stack.  Declines, with a warning, a machine whose CPU does not
+// expose S and interrupt depth (the MC-10's 6803 does not).  A previous
+// machine's hook died with that machine and is never touched.
+void backtrace_attach(struct machine *m);
+
+// Remove the hook if it is attached to this machine, and forget the stack.
+void backtrace_detach(struct machine *m);
+
+_Bool backtrace_attached(void);
+
+// Print the shadow stack, innermost frame first, symbolized when -symbols
+// is loaded.  Prints a one-line note when not armed, so a -trap-backtrace
+// that fires without -backtrace explains itself.
+void backtrace_dump(FILE *f);
+
+#endif
