+// Residual distance from a one-step DAC target, indexed by elapsed fast CoCo
+// E-cycles.  These are the full-resolution rise/fall values preserved in VCC's
+// software hi-res joystick implementation.  VCC used a 14-bit comparator axis;
+// XRoar uses 16 bits, so the measured residual units scale by four.
+#define JOYSTICK_DAC_E_TICKS EVENT_TICKS_14M31818(8)
+#define JOYSTICK_DAC_VCC_SCALE 4u
+static const uint16_t joystick_dac_rising[10] = {
+	256 * JOYSTICK_DAC_VCC_SCALE, 256 * JOYSTICK_DAC_VCC_SCALE,
+	256 * JOYSTICK_DAC_VCC_SCALE, 256 * JOYSTICK_DAC_VCC_SCALE,
+	 48 * JOYSTICK_DAC_VCC_SCALE,  32 * JOYSTICK_DAC_VCC_SCALE,
+	 24 * JOYSTICK_DAC_VCC_SCALE,  20 * JOYSTICK_DAC_VCC_SCALE,
+	  0 * JOYSTICK_DAC_VCC_SCALE,   0 * JOYSTICK_DAC_VCC_SCALE
+};
+static const uint16_t joystick_dac_falling[10] = {
+	256 * JOYSTICK_DAC_VCC_SCALE, 256 * JOYSTICK_DAC_VCC_SCALE,
+	256 * JOYSTICK_DAC_VCC_SCALE, 256 * JOYSTICK_DAC_VCC_SCALE,
+	224 * JOYSTICK_DAC_VCC_SCALE, 116 * JOYSTICK_DAC_VCC_SCALE,
+	 64 * JOYSTICK_DAC_VCC_SCALE,  56 * JOYSTICK_DAC_VCC_SCALE,
+	 48 * JOYSTICK_DAC_VCC_SCALE,   0 * JOYSTICK_DAC_VCC_SCALE
+};
+
+static uint32_t joystick_dac_target_value(struct coco3 *mcc3) {
+	uint32_t dac_code = mcc3->PIA1->a.out_sink & JOYSTICK_DAC_OUTPUT_MASK;
+	return (dac_code | JOYSTICK_DAC_BIN_CENTRE) << JOYSTICK_DAC_AXIS_SHIFT;
+}
+
+static void joystick_dac_write(struct coco3 *mcc3) {
+	uint32_t target = joystick_dac_target_value(mcc3);
+	if (target == mcc3->joystick_dac_target)
+		return;
+	mcc3->joystick_dac_start = mcc3->joystick_dac_target;
+	mcc3->joystick_dac_target = target;
+	mcc3->joystick_dac_transition_tick = event_current_tick;
+}
+
+static uint32_t joystick_dac_value(struct coco3 *mcc3) {
+	uint32_t start = mcc3->joystick_dac_start;
+	uint32_t target = mcc3->joystick_dac_target;
+	uint32_t distance = start > target ? start - target : target - start;
+
+	// The measured deep-scan data describes the fine one-DAC-step scan only.
+	// Coarse successive-approximation jumps remain instantaneous.
+	if (distance != JOYSTICK_DAC_STEP)
+		return target;
+
+	event_ticks dt = event_current_tick - mcc3->joystick_dac_transition_tick;
+	unsigned e_cycles = dt / JOYSTICK_DAC_E_TICKS;
+	if (e_cycles >= ARRAY_N_ELEMENTS(joystick_dac_rising))
+		return target;
+
+	if (target > start)
+		return target - joystick_dac_rising[e_cycles];
+	return target + joystick_dac_falling[e_cycles];
+}
+
 static void joystick_update(void *sptr) {
 	struct coco3 *mcc3 = sptr;
 	int port = PIA_VALUE_CB2(mcc3->PIA0);
 	int axis = PIA_VALUE_CA2(mcc3->PIA0);
-	int dac_value = ((mcc3->PIA1->a.out_sink & 0xfc) | 2) << 8;
+
+	// Hi-res adaptor: the selected stick's JOYIN comes from the monostable,
+	// not the analogue comparator.  JOYIN reads high once the pulse has
+	// finished (event no longer queued), low while it is still running.
+	if (mcc3->hires_joystick != HIRES_NONE && port == mcc3->hires_joystick_port) {
+		if (event_queued(&mcc3->hires_joystick_event[axis]))
+			mcc3->PIA0->a.in_sink &= 0x7f;
+		else
+			mcc3->PIA0->a.in_sink |= 0x80;
+		return;
+	}
+
+	uint32_t dac_value = joystick_dac_value(mcc3);
 	int js_value = joystick_read_axis(port, axis);
-	if (js_value >= dac_value)
+	if ((uint32_t)js_value >= dac_value)
 		mcc3->PIA0->a.in_sink |= 0x80;
 	else
 		mcc3->PIA0->a.in_sink &= 0x7f;
 }
 
+// Hi-res joystick monostable expiry.  Nothing to compute: the comparator read
+// in joystick_update() tests event_queued() directly.  The event exists only
+// so that it removes itself from the queue when the pulse ends.
+static void hires_joystick_fire(void *sptr) {
+	(void)sptr;
+}
+
+// Drive the hi-res joystick adaptor.  Called whenever a line that can act as
+// the adaptor's strobe changes: the DAC MSB (Tandy Hi-Res) or PIA0 PA2/PA3
+// (CoCo Max 3).  On the strobe's high-to-low edge a per-axis monostable is
+// armed for a duration proportional to the axis position.  The pulse-width
+// constants are taken from MAME's trs/coco.cpp poll_hires_joystick().
+static void hires_joystick_update(struct coco3 *mcc3) {
+	_Bool newvalue;
+	_Bool is_cocomax3;
+
+	switch (mcc3->hires_joystick) {
+	case HIRES_RIGHT:
+	case HIRES_LEFT:
+		// DAC bit 5 of the 6-bit value, i.e. PIA1 PA7
+		newvalue = mcc3->PIA1->a.out_sink & 0x80;
+		is_cocomax3 = 0;
+		break;
+	case HIRES_RIGHT_COCOMAX3:
+		newvalue = mcc3->PIA0->a.out_sink & 0x04;
+		is_cocomax3 = 1;
+		break;
+	case HIRES_LEFT_COCOMAX3:
+		newvalue = mcc3->PIA0->a.out_sink & 0x08;
+		is_cocomax3 = 1;
+		break;
+	default:
+		return;
+	}
+
+	for (int axis = 0; axis < 2; axis++) {
+		if (mcc3->hires_joystick_ca && !newvalue) {
+			// High-to-low: arm the monostable for this axis
+			double value = (double)joystick_read_axis(mcc3->hires_joystick_port, axis) / 65535.;
+			if (is_cocomax3)
+				value = value * 2885. + 380.;
+			else
+				value = value * 5850. + 535.;
+			event_queue_dt(&mcc3->hires_joystick_event[axis], EVENT_US((uintmax_t)value));
+		} else if (!mcc3->hires_joystick_ca && newvalue) {
+			// Low-to-high: cancel any pending pulse
+			event_dequeue(&mcc3->hires_joystick_event[axis]);
+		}
+	}
+	mcc3->hires_joystick_ca = newvalue;
+}
+
 static void update_sound_mux_source(void *sptr) {
 	struct coco3 *mcc3 = sptr;
 	unsigned source = (PIA_VALUE_CB2(mcc3->PIA0) << 1)
@@ -1516,10 +1690,26 @@ static void pia0a_data_preread(void *sptr) {
 	joystick_update(sptr);
 }
 
+static void pia0a_data_postwrite(void *sptr) {
+	struct coco3 *mcc3 = sptr;
+	// Preserve the keyboard IRQ update this line used to do via its
+	// #define pia0a_data_postwrite keyboard_update.
+	keyboard_update(mcc3);
+	// CoCo Max 3 adaptor strobes on PIA0 PA2 (right) / PA3 (left)
+	if (mcc3->hires_joystick == HIRES_RIGHT_COCOMAX3 ||
+	    mcc3->hires_joystick == HIRES_LEFT_COCOMAX3) {
+		hires_joystick_update(mcc3);
+	}
+}
+
 static void pia1a_data_postwrite(void *sptr) {
 	struct coco3 *mcc3 = sptr;
+	joystick_dac_write(mcc3);
 	sound_set_dac_level(mcc3->snd, (float)(PIA_VALUE_A(mcc3->PIA1) & 0xfc) / 252.);
 	tape_update_output(mcc3->tape_interface, mcc3->PIA1->a.out_sink & 0xfc);
+	// Tandy Hi-Res adaptor strobes on the DAC MSB
+	if (mcc3->hires_joystick == HIRES_RIGHT || mcc3->hires_joystick == HIRES_LEFT)
+		hires_joystick_update(mcc3);
 }
 
