+// CoCo joystick DAC encoding: PIA1 PA2-PA7 are the six DAC bits.  XRoar's
+// joystick axis is 16-bit, so a single DAC code step spans 2^(8+2) axis units.
+#define JOYSTICK_DAC_LOW_BITS 2
+#define JOYSTICK_DAC_AXIS_SHIFT 8
+#define JOYSTICK_DAC_OUTPUT_MASK (UINT8_MAX << JOYSTICK_DAC_LOW_BITS)
+#define JOYSTICK_DAC_BIN_CENTRE (1u << (JOYSTICK_DAC_LOW_BITS - 1))
+#define JOYSTICK_DAC_STEP (1u << (JOYSTICK_DAC_AXIS_SHIFT + JOYSTICK_DAC_LOW_BITS))
+
 // Measured peak-to-peak voltages: 0V, 1V, 1.6V, 2V.  Scaled here:
