+	int hires_joystick_port;   // 0 = right, 1 = left
+	_Bool hires_joystick_ca;   // last seen strobe level
+	struct event hires_joystick_event[2];  // per-axis monostable
+
+	// Normal joystick DAC settling.  Software-only high-resolution joystick
