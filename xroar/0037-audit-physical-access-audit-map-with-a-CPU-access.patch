diff --git a/src/mc6809/mc6809.h b/src/mc6809/mc6809.h
index 7f89955..87e51b3 100644
--- a/src/mc6809/mc6809.h
+++ b/src/mc6809/mc6809.h
@@ -68,6 +68,25 @@ enum mc6809_state {
 };
 
 /* Interface shared with all 6809-compatible CPUs */
+// Access class of the memory cycle in progress.  Set by the core immediately
+// before each mem_cycle delegate call and read by the machine, which is the
+// only place that knows the physical address the cycle resolved to.
+//
+// Bits, not an enum: one cycle can be both an instruction-stream byte and the
+// opcode that starts an instruction, or both a write and S-derived.  Without
+// this the machine sees a direction and an address and nothing else -- and in
+// particular cannot tell a real read from the dead bus cycles the 6809
+// performs at PC, which reach RAM with RAS asserted and would otherwise record
+// as reads of bytes nothing read.
+#define MC6809_MC_DATA    (0x00)  // ordinary data access through an EA
+#define MC6809_MC_FETCH   (0x01)  // byte consumed from the instruction stream
+#define MC6809_MC_OPCODE  (0x02)  // ... and it is the first byte of one
+#define MC6809_MC_STACK_S (0x04)  // address derived from S
+#define MC6809_MC_STACK_U (0x08)  // address derived from U
+#define MC6809_MC_DEAD    (0x10)  // dead bus cycle (VMA); not a real access
+#define MC6809_MC_VECTOR  (0x20)  // interrupt vector fetch
+#define MC6809_MC_PUSHPULL (0x40) // stack push/pull, not indexed addressing
+
 struct MC6809 {
 	// Is a part
 	struct part part;
@@ -113,6 +132,14 @@ struct MC6809 {
 	bool nmi_latch, firq_latch, irq_latch;
 	bool nmi_active, firq_active, irq_active;
 
+	/* Access classification, for the machine's audit map.  Host-side debug
+	 * state: deliberately not serialised, so snapshots stay compatible. */
+	uint8_t mem_class;    // class of the cycle in progress
+	uint8_t fetch_class;  // class traced fetches use: FETCH, or VECTOR mid-vector
+	uint8_t ea_class;     // S/U stickiness of this instruction's EA, cleared per instruction
+	bool op_first;        // next traced fetch is an opcode's first byte
+	uint8_t irq_depth;    // interrupt nesting: vector taken minus RTI
+
 	struct {
 		struct debug_cpu cpu;
 		struct debug_part part;
diff --git a/src/mc6809/mc6809_common.c b/src/mc6809/mc6809_common.c
index dbeb3a9..25a6483 100644
--- a/src/mc6809/mc6809_common.c
+++ b/src/mc6809/mc6809_common.c
@@ -49,21 +49,42 @@
  * Memory interface
  */
 
-static uint8_t fetch_byte_notrace(struct MC6809 *cpu, uint16_t a) {
+// One read cycle, tagged with its access class.  Every read in both cores
+// lands here, so the class is set exactly once per cycle and can never be
+// left over from the cycle before.
+static uint8_t mem_read_class(struct MC6809 *cpu, uint16_t a, uint8_t cls) {
 	cpu->nmi_latch |= (cpu->nmi_armed && cpu->nmi);
 	cpu->firq_latch = cpu->firq;
 	cpu->irq_latch = cpu->irq;
+	cpu->mem_class = cls;
 	DELEGATE_CALL(cpu->mem_cycle, 1, a);
 	return cpu->D;
 }
 
+// Data read through an effective address.  ea_class carries the S/U
+// stickiness the current instruction's EA computation established, so
+// `lda 4,s` records as an S-derived read without this path knowing how the
+// address was reached.
+static uint8_t fetch_byte_notrace(struct MC6809 *cpu, uint16_t a) {
+	return mem_read_class(cpu, a, MC6809_MC_DATA | cpu->ea_class);
+}
+
 static uint16_t fetch_word_notrace(struct MC6809 *cpu, uint16_t a) {
 	unsigned v = fetch_byte_notrace(cpu, a);
 	return (v << 8) | fetch_byte_notrace(cpu, a+1);
 }
 
+// The traced fetch is the instruction stream, in every core and every
+// addressing mode -- opcode, postbyte, offset, immediate operand.  The one
+// exception is take_interrupt()'s vector read, which parks MC6809_MC_VECTOR in
+// fetch_class for the duration rather than being routed around the tracer.
 static uint8_t fetch_byte(struct MC6809 *cpu, uint16_t a) {
-	unsigned v = fetch_byte_notrace(cpu, a);
+	uint8_t cls = cpu->fetch_class;
+	if (cpu->op_first) {
+		cls |= MC6809_MC_OPCODE;
+		cpu->op_first = 0;
+	}
+	unsigned v = mem_read_class(cpu, a, cls);
 #ifdef TRACE
 	cpu->trace_bytes[cpu->trace_nbytes++] = v;
 	++cpu->trace_next_pc;
@@ -76,15 +97,23 @@ static uint16_t fetch_word(struct MC6809 *cpu, uint16_t a) {
 	return (v << 8) | fetch_byte(cpu, a + 1);
 }
 
-static void store_byte(struct MC6809 *cpu, uint16_t a, uint8_t d) {
+static void mem_write_class(struct MC6809 *cpu, uint16_t a, uint8_t d, uint8_t cls) {
 	cpu->nmi_latch |= (cpu->nmi_armed && cpu->nmi);
 	cpu->firq_latch = cpu->firq;
 	cpu->irq_latch = cpu->irq;
 	cpu->D = d;
+	cpu->mem_class = cls;
 	DELEGATE_CALL(cpu->mem_cycle, 0, a);
 }
 
-#define peek_byte(c,a) ((void)fetch_byte_notrace(c,a))
+static void store_byte(struct MC6809 *cpu, uint16_t a, uint8_t d) {
+	mem_write_class(cpu, a, d, MC6809_MC_DATA | cpu->ea_class);
+}
+
+// A dead bus cycle.  It reaches RAM with RAS asserted and is indistinguishable
+// from a real read at the machine's memory path, which is the whole reason the
+// class travels down with the cycle.
+#define peek_byte(c,a) ((void)mem_read_class(c,a,MC6809_MC_DEAD))
 #define NVMA_CYCLE (peek_byte(cpu, 0xffff))
 
 /*
@@ -353,38 +382,48 @@ static void mc6809_emuext_break(struct MC6809 *cpu) {
  * Stack operations
  */
 
+// Stack traffic is classed at the source rather than inferred from the address,
+// so a push to S is S-derived even when S is pointing somewhere unexpected --
+// which, for a program whose stack has been destroyed by a bank remap, is
+// exactly the case worth catching.
+//
+// PUSHPULL separates this from `sta 4,s` and `lda ,u+`, which ea_indexed also
+// marks S- or U-derived.  Measured on one boot, U-as-general-pointer outweighs
+// U-as-stack by more than two hundred to one, so a flag that merged them would
+// answer "how deep did the stack get" with the size of a page copy.
+
 static void push_s_byte(struct MC6809 *cpu, uint8_t v) {
-	store_byte(cpu, --REG_S, v);
+	mem_write_class(cpu, --REG_S, v, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
 }
 
 static void push_s_word(struct MC6809 *cpu, uint16_t v) {
-	store_byte(cpu, --REG_S, v);
-	store_byte(cpu, --REG_S, v >> 8);
+	mem_write_class(cpu, --REG_S, v, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
+	mem_write_class(cpu, --REG_S, v >> 8, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
 }
 
 static uint8_t pull_s_byte(struct MC6809 *cpu) {
-	return fetch_byte_notrace(cpu, REG_S++);
+	return mem_read_class(cpu, REG_S++, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
 }
 
 static uint16_t pull_s_word(struct MC6809 *cpu) {
-	unsigned v = fetch_byte_notrace(cpu, REG_S++);
-	return (v << 8) | fetch_byte_notrace(cpu, REG_S++);
+	unsigned v = mem_read_class(cpu, REG_S++, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
+	return (v << 8) | mem_read_class(cpu, REG_S++, MC6809_MC_STACK_S | MC6809_MC_PUSHPULL);
 }
 
 static void push_u_byte(struct MC6809 *cpu, uint8_t v) {
-	store_byte(cpu, --REG_U, v);
+	mem_write_class(cpu, --REG_U, v, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
 }
 
 static void push_u_word(struct MC6809 *cpu, uint16_t v) {
-	store_byte(cpu, --REG_U, v);
-	store_byte(cpu, --REG_U, v >> 8);
+	mem_write_class(cpu, --REG_U, v, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
+	mem_write_class(cpu, --REG_U, v >> 8, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
 }
 
 static uint8_t pull_u_byte(struct MC6809 *cpu) {
-	return fetch_byte_notrace(cpu, REG_U++);
+	return mem_read_class(cpu, REG_U++, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
 }
 
 static uint16_t pull_u_word(struct MC6809 *cpu) {
-	unsigned v = fetch_byte_notrace(cpu, REG_U++);
-	return (v << 8) | fetch_byte_notrace(cpu, REG_U++);
+	unsigned v = mem_read_class(cpu, REG_U++, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
+	return (v << 8) | mem_read_class(cpu, REG_U++, MC6809_MC_STACK_U | MC6809_MC_PUSHPULL);
 }
