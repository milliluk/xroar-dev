+	if (trap->audit_clear) {
+		LOG_MOD_DEBUG(2, "trap", "audit clear\n");
+		audit_clear();
+	}
+	if (trap->audit_off) {
+		LOG_MOD_DEBUG(2, "trap", "audit off\n");
+		audit_set_active(0);
+	}
+	if (trap->audit_on) {
