 	switch ((postbyte >> 5) & 3) {
 		case 0: reg = REG_X; break;
 		case 1: reg = REG_Y; break;
-		case 2: reg = REG_U; break;
-		case 3: reg = REG_S; break;
+		case 2: reg = REG_U; cpu->ea_class = MC6809_MC_STACK_U; break;
+		case 3: reg = REG_S; cpu->ea_class = MC6809_MC_STACK_S; break;
 		default: reg = 0; break;
 	}
 	if ((postbyte & 0x80) == 0) {
@@ -2173,7 +2186,19 @@ static void take_interrupt(struct MC6809 *cpu, uint8_t mask, uint16_t vec) {
 	cpu->trace_next_pc = vec;
 	cpu->trace_nbytes = 0;
 #endif
+	// The vector read goes through the traced fetch like any instruction
+	// byte, so it is reclassed here rather than routed around the tracer.
+	// Depth is inferred from vector-taken/RTI pairing: a handler that
+	// unwinds any other way leaves it high, which the report should say
+	// rather than pretend to know better.
+	cpu->fetch_class = MC6809_MC_VECTOR;
 	REG_PC = fetch_word(cpu, vec);
+	cpu->fetch_class = MC6809_MC_FETCH;
+	// RESET arrives through this path too and never returns via RTI, so
+	// counting it would peg the depth at 1 for the life of the run and
+	// mark every subsequent access as interrupt context.
