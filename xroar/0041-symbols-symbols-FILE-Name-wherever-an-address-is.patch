 // -profile-range NAME=LO-HI (repeatable).  LO/HI are physical addresses,
-// 0x-prefixed or bare hex, inclusive.  A bare LO with no dash is a one-byte
-// range.  Duplicate names are allowed; the caller resolves symbols to
-// physical with cmaddr.py and passes the numbers.
+// inclusive: bare hex (this option predates the 0x-or-decimal grammar and
+// keeps its own spelling), or "@Symbol" from -symbols.  A bare LO with no
+// dash is a one-byte range.  Duplicate names are allowed.
+static unsigned long profile_parse_addr(const char *s) {
+	struct symfile_addr sa;
+	if (symfile_resolve_token(s, &sa))
+		return sa.value;
+	return strtoul(s, NULL, 16);
+}
