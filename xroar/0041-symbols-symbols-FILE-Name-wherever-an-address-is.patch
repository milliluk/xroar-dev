 src/gdb.c                  |  32 ++++++++++--
 src/mc6809/hd6309.c        |   2 +
 src/mc6809/mc6809.c        |   2 +
 src/mc6809/mc6809_common.c |  26 ++++++++++
 src/xroar.c                | 102 ++++++++++++++++++++++++++++++++-----
 6 files changed, 151 insertions(+), 16 deletions(-)

