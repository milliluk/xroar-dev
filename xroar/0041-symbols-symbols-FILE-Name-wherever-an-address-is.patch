index b0e37de..41dea21 100644
--- a/src/gdb.c
+++ b/src/gdb.c
@@ -108,6 +108,9 @@
  * Use that, not paddr: paddr is the machine's last bus cycle, which by the
  * time a stop reply is formatted has moved past the triggering access -- a
  * 16-bit store to a watched byte reports the byte AFTER it.
+ * With -symbols loaded, a further sym: pair carries "Name+off (IMAGE)" and,
+ * if line records were loaded too, " file:line" -- hex-encoded, because an
+ * RSP value is hex.
  * Unrecognised pairs are ignorable by protocol.
 
  * The four derived values above are as far as this should go. Anything that is
@@ -175,6 +178,8 @@
 #include "mc6809/mc6809.h"
 #include "mc6883.h"
 #include "ram.h"
+#include "symtab.h"
+#include "symfile.h"
 #include "tcc1014/tcc1014.h"
 #include "xroar.h"
 
@@ -920,7 +925,7 @@ static int send_char(struct gdb_interface_private *gip, char c) {
 // rather than 'S', so a machine-independent field added to this reply reaches
 // every machine instead of riding the GIME branch.
 static void send_last_signal(struct gdb_interface_private *gip) {
-	char tmpbuf[96];
+	char tmpbuf[512];
 	uint16_t pc = mc6809_get_pc(gip->cpu);
 	// With no MMU the physical PC is the logical PC -- the same degrade
 	// trap_fast_phys() applies everywhere else in this fork.
@@ -942,8 +947,29 @@ static void send_last_signal(struct gdb_interface_private *gip) {
 	// so it describes this stop and not an earlier one.
 	if (n > 0 && (size_t)n < sizeof(tmpbuf) &&
 	    gip->machine->debug.wp_match_pending) {
-		snprintf(tmpbuf + n, sizeof(tmpbuf) - (size_t)n, "watch:%05x;",
-			 gip->machine->debug.wp_match_address & 0x1fffff);
+		n += snprintf(tmpbuf + n, sizeof(tmpbuf) - (size_t)n, "watch:%05x;",
+			      gip->machine->debug.wp_match_address & 0x1fffff);
+	}
+	// With -symbols, say where the stop is in the program's own
+	// terms.  An RSP value is hex, so the text goes over
+	// hex-encoded -- the pair is ignorable by protocol, and a
+	// client that does not decode it loses nothing.  This is the
+	// same reverse lookup the flight recorder and the profiler
+	// print, so a stop and a trace name a routine identically.
+	const char *where = symfile_whereis(xpc, 0);
+	if (where && n > 0 && (size_t)n < sizeof(tmpbuf)) {
+		const char *src = symfile_line(xpc);
+		char text[192];
+		snprintf(text, sizeof(text), "%s%s%s", where,
+			 src ? " " : "", src ? src : "");
+		size_t room = sizeof(tmpbuf) - (size_t)n;
+		if (room > 8 + strlen(text) * 2) {
+			n += snprintf(tmpbuf + n, room, "sym:");
+			for (const char *p = text; *p; p++)
+				n += snprintf(tmpbuf + n, sizeof(tmpbuf) - (size_t)n,
+					      "%02x", (unsigned char)*p);
+			snprintf(tmpbuf + n, sizeof(tmpbuf) - (size_t)n, ";");
+		}
 	}
 	send_packet_string(gip, tmpbuf);
 }
