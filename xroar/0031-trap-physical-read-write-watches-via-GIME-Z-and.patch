@@ -1453,10 +1476,21 @@ static void read_byte(struct coco3 *mcc3, unsigned A) {
 		if (!mcc3->dat.MMUEN || (mcc3->dat.MC3 && A >= 0xfe00 && A < 0xff00)) {
