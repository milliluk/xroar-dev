--- a/src/breakpoint.h
+++ b/src/breakpoint.h
@@ -122,4 +122,18 @@ inline void bp_check_watchpoints(struct bp_watchpoint_set *set, bool RnW, uint32
 	}
 }
 
+// Physical watchpoints.  addr/addr_end are flat physical addresses; the
+// machine calls the hooks with the decode's own final physical address for
+// each CPU RAM cycle while the corresponding list is non-empty.
+// Opaque here: this header does not include the definition, so declare
+// the tag at file scope, or each prototype below invents its own
+// incompatible one and -Werror rejects the lot.
+struct bp_session;
+void bp_wp_phys_add_range(struct bp_session *bps, unsigned type,
+			  unsigned addr, unsigned addr_end, DELEGATE_T0(void) handler);
+void bp_wp_phys_remove_range(struct bp_session *bps, unsigned type,
+			     unsigned addr, unsigned addr_end);
+void bp_wp_phys_read_hook(struct bp_session *bps, unsigned phys, uint8_t value);
+void bp_wp_phys_write_hook(struct bp_session *bps, unsigned phys, uint8_t value);
+
 #endif
