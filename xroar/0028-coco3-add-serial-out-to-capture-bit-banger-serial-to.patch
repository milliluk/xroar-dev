+	// -serial-out: signal-level tap on the serial bit-banger (PIA1-A bit 1).
+	// Decodes 8N1 frames relative to the idle (mark) level captured at each
+	// start edge, so it is independent of output driver polarity.
+	struct {
+		FILE *stream;            // capture file, or NULL if disabled
+		struct event sample_event;
+		event_ticks bit_ticks;   // master ticks per serial bit
+		uint8_t line;            // last seen TxD level (PIA1-A bit 1)
+		uint8_t idle;            // mark level captured at the start edge
+		uint8_t data;            // byte being assembled (LSB first)
+		int bit;                 // -2 start check; -1 idle; 0..7 data; 8 stop
+	} serial_out;
 };
 
