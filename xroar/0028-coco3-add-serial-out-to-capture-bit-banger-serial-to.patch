+// -serial-out: sample the serial line at bit centres.  A start edge first
+// schedules a check at the start-bit centre (0.5 bit after the edge): if the
+// line has already returned to mark it was a glitch, not a real start, so the
+// frame is dropped.  Otherwise the 8 data bits are sampled at one-bit
+// intervals, decoded relative to the mark level captured at the start edge
+// (mark==1, space==0, LSB first).  A final sample checks the stop bit; a frame
+// with a non-mark stop bit is dropped as a framing error.
+
+static void coco3_serial_sample(void *sptr) {
+	struct coco3 *mcc3 = sptr;
+	int b = mcc3->serial_out.bit;
+	_Bool is_mark = (mcc3->serial_out.line == mcc3->serial_out.idle);
+	if (b == -2) {
+		// Start-bit centre: reject a glitch that already returned to mark.
+		if (is_mark) {
+			mcc3->serial_out.bit = -1;
+			return;
+		}
+		mcc3->serial_out.bit = 0;
+		event_queue_dt(&mcc3->serial_out.sample_event, mcc3->serial_out.bit_ticks);
+		return;
+	}
+	if (b < 0)
+		return;
+	if (b < 8) {
+		if (is_mark)
+			mcc3->serial_out.data |= (1 << b);
+		mcc3->serial_out.bit = b + 1;
+		event_queue_dt(&mcc3->serial_out.sample_event, mcc3->serial_out.bit_ticks);
+	} else {
+		if (is_mark && mcc3->serial_out.stream) {
+			putc(mcc3->serial_out.data, mcc3->serial_out.stream);
+			fflush(mcc3->serial_out.stream);
+		}
+		mcc3->serial_out.bit = -1;
+		mcc3->serial_out.data = 0;
+	}
+}
+
 static void pia1a_data_postwrite(void *sptr) {
 	struct coco3 *mcc3 = sptr;
 	joystick_dac_write(mcc3);
@@ -1710,6 +1790,19 @@ static void pia1a_data_postwrite(void *sptr) {
 	// Tandy Hi-Res adaptor strobes on the DAC MSB
 	if (mcc3->hires_joystick == HIRES_RIGHT || mcc3->hires_joystick == HIRES_LEFT)
 		hires_joystick_update(mcc3);
+	if (mcc3->serial_out.stream) {
+		uint8_t newline = (PIA_VALUE_A(mcc3->PIA1) >> 1) & 1;
+		if (mcc3->serial_out.bit == -1 && newline != mcc3->serial_out.line) {
+			// Possible start edge: capture the mark level and validate at the
+			// start-bit centre before committing to a frame.
+			mcc3->serial_out.idle = mcc3->serial_out.line;
+			mcc3->serial_out.data = 0;
+			mcc3->serial_out.bit = -2;
+			event_queue_dt(&mcc3->serial_out.sample_event,
+			               mcc3->serial_out.bit_ticks / 2);
+		}
+		mcc3->serial_out.line = newline;
+	}
 }
 
 static void pia1a_control_postwrite(void *sptr) {
@@ -1784,7 +1877,11 @@ static void coco3_print_byte(void *sptr, bool RnW, uint32_t A) {
 	int byte = MC6809_REG_A(mcc3->CPU);
 	printer_strobe(mcc3->printer_interface, 0, byte);
 	printer_strobe(mcc3->printer_interface, 1, byte);
-	mcc3->CPU->reg_pc = 0xa2df;
+	// Normally we shortcut past the ROM's slow bit-bang timing loop.  When
