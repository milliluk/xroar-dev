+// -serial-out: sample the serial line at bit centres.  Same decoder as the
+// CoCo 3's in coco3.c: a start edge first schedules a check at the start-bit
+// centre (0.5 bit after the edge) to reject glitches, the 8 data bits are
+// sampled at one-bit intervals relative to the mark level captured at the
+// start edge (mark==1, space==0, LSB first), and a final sample checks the
+// stop bit, dropping the frame on a framing error.
+
+static void dragon_serial_sample(void *sptr) {
+	struct dragon *md = sptr;
+	int b = md->serial_out.bit;
+	_Bool is_mark = (md->serial_out.line == md->serial_out.idle);
+	if (b == -2) {
+		// Start-bit centre: reject a glitch that already returned to mark.
+		if (is_mark) {
+			md->serial_out.bit = -1;
+			return;
+		}
+		md->serial_out.bit = 0;
+		event_queue_dt(&md->serial_out.sample_event, md->serial_out.bit_ticks);
+		return;
+	}
+	if (b < 0)
+		return;
+	if (b < 8) {
+		if (is_mark)
+			md->serial_out.data |= (1 << b);
+		md->serial_out.bit = b + 1;
+		event_queue_dt(&md->serial_out.sample_event, md->serial_out.bit_ticks);
+	} else {
+		if (is_mark && md->serial_out.stream) {
+			putc(md->serial_out.data, md->serial_out.stream);
+			fflush(md->serial_out.stream);
+		}
+		md->serial_out.bit = -1;
+		md->serial_out.data = 0;
+	}
+}
+
+void dragon_serial_out_edge(struct dragon *md) {
+	if (!md->serial_out.stream)
+		return;
+	uint8_t newline = (PIA_VALUE_A(md->PIA1) >> 1) & 1;
+	if (md->serial_out.bit == -1 && newline != md->serial_out.line) {
+		// Possible start edge: capture the mark level and validate at the
+		// start-bit centre before committing to a frame.
+		md->serial_out.idle = md->serial_out.line;
+		md->serial_out.data = 0;
+		md->serial_out.bit = -2;
+		event_queue_dt(&md->serial_out.sample_event,
+		               md->serial_out.bit_ticks / 2);
+	}
+	md->serial_out.line = newline;
+}
+
