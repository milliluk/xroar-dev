From 2c73973c633b07f345cbbc7ef653938c7d58cc91 Mon Sep 17 00:00:00 2001
From: milliluk-erik <build@localhost>
Date: Mon, 3 Aug 2026 12:41:09 -0400
Subject: [PATCH 21/44] trap-time-conditions: seconds= / cycle= scheduled trap

---
 src/xroar.c | 121 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 121 insertions(+)

diff --git a/src/xroar.c b/src/xroar.c
index d918c6e..1f5b1d5 100644
--- a/src/xroar.c
+++ b/src/xroar.c
@@ -120,6 +120,11 @@ struct trap_count_range {
 	unsigned long last;
 };
 
+// cycle=/seconds= traps fire from a scheduled event, not a breakpoint; the
+// event and its bookkeeping live in a separately allocated struct so growing
+// the trap_defs array never moves a queued event.
+struct trap_trigger;
+
 struct trap_def {
 	// Trap condition
 	char *cond;
@@ -154,11 +159,16 @@ struct trap_def {
 	unsigned wp_pc;
 	unsigned wp_addr;
 	uint8_t wp_value;
+	struct trap_trigger *trigger;  // cycle=/seconds= scheduled trigger
 };
 
 static unsigned num_trap_defs = 0;
 static struct trap_def *trap_defs = NULL;
 static struct trap_def *cur_trap_def = NULL;
+// cycle=/seconds= triggers, freed at teardown.  They are never freed inline: a
+// one-shot trigger fires from inside its own event dispatch, and the event is
+// embedded, so freeing during the handler is a use-after-free (see enable_trap).
+static struct slist *trap_triggers = NULL;
 
 static bool tape_motor_state = 0;
 static event_ticks tape_motor_on_time = 0;
@@ -3299,6 +3309,50 @@ static void parse_range_ul(const char *str, unsigned long *a, unsigned long *b)
 	free(str_copy);
 }
 
+// cycle=N fires when the CPU cycle counter (xroar_cpu_cycles, the same count
+// -trap-cycle-print reports) reaches N.  There is no event tied to that
+// counter, so we poll on a 1ms emulated-time event and fire on the crossing.
+// seconds=N fires N emulated seconds from arm time (boot), counted down one
+// second at a time in the event timebase, mirroring xroar_set_timeout: a
+// single event delta must stay well inside the 32-bit tick window.
+struct trap_trigger {
+	struct event event;
+	struct trap_def *trap;
+	int kind;              // 1 = cycle, 2 = seconds
+	uint64_t target_cycle; // cycle= target
+	int seconds_left;      // seconds= whole-second countdown
+	event_ticks rem_ticks; // seconds= fractional remainder
+};
+
+static void handle_cycle_trigger(void *sptr) {
+	struct trap_trigger *trg = sptr;
+	if (xroar_cpu_cycles >= trg->target_cycle) {
+		handle_trap(trg->trap);   // one-shot: do not requeue
+		return;
+	}
+	trg->event.at_tick = event_current_tick + EVENT_MS(1);
+	event_queue(&trg->event);
+}
+
+static void handle_seconds_trigger(void *sptr) {
+	struct trap_trigger *trg = sptr;
+	if (trg->seconds_left == 0) {
+		handle_trap(trg->trap);
+		return;
+	}
+	trg->seconds_left--;
+	if (trg->seconds_left) {
+		trg->event.at_tick = event_current_tick + EVENT_S(1);
+	} else {
+		if (trg->rem_ticks == 0) {
+			handle_trap(trg->trap);
+			return;
+		}
+		trg->event.at_tick = event_current_tick + trg->rem_ticks;
+	}
+	event_queue(&trg->event);
+}
+
 static void enable_trap(struct trap_def *trap, bool enable) {
 	if (0 == c_strcasecmp(trap->cond, "immediate") ||
 	    0 == strcmp(trap->cond, "-")) {
@@ -3314,6 +3368,67 @@ static void enable_trap(struct trap_def *trap, bool enable) {
 		}
 		return;
 	}
+
+	// cycle=N / seconds=N : timer-driven triggers, no breakpoint session
+	// needed.  Accept cycle|cycles and sec|secs|second|seconds.
+	{
+		const char *eq = strchr(trap->cond, '=');
+		if (eq) {
+			size_t klen = (size_t)(eq - trap->cond);
+			const char *v = eq + 1;
+			int is_cycle = (klen == 5 && 0 == c_strncasecmp(trap->cond, "cycle", 5));
+			int is_secs  = (klen == 7 && 0 == c_strncasecmp(trap->cond, "seconds", 7));
+			if (is_cycle || is_secs) {
+				if (!enable) {
+					// Detach and unqueue, but never free here: this branch
+					// can run from inside the trigger's own event dispatch
+					// (handle_trap -> enable_trap(,0)), and event_dispatch_next
+					// reads the embedded event after the handler returns.
+					// Freeing now is a use-after-free that corrupts the event
+					// list.  The trigger is freed once, at teardown.
+					if (trap->trigger) {
+						event_dequeue(&trap->trigger->event);
+						trap->trigger = NULL;
+					}
+					return;
+				}
+				struct trap_trigger *trg = xmalloc(sizeof(*trg));
+				*trg = (struct trap_trigger){0};
+				trg->trap = trap;
+				trap->trigger = trg;
+				trap_triggers = slist_append(trap_triggers, trg);
+				if (is_cycle) {
+					trg->kind = 1;
+					trg->target_cycle = strtoull(v, NULL, 0);
+					event_init(&trg->event, MACHINE_EVENT_LIST,
+					    DELEGATE_AS0(void, handle_cycle_trigger, trg));
+					if (xroar_cpu_cycles >= trg->target_cycle) {
+						handle_trap(trap);
+					} else {
+						trg->event.at_tick = event_current_tick + EVENT_MS(1);
+						event_queue(&trg->event);
+					}
+				} else {
+					double t = strtod(v, NULL);
+					if (t <= 0.0) {
+						handle_trap(trap);
+					} else {
+						trg->kind = 2;
+						trg->seconds_left = (int)t;
+						trg->rem_ticks = EVENT_S(t - (double)trg->seconds_left);
+						event_init(&trg->event, MACHINE_EVENT_LIST,
+						    DELEGATE_AS0(void, handle_seconds_trigger, trg));
+						// mirror xroar_set_timeout: pre-increment, let the
+						// handler schedule the first hop.
+						trg->seconds_left++;
+						handle_seconds_trigger(trg);
+					}
+				}
+				return;
+			}
+		}
+	}
+
 	assert(xroar.machine != NULL);
 	char *cond_copy = xstrdup(trap->cond);
 	char *val = cond_copy;
@@ -3398,6 +3513,10 @@ static void disable_all_traps(void) {
 	for (unsigned i = 0; i < num_trap_defs; ++i) {
 		enable_trap(&trap_defs[i], 0);
 	}
+	// Now that every trap is detached and no dispatch is in flight, free the
+	// cycle=/seconds= triggers that were deferred to avoid a free-during-dispatch.
+	slist_free_full(trap_triggers, (slist_free_func)free);
+	trap_triggers = NULL;
 }
 
 // Breakpoint (pc=) dispatch: no access context to record.
@@ -4240,6 +4359,8 @@ static void helptext(void) {
 "  read=A[-B]            trigger on read from address range\n"
 "  write=A[-B]           trigger on write to address range\n"
 "  access=A[-B]          trigger on either read or write\n"
+"  cycle=N               trigger when the CPU cycle counter reaches N\n"
+"  seconds=N             trigger N emulated seconds after boot\n"
 "  tape-motor-off        trigger when tape motor switches off"
 
 	);
