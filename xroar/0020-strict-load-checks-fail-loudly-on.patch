+// Strict essential-ROM check, called by each derived machine's finish after
+// its CRC verification.  slot is the slot the essential image loads into, or
+// -1 when the whole bank is one image (the rombank_verify_crc convention).
+// Exits rather than returning when the check fails; see dragon.c.
+void dragon_require_rom(struct rombank *bank, int slot, _Bool has, const char *name);
