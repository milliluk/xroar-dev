+// Essential-ROM check, the same policy applied to the CoCo 3's Super ECB in
+// coco3.c: a machine whose boot BASIC is absent or unrecognised executes
+// garbage from the reset vector onward, and an automated run downstream of
+// that looks healthy while testing nothing.  Only the image the machine
+// cannot reach a BASIC prompt without is required -- a 4K CoCo's missing
+// Extended BASIC and the Dragon 64's 64K-mode ROM stay optional, and no new
+// CRC lists are invented: `has` is the verdict the machine's existing
+// rombank_verify_crc call already produced.
+void dragon_require_rom(struct rombank *bank, int slot, _Bool has, const char *name) {
+	if (has)
+		return;
+	// Distinguish "wrong image" from "no image", same as coco3.c: a CRC
+	// mismatch can be overridden, a missing file cannot.
+	_Bool loaded = 0;
+	if (bank) {
+		if (slot < 0) {
+			loaded = 1;
+			for (unsigned i = 0; i < bank->nslots; ++i)
+				if (!bank->d[i])
+					loaded = 0;
+		} else if ((unsigned)slot < bank->nslots) {
+			loaded = bank->d[slot] != NULL;
+		}
+	}
+	if (loaded) {
+		fprintf(stderr, "xroar: %s ROM CRC invalid, exiting "
+				"(pass -force-crc-match to boot anyway)\n", name);
+	} else {
+		fprintf(stderr, "xroar: %s ROM not found (check -rompath), exiting\n", name);
+	}
+	exit(1);
+}
+
 bool dragon_finish_common(struct dragon *md) {
 	struct machine *m = &md->public;
 	struct part *p = &m->part;
