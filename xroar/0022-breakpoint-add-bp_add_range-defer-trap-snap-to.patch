diff --git a/src/xroar.c b/src/xroar.c
index 1f5b1d5..e45ef31 100644
--- a/src/xroar.c
+++ b/src/xroar.c
@@ -3557,6 +3557,32 @@ static char *screenshot_numbered_name(const char *base, unsigned long n) {
 	return out;
 }
 
+// Deferred trap-snap.  seconds=/cycle= traps fire from a scheduled event,
+// which lands mid-instruction: the CPU may have consumed an opcode byte and
+// have PC pointing at its operand -- a position the snapshot cannot fully
+// represent (the prefix latch is serialised; a fetch-in-progress is not).
+// Resuming such a file executes operand bytes as opcodes.  Found the hard
+// way: a 2-byte code shift moved a boot's 62s capture onto a BNE's offset
+// byte at $3612, and every resume of that file executed the offset as LDU,
+// wandered into a puls epilogue with no frame, pulled boot-era stack
+// leftovers into PC, and died executing the framebuffer.  So: park the
+// filename, arm a one-shot any-address breakpoint, and write the snapshot
+// from the instruction fetch hook, where PC is at an opcode boundary by
+// construction.  pc= traps already fire from that hook and write directly.
+static char *deferred_snap_path;
+
+static void deferred_snap_fire(void *sptr, uint32_t A) {
+	(void)A;
+	(void)sptr;
+	machine_remove_instruction_hook(xroar.machine, DELEGATE_AS1(void, uint32, deferred_snap_fire, NULL));
+	if (deferred_snap_path) {
+		LOG_MOD_DEBUG(2, "trap", "write snapshot (deferred to instruction boundary): %s\n", deferred_snap_path);
+		write_snapshot(deferred_snap_path);
+		free(deferred_snap_path);
+		deferred_snap_path = NULL;
+	}
+}
+
 static void handle_trap(void *sptr) {
 	struct trap_def *trap = sptr;
 
@@ -3576,8 +3602,18 @@ static void handle_trap(void *sptr) {
 
 	// Break action
 	if (trap->snap) {
-		LOG_MOD_DEBUG(2, "trap", "write snapshot: %s\n", trap->snap);
-		write_snapshot(trap->snap);
+		// -trap-timeout 0 exits synchronously at the end of this handler;
+		// a deferred write would be skipped, so take the mid-instruction
+		// snapshot over no snapshot at all in that one case.
+		bool quits_now = trap->timeout && 0 == strcmp(trap->timeout, "0");
+		if (trap->trigger && !quits_now && !deferred_snap_path) {
+			LOG_MOD_DEBUG(2, "trap", "defer snapshot to instruction boundary: %s\n", trap->snap);
+			deferred_snap_path = xstrdup(trap->snap);
+			machine_add_instruction_hook(xroar.machine, DELEGATE_AS1(void, uint32, deferred_snap_fire, NULL));
+		} else {
+			LOG_MOD_DEBUG(2, "trap", "write snapshot: %s\n", trap->snap);
+			write_snapshot(trap->snap);
+		}
 	}
 	if (trap->screenshot) {
 		// Classify the range once, on the first fire, and remember it: xroar
