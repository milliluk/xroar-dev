diff --git a/src/breakpoint.c b/src/breakpoint.c
index 5738042..5596a25 100644
--- a/src/breakpoint.c
+++ b/src/breakpoint.c
@@ -189,7 +189,36 @@ static int compar_breakpoint_a(const void *aa, const void *bb) {
 
 // Instruction hook
 
+bool bp_instr_hook_add(struct bp_breakpoint_set *bbs, DELEGATE_T1(void, uint32) handler) {
+	struct bp_instr_hook *h = xmalloc(sizeof(*h));
+	h->handler = handler;
+	h->next = bbs->hooks;
+	bbs->hooks = h;
+	return 1;
+}
+
+void bp_instr_hook_remove(struct bp_breakpoint_set *bbs, DELEGATE_T1(void, uint32) handler) {
+	for (struct bp_instr_hook **p = &bbs->hooks; *p; p = &(*p)->next) {
+		if ((*p)->handler.func == handler.func && (*p)->handler.sptr == handler.sptr) {
+			struct bp_instr_hook *dead = *p;
+			*p = dead->next;
+			free(dead);
+			return;
+		}
+	}
+}
+
 void bp_instruction_hook(void *sptr, uint32_t A) {
+	// Ambient hooks first; a hook may remove itself (one-shots), so walk
+	// via a saved next pointer.
+	{
+		struct bp_breakpoint_set *bbs = sptr;
+		struct bp_instr_hook *next;
+		for (struct bp_instr_hook *h = bbs->hooks; h; h = next) {
+			next = h->next;
+			DELEGATE_CALL(h->handler, A);
+		}
+	}
 	struct bp_breakpoint_set *bbs = sptr;
 	struct bp_breakpoint key = { .A = A };
 	struct bp_breakpoint *ent = NULL;
diff --git a/src/breakpoint.h b/src/breakpoint.h
index b0bbde1..a07c29b 100644
--- a/src/breakpoint.h
+++ b/src/breakpoint.h
@@ -39,13 +39,28 @@ struct bp_breakpoint {
 	DELEGATE_T2(void, bool, uint32) handler[BP_HANDLERS_PER_ADDRESS];
 };
 
+// Ambient per-instruction hook: called with the PC on every instruction
+// fetch while any are registered.  This is the only way to say "at the next
+// instruction boundary" without knowing the next PC (the deferred trap-snap
+// needs exactly that), and it is what the flight recorder and profiler ride.
+struct bp_instr_hook {
+	struct bp_instr_hook *next;
+	DELEGATE_T1(void, uint32) handler;
+};
+
 struct bp_breakpoint_set {
 	size_t nbreakpoints;
 	size_t nallocated;
 	struct bp_breakpoint *list;
 	bool modified;  // an add or delete has occurred during list run
+	struct bp_instr_hook *hooks;  // ambient per-instruction hooks
 };
 
+bool bp_instr_hook_add(struct bp_breakpoint_set *bbs, DELEGATE_T1(void, uint32) handler);
+void bp_instr_hook_remove(struct bp_breakpoint_set *bbs, DELEGATE_T1(void, uint32) handler);
+// True while anything (addresses or ambient hooks) needs the CPU hook.
+#define bp_breakpoint_set_active(bbs) ((bbs)->nbreakpoints > 0 || (bbs)->hooks)
+
 // Add a breakpoint.  Returns 1 if successful, else 0 (e.g. identical
 // breakpoint already exists)
 bool bp_breakpoint_add(struct bp_breakpoint_set *bbs, uint32_t A,
diff --git a/src/coco3.c b/src/coco3.c
index bc58f06..5d76af3 100644
--- a/src/coco3.c
+++ b/src/coco3.c
@@ -337,6 +337,22 @@ static void coco3_write_byte(struct machine *m, unsigned A, uint8_t D);
 static void coco3_op_rts(struct machine *m);
 static void coco3_dump_ram(struct machine *m, FILE *fd);
 static int32_t coco3_get_symbol(struct machine *m, const char *label);
+static void coco3_add_instruction_hook(struct machine *m,
+				 DELEGATE_T1(void, uint32) handler) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	bp_instr_hook_add(&mcc3->breakpoint_set, handler);
+	mcc3->CPU->instruction_hook = DELEGATE_AS1(void, uint32, bp_instruction_hook, &mcc3->breakpoint_set);
+}
+
+static void coco3_remove_instruction_hook(struct machine *m,
+				    DELEGATE_T1(void, uint32) handler) {
+	struct coco3 *mcc3 = (struct coco3 *)m;
+	bp_instr_hook_remove(&mcc3->breakpoint_set, handler);
+	if (!bp_breakpoint_set_active(&mcc3->breakpoint_set)) {
+		mcc3->CPU->instruction_hook.func = NULL;
+	}
+}
+
 static void coco3_add_breakpoint(struct machine *m, uint32_t A,
 				 DELEGATE_T2(void, bool, uint32) handler);
 static void coco3_remove_breakpoint(struct machine *m, int32_t A,
@@ -442,6 +458,8 @@ static struct part *coco3_allocate(void) {
 	m->dump_ram = coco3_dump_ram;
 	m->debug.get_symbol = coco3_get_symbol;
 	m->debug.add_breakpoint = coco3_add_breakpoint;
+	m->debug.add_instruction_hook = coco3_add_instruction_hook;
+	m->debug.remove_instruction_hook = coco3_remove_instruction_hook;
 	m->debug.remove_breakpoint = coco3_remove_breakpoint;
 	m->debug.add_watchpoint = coco3_add_watchpoint;
 	m->debug.remove_watchpoint = coco3_remove_watchpoint;
@@ -1571,7 +1589,7 @@ static void coco3_add_breakpoint(struct machine *m, uint32_t A,
 	if (!bp_breakpoint_add(&mcc3->breakpoint_set, A, handler)) {
 		LOG_MOD_WARN(p->partdb->name, "failed to add breakpoint @ 0x%04x\n", A);
 	}
-	if (mcc3->breakpoint_set.nbreakpoints) {
+	if (bp_breakpoint_set_active(&mcc3->breakpoint_set)) {
 		mcc3->CPU->instruction_hook = DELEGATE_AS1(void, uint32, bp_instruction_hook, &mcc3->breakpoint_set);
 	}
 }
@@ -1580,7 +1598,7 @@ static void coco3_remove_breakpoint(struct machine *m, int32_t A,
 				    DELEGATE_T2(void, bool, uint32) handler) {
 	struct coco3 *mcc3 = (struct coco3 *)m;
 	bp_breakpoint_remove(&mcc3->breakpoint_set, A, handler);
-	if (!mcc3->breakpoint_set.nbreakpoints) {
+	if (!bp_breakpoint_set_active(&mcc3->breakpoint_set)) {
 		mcc3->CPU->instruction_hook.func = NULL;
 	}
