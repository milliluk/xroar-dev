+// -profile-range NAME=LO-HI: a physical-PC trampoline/thunk profiler, and a
+// sibling of -trap-history.  It reuses the same ambient any-address fetch hook
+// and the cached trap_fast_phys_pc(), so it pays one MMU translation per
+// instruction while armed and nothing when off.  Each named range accumulates
+// edge-triggered entries, instructions executed inside, and CPU cycles spent
+// inside (the master tick delta between fetches, attributed to the instruction
+// that spent it).  -profile-hist N adds a per-physical-PC hit+cycle table for
+// discovering hot spots you did not name.  Dumped once at shutdown.
+#define PROFILE_MAX_RANGES 64
+#define PROFILE_PADDR_SPAN 0x80000     // 512K physical address space
+struct profile_range {
+	char *name;
+	unsigned long lo, hi;               // physical [lo,hi], inclusive
+	unsigned long entries;              // edge-triggered arrivals into the range
+	unsigned long instrs;               // instruction fetches with PC inside
+	unsigned long long cycles;          // master-tick cycles attributed inside
+};
+static struct profile_range profile_ranges[PROFILE_MAX_RANGES];
+static int profile_num_ranges = 0;
+static int profile_hist_top = 0;              // -profile-hist N: report top N PCs
+static char *profile_out_path = NULL;         // -profile-out FILE (default stderr)
+static uint32_t *profile_hist_hits = NULL;    // [PROFILE_PADDR_SPAN] hits
+static unsigned long long *profile_hist_cyc = NULL; // [PROFILE_PADDR_SPAN] cycles
+static struct breakpoint profile_bp;
+static _Bool profile_installed = 0;
+static int profile_prev_range = -1;           // range inside on the last fetch
+static long profile_prev_pc = -1;             // physical PC of the last fetch
+static uint32_t profile_prev_tick = 0;        // event_current_tick at last fetch
+static unsigned long long profile_total_instrs = 0;
+static unsigned long long profile_total_cycles = 0;
+static void profile_record(void *);
+static void profile_add_range(const char *);  // XC_CALL_STRING callback
+static void profile_dump(void);
+static _Bool profile_active(void) {
+	return profile_num_ranges > 0 || profile_hist_top > 0;
+}
+
 #else
 
 #define set_trap(s)
@@ -1637,6 +1674,7 @@ void xroar_shutdown(void) {
 	shutting_down = 1;
 	screenshot_flush(xroar.vo_interface);
 	disable_all_traps();
+	profile_dump();
 	save_config();
 	messenger_shutdown();
 	if (xroar.auto_kbd) {
@@ -3560,6 +3598,25 @@ static void enable_all_traps(void) {
