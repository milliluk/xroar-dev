diff --git a/src/protect.c b/src/protect.c
new file mode 100644
index 0000000..eb97c38
--- /dev/null
+++ b/src/protect.c
@@ -0,0 +1,322 @@
+/** \file
+ *
+ *  \brief Protected-memory mode: physical code/data policy checks.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ */
+
+#include "top-config.h"
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "xalloc.h"
+
+#include "logging.h"
+#include "machine.h"
+#include "mc6809/mc6809.h"
+#include "protect.h"
+#include "symfile.h"
+#include "xroar.h"
+
+uint8_t *protect_map = NULL;
+uint8_t protect_checks = 0;
+_Bool protect_live = 0;
+_Bool protect_auto = 1;
+uint32_t protect_stack_floor = 0;
+extern inline uint8_t protect_verdict(unsigned phys, uint8_t bits);
+
+// Tri-state command-line flags: -1 unstated, else 0/1.  Resolved at arm time
+// so the flags compose order-independently, the way -headless's implied
+// options do.
+static int opt_mode = -1;
+static int opt_stack = -1, opt_write = -1, opt_read = -1, opt_data = -1;
+static char *dump_path = NULL;
+
+struct protect_range {
+	uint32_t lo, hi;   // inclusive
+};
+
+static struct protect_range *code_ranges = NULL;
+static size_t n_code_ranges = 0, code_ranges_alloc = 0;
+static struct protect_range *data_ranges = NULL;
+static size_t n_data_ranges = 0, data_ranges_alloc = 0;
+static struct protect_range *allow_ranges = NULL;
+static size_t n_allow_ranges = 0, allow_ranges_alloc = 0;
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static void protect_fatal(const char *fmt, ...) __attribute__((noreturn, format(printf, 1, 2)));
+
+static void protect_fatal(const char *fmt, ...) {
+	va_list ap;
+	fputs("xroar: -protect-mode: ", stderr);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+	exit(EXIT_FAILURE);
+}
+
+void protect_opt_mode(_Bool v) { opt_mode = v; }
+void protect_opt_stack(_Bool v) { opt_stack = v; }
+void protect_opt_write(_Bool v) { opt_write = v; }
+void protect_opt_read(_Bool v) { opt_read = v; }
+void protect_opt_data(_Bool v) { opt_data = v; }
+
+void protect_opt_dump(const char *path) {
+	free(dump_path);
+	dump_path = xstrdup(path);
+}
+
+void protect_opt_stack_floor(uint32_t phys) { protect_stack_floor = phys; }
+
+static void range_add(struct protect_range **list, size_t *n, size_t *alloc,
+                      uint32_t lo, uint32_t hi) {
+	if (*n == *alloc) {
+		*alloc = *alloc ? *alloc * 2 : 64;
+		*list = xrealloc(*list, *alloc * sizeof(**list));
+	}
+	(*list)[(*n)].lo = lo;
+	(*list)[(*n)].hi = hi;
+	(*n)++;
+}
+
+void protect_class_range(uint32_t lo, uint32_t hi) {
+	range_add(&code_ranges, &n_code_ranges, &code_ranges_alloc, lo, hi);
+}
+
+void protect_data_range(uint32_t lo, uint32_t hi) {
+	range_add(&data_ranges, &n_data_ranges, &data_ranges_alloc, lo, hi);
+}
+
+void protect_allow_range(uint32_t lo, uint32_t hi) {
+	range_add(&allow_ranges, &n_allow_ranges, &allow_ranges_alloc, lo, hi);
+}
+
+static void paint(const struct protect_range *list, size_t n, uint8_t bit) {
+	for (size_t i = 0; i < n; i++) {
+		uint32_t lo = list[i].lo;
+		uint32_t hi = list[i].hi;
+		if (lo >= PROTECT_SPAN)
+			continue;
+		if (hi >= PROTECT_SPAN)
+			hi = PROTECT_SPAN - 1;
+		for (uint32_t a = lo; a <= hi; a++)
+			protect_map[a] |= bit;
+	}
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+void protect_arm(void) {
+	int def = (opt_mode > 0);
+	uint8_t checks = 0;
+	if (opt_stack >= 0 ? opt_stack : def)
+		checks |= PROTECT_CHECK_STACK;
+	if (opt_write >= 0 ? opt_write : def)
+		checks |= PROTECT_CHECK_WRITE;
+	if (opt_read >= 0 ? opt_read : def)
+		checks |= PROTECT_CHECK_READ;
+	if (opt_data >= 0 ? opt_data : def)
+		checks |= PROTECT_CHECK_DATA;
+
+	if (!checks) {
+		protect_checks = 0;
+		if (protect_map) {
+			free(protect_map);
+			protect_map = NULL;
+		}
+		return;
+	}
+
+	// The checks ride on the per-cycle access classification the machine
+	// composes for the audit map, and only the CoCo 3's memory path builds
+	// it.  Running "protected" on a machine that classifies nothing would
+	// protect nothing, silently, which is the one outcome worse than
+	// refusing to start.
+	if (!xroar.machine_config ||
+	    0 != strcmp(xroar.machine_config->architecture, "coco3")) {
+		protect_fatal("only wired for the CoCo 3 memory path "
+		              "(machine is %s)",
+		              xroar.machine_config
+		              ? xroar.machine_config->architecture : "unset");
+	}
+
+	// No map, no mode.  The map rides in with -symbols (M records, gensym
+	// format 2); a symbol file without them is from the format 1
+	// generator and cannot say what is code.
+	if (!n_code_ranges) {
+		protect_fatal("no code map loaded: pass -symbols FILE where "
+		              "FILE carries M records (gensym format 2; "
+		              "regenerate with tools/gensym.py)");
+	}
+
+	// A floor with no stack check is another way to protect nothing, and
+	// the mistake is invisible from the output: the run just passes.
+	if (protect_stack_floor && !(checks & PROTECT_CHECK_STACK)) {
+		LOG_MOD_WARN("protect", "-protect-stack-floor 0x%05X set but the "
+		             "stack check is not armed; the floor does nothing\n",
+		             protect_stack_floor);
+	}
+
+	if (!protect_map) {
+		protect_map = xzalloc(PROTECT_SPAN);
+		paint(code_ranges, n_code_ranges, PROTECT_CODE);
+		paint(data_ranges, n_data_ranges, PROTECT_DATA);
+		paint(allow_ranges, n_allow_ranges, PROTECT_ALLOW);
+	}
+	protect_checks = checks;
+	// This line is the only evidence an operator has that the flags took
+	// effect, so it states the resolved state and never a raw default: an
+	// unset floor says so rather than printing 0x00000, which reads as a
+	// floor at address zero.
+	char floor_desc[32];
+	if (protect_stack_floor)
+		snprintf(floor_desc, sizeof(floor_desc), "0x%05X", protect_stack_floor);
+	else
+		snprintf(floor_desc, sizeof(floor_desc), "none");
+	LOG_MOD_DEBUG(1, "protect", "armed (checks 0x%x): %zu code ranges, "
+	              "%zu data ranges, %zu allow ranges, stack floor %s, %s\n",
+	              checks, n_code_ranges, n_data_ranges, n_allow_ranges,
+	              floor_desc,
+	              protect_live ? "live" :
+	              (protect_auto ? "dormant until first code fetch"
+	                            : "dormant until -trap-protect-on"));
+}
+
+void protect_defer_arming(void) {
+	protect_auto = 0;
+}
+
+void protect_set_active(_Bool active) {
+	protect_auto = 0;
+	if (!protect_map) {
+		LOG_MOD_WARN("protect", "-trap-protect-%s with no -protect-mode; ignored\n",
+		             active ? "on" : "off");
+		return;
+	}
+	if (protect_live == active)
+		return;
+	protect_live = active;
+	LOG_MOD_DEBUG(1, "protect", "checks %s\n", active ? "live" : "dormant");
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+// The stack check has three ways to fire -- code, initialized data, below the
+// floor -- and "which" is most of the diagnosis, so recover it from the map at
+// fault time rather than widen the verdict.  Cold: once per process, so a
+// static buffer for the floor's number is fine.
+static const char *stack_case(unsigned fault_phys) {
+	static char buf[64];
+	uint8_t cls = (protect_map && fault_phys < PROTECT_SPAN)
+	              ? protect_map[fault_phys] : 0;
+	if (cls & PROTECT_CODE)
+		return "stack hit code (S-relative write)";
+	if (cls & PROTECT_DATA)
+		return "stack hit data (S-relative write into initialized data)";
+	snprintf(buf, sizeof(buf), "stack below floor (0x%05X)", protect_stack_floor);
+	return buf;
+}
+
+static const char *check_name(uint8_t check, unsigned fault_phys) {
+	switch (check) {
+	case PROTECT_CHECK_STACK: return stack_case(fault_phys);
+	case PROTECT_CHECK_WRITE: return "write to code";
+	case PROTECT_CHECK_READ: return "data read from code";
+	case PROTECT_CHECK_DATA: return "execute from non-code";
+	default: return "?";
+	}
+}
+
+void protect_fault(struct MC6809 *cpu, unsigned pc, unsigned phys_pc,
+                   unsigned fault_phys, uint8_t bits, uint8_t check) {
+	const char *where = symfile_whereis(fault_phys, 0);
+	fprintf(stderr, "xroar: protect: %s: phys 0x%05X%s%s%s, value 0x%02X\n",
+	        check_name(check, fault_phys), fault_phys,
+	        where ? " (" : "", where ? where : "", where ? ")" : "",
+	        cpu->D);
+
+	// reg_pc has consumed the instruction's bytes by the time any of its
+	// cycles reach RAM, so it points at (or just short of) the NEXT
+	// instruction; say so rather than let it read as the faulting one.
+	// The flight recorder's last line below is the faulting instruction.
+	const char *pc_where = symfile_whereis(phys_pc, 0);
+	const char *pc_line = symfile_line(phys_pc);
+	fprintf(stderr, "xroar: protect:   pc 0x%04X phys 0x%05X%s%s%s%s%s (past the faulting instruction)\n",
+	        pc, phys_pc,
+	        pc_where ? " (" : "", pc_where ? pc_where : "", pc_where ? ")" : "",
+	        pc_line ? " " : "", pc_line ? pc_line : "");
+
+	fprintf(stderr, "xroar: protect:   cc=%02X a=%02X b=%02X dp=%02X "
+	        "x=%04X y=%04X u=%04X s=%04X irq_depth=%u\n",
+	        cpu->reg_cc, MC6809_REG_A(cpu), MC6809_REG_B(cpu), cpu->reg_dp,
+	        cpu->reg_x, cpu->reg_y, cpu->reg_u, cpu->reg_s, cpu->irq_depth);
+
+	fprintf(stderr, "xroar: protect:   access:%s%s%s%s%s%s%s\n",
+	        (bits & AUDIT_EXEC) ? " exec" : "",
+	        (bits & AUDIT_OPCODE) ? " opcode" : "",
+	        (bits & AUDIT_READ) ? " read" : "",
+	        (bits & AUDIT_WRITE) ? " write" : "",
+	        (bits & AUDIT_STACK_S) ? " stack-s" : "",
+	        (bits & AUDIT_STACK_U) ? " stack-u" : "",
+	        (bits & AUDIT_PUSHPULL) ? " pushpull" : "");
+
+	// The ring, if -trap-history armed one: last N instructions, the
+	// faulting one last.  Backtrace, when built, hangs off the same spot.
+	xroar_trap_history_dump();
+
+	const char *path = dump_path ? dump_path : "protect-crash.ram";
+	if (xroar.machine && xroar.machine->dump_ram) {
+		FILE *fd = fopen(path, "wb");
+		if (!fd) {
+			fprintf(stderr, "xroar: protect:   ram dump: %s: %s\n",
+			        path, strerror(errno));
+		} else {
+			xroar.machine->dump_ram(xroar.machine, fd);
+			long len = ftell(fd);
+			fclose(fd);
+			fprintf(stderr, "xroar: protect:   ram dump: %s (%ld bytes)\n",
+			        path, len);
+		}
+	}
+
+	fprintf(stderr, "xroar: protect: exiting %d\n", PROTECT_EXIT_STATUS);
+	fflush(NULL);
+	// exit(), not abort: xroar_shutdown() is an atexit handler, so the
+	// audit map and any recording mid-write still land on disk.
+	exit(PROTECT_EXIT_STATUS);
+}
+
+void protect_shutdown(void) {
+	free(protect_map);
+	protect_map = NULL;
+	protect_checks = 0;
+	protect_stack_floor = 0;
+	free(code_ranges);
+	code_ranges = NULL;
+	n_code_ranges = code_ranges_alloc = 0;
+	free(data_ranges);
+	data_ranges = NULL;
+	n_data_ranges = data_ranges_alloc = 0;
+	free(allow_ranges);
+	allow_ranges = NULL;
+	n_allow_ranges = allow_ranges_alloc = 0;
+	free(dump_path);
+	dump_path = NULL;
+}
diff --git a/src/protect.h b/src/protect.h
new file mode 100644
index 0000000..e55538c
--- /dev/null
+++ b/src/protect.h
@@ -0,0 +1,204 @@
+/** \file
+ *
+ *  \brief Protected-memory mode: physical code/data policy checks.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ *
+ *  The audit map records what a run DID; this map states what a run MAY do,
+ *  and stops it the moment it does anything else.  One byte per flat physical
+ *  RAM address carries the policy ("this byte is code"), the CPU core's
+ *  per-cycle access class says what the machine is doing to it, and the four
+ *  checks are the products that mean a program has gone wrong:
+ *
+ *    stack   an S-derived write lands somewhere a stack must never be: on
+ *            code, on initialized data, or below -protect-stack-floor
+ *    write   any other write lands on code -- a wild store or buffer overrun
+ *    read    a data read lands on code -- a wild pointer, off-by-one table
+ *            walk, or a return address consumed as data
+ *    data    an instruction fetch lands on anything NOT code -- the PC has
+ *            jumped into data or free RAM
+ *
+ *  A violation is a crash, on purpose: report, RAM dump, exit 70.  The point
+ *  is a failure at the first wrong access, with the machine state that caused
+ *  it, instead of a corrupted screen thirty seconds later.
+ *
+ *  The policy comes from the symbol file's M records ("M C LO HI" for code,
+ *  "M D LO HI" for initialized data; gensym format 2), which classify every
+ *  emitted byte from the assembler LISTING -- an instruction's bytes are
+ *  code, an fcb table's are data, even when that table sits between two
+ *  routines.  Nothing is tagged in source.
+ *
+ *  D means INITIALIZED data and only that.  An `rmb` reservation emits no
+ *  bytes into a listing, so the classifier never sees one and no M D range
+ *  covers it: a program's own stack, buffers and scratch variables all live
+ *  in rmb space and are therefore outside the data class.  That is exactly
+ *  what makes the stack-vs-data check usable -- a stack is *supposed* to sit
+ *  in unclassified RAM, so only a stack that has wandered onto bytes the
+ *  build actually emitted trips it.
+ *
+ *  The one hazard, stated plainly rather than hidden: the stack check keys on
+ *  AUDIT_STACK_S, which is *any* S-derived address, and the 6809 invites
+ *  using S as a fast data pointer -- pshs/puls to move a block, or S-relative
+ *  indexing to walk one.  A program that deliberately pushes into an
+ *  initialized data area, or points S below the floor to reach something,
+ *  WILL fault here, correctly by the rule and wrongly by intent.
+ *  -protect-allow LO-HI is the escape hatch for that region.
+ *
+ *  Checks are DORMANT until the first instruction fetch from a byte the map
+ *  calls code.  The CoCo 3 boot copies BASIC into RAM and runs it from
+ *  physical addresses no user map describes; arming at power-on would fault
+ *  on the ROM's own housekeeping before the program under test ever ran.
+ *  First fetch of mapped code is the moment the program exists.
+ *
+ *  -trap-protect-on scopes that tighter, and doing so takes TWO steps, not
+ *  one: the option arms the checks when its trap fires, and the mere PRESENCE
+ *  of the option turns the automatic arming off (protect_defer_arming(),
+ *  called while the command line is being applied).  Without that second
+ *  step the option could not defer anything at all -- the first fetch of
+ *  mapped code has already armed the checks, usually inside the program's own
+ *  entry, long before any trap fires -- so it only ever re-armed what was
+ *  already live.  -trap-protect-off alone deliberately does NOT defer: that
+ *  combination means "arm as usual, stop checking here", and deferring would
+ *  leave the checks off for the entire run.
+ */
+
+#ifndef XROAR_PROTECT_H_
+#define XROAR_PROTECT_H_
+
+#include <stdint.h>
+
+// The per-cycle access classification is the audit map's legend; one
+// classification, two consumers.
+#include "audit.h"
+
+struct MC6809;
+
+// Same flat physical span as the audit map, for the same reasons.
+#define PROTECT_SPAN AUDIT_SPAN
+
+// Per-byte policy bits.
+#define PROTECT_CODE  (0x01)  // instructions, per the symbol file's M C records
+#define PROTECT_ALLOW (0x02)  // -protect-allow: no check applies here
+#define PROTECT_DATA  (0x04)  // initialized data, per the M D records
+
+// The four checks, as a mask.  Each is also its own verdict value, which is
+// why they are distinct bits rather than an enum.
+#define PROTECT_CHECK_STACK (0x01)  // -protect-mode-stack
+#define PROTECT_CHECK_WRITE (0x02)  // -protect-mode-write
+#define PROTECT_CHECK_READ  (0x04)  // -protect-mode-read
+#define PROTECT_CHECK_DATA  (0x08)  // -protect-mode-data
+
+// Exit status of a protect fault.  Distinct from EXIT_FAILURE so a harness
+// can tell "the program under test violated policy" from "xroar was
+// misconfigured", which exit 1 already means.
+#define PROTECT_EXIT_STATUS (70)
+
+// The live map, or NULL when protect mode is off.  Exposed, like audit_map,
+// so the per-cycle check is an inlined test rather than a call.
+extern uint8_t *protect_map;
+extern uint8_t protect_checks;   // armed PROTECT_CHECK_* mask
+extern _Bool protect_live;       // 0 while dormant (see header comment)
+extern _Bool protect_auto;       // arm on first code fetch; see the header comment
+
+// -protect-stack-floor: the lowest physical address an S-derived write may
+// touch.  0 is "unset" and is also the identity, since nothing is below it,
+// which is why the per-cycle test needs no second variable to consult.
+extern uint32_t protect_stack_floor;
+
+// Classify one RAM cycle against the policy.  bits is the AUDIT_* composition
+// the machine already builds for the audit map.  Returns the PROTECT_CHECK_*
+// that failed, or 0.  Runs on every RAM cycle, so it stays a handful of tests
+// against one map byte.
+//
+// The three write/read rules are deliberately asymmetric:
+//
+//   An S-derived write is the stack check, and faults on code, on initialized
+//   data, or below the floor.  A stack belongs in rmb space, which is in no M
+//   range at all, so all three mean it is somewhere it should not be.
+//
+//   Any other write is the write check, and faults ONLY on code.  Writing to
+//   declared data is what a program does all day -- `sta Scratch` where
+//   `Scratch fcb 0` is ordinary 6809 -- and must never fault.
+//
+//   A read is the read check, and likewise faults only on code.
+inline uint8_t protect_verdict(unsigned phys, uint8_t bits) {
+	if (!protect_map || phys >= PROTECT_SPAN)
+		return 0;
+	uint8_t cls = protect_map[phys];
+	if (!protect_live) {
+		if (protect_auto && (bits & AUDIT_EXEC) && (cls & PROTECT_CODE))
+			protect_live = 1;
+		return 0;
+	}
+	if (cls & PROTECT_ALLOW)
+		return 0;
+	if (bits & AUDIT_EXEC)
+		return (cls & PROTECT_CODE) ? 0 : (protect_checks & PROTECT_CHECK_DATA);
+	if (bits & AUDIT_WRITE) {
+		if (bits & AUDIT_STACK_S)
+			return ((cls & (PROTECT_CODE | PROTECT_DATA)) ||
+			        phys < protect_stack_floor)
+			       ? (protect_checks & PROTECT_CHECK_STACK) : 0;
+		return (cls & PROTECT_CODE)
+		       ? (protect_checks & PROTECT_CHECK_WRITE) : 0;
+	}
+	if (bits & AUDIT_READ)
+		return (cls & PROTECT_CODE)
+		       ? (protect_checks & PROTECT_CHECK_READ) : 0;
+	return 0;
+}
+
+// Command-line state.  The four check flags are tri-state: explicitly given
+// wins over -protect-mode's default from either side of it, the same rule
+// -headless follows for the options it implies.
+void protect_opt_mode(_Bool v);
+void protect_opt_stack(_Bool v);
+void protect_opt_write(_Bool v);
+void protect_opt_read(_Bool v);
+void protect_opt_data(_Bool v);
+void protect_opt_dump(const char *path);
+void protect_opt_stack_floor(uint32_t phys);
+
+// Policy sources.  Code and data ranges arrive from the symbol file's M C and
+// M D records as -symbols parses them; allow ranges from -protect-allow,
+// already resolved to physical numbers by the option layer.  All inclusive.
+void protect_class_range(uint32_t lo, uint32_t hi);
+void protect_data_range(uint32_t lo, uint32_t hi);
+void protect_allow_range(uint32_t lo, uint32_t hi);
+
+// Arm at machine connect.  Fatal if checks are wanted but no code map was
+// loaded, or the machine cannot classify cycles for us: a protect run that
+// silently protects nothing is worse than one that refuses to start.
+void protect_arm(void);
+
+// -trap-protect-on/-off.  Sets protect_live and disables automatic arming,
+// so a trap that turns the checks off stays off.
+void protect_set_active(_Bool active);
+
+// Turn the automatic arming off NOW, at command-line time.  Called when any
+// trap carries -trap-protect-on, which is the only way that option can mean
+// "arm here" rather than "re-arm what the first code fetch already armed".
+void protect_defer_arming(void);
+
+// Report, dump RAM, exit(PROTECT_EXIT_STATUS).  pc/phys_pc describe the
+// instruction in flight (reg_pc points just past its fetched bytes; the
+// flight recorder's last line names it exactly).  value is the byte on the
+// bus for the faulting cycle.
+void protect_fault(struct MC6809 *cpu, unsigned pc, unsigned phys_pc,
+                   unsigned fault_phys, uint8_t bits, uint8_t check)
+	__attribute__((noreturn));
+
+void protect_shutdown(void);
+
+#endif
