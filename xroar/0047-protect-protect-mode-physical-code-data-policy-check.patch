+static void coco3_protect_fault(struct coco3 *mcc3, unsigned phys, uint8_t bits, uint8_t check) {
+	unsigned pc = mcc3->CPU->reg_pc;
+	unsigned phys_pc = tcc1014_logical_to_physical(mcc3->GIME, pc) & 0x7ffff;
+	protect_fault(mcc3->CPU, pc, phys_pc, phys, bits, check);
+}
