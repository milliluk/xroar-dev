+	}
+
+	struct TCC1014 *gime = (struct TCC1014 *)part_component_by_id_is_a(&m->part, "GIME", "TCC1014");
+	struct ram *ram = (struct ram *)part_component_by_id_is_a(&m->part, "RAM", "ram");
+
 	struct gdb_interface_private *gip = xmalloc(sizeof(*gip));
 	*gip = (struct gdb_interface_private){0};
 
 	gip->machine = m;
+	gip->cpu = cpu;
+	gip->gime = gime;
+	gip->ram = ram;
 	gip->run_state = gdb_run_state_running;
 
 	struct addrinfo hints;
@@ -206,7 +287,7 @@ struct gdb_interface *gdb_interface_new(const char *hostname, const char *portna
 	// quick restart with -gdb does not have to wait it out.  This does NOT
