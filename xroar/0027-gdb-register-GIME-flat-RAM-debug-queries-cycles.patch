+	{ int one = 1; setsockopt(gip->listenfd, SOL_SOCKET, SO_REUSEADDR, (void const *)&one, sizeof(one)); }
 
 	// bind
 	gip->rebind_pending = 0;
@@ -327,10 +408,36 @@ static void gdb_handle_signal(struct gdb_interface_private *gip, int sig, bool a
 
 void gdb_stop(struct gdb_interface *gi, int sig) {
 	struct gdb_interface_private *gip = (struct gdb_interface_private *)gi;
+	// Any stop (breakpoint or our own deadline) cancels a pending cycle
+	// stop, so Qxroar.stopin is "until the next stop, whichever comes
+	// first" and never fires spuriously on a later run. Runs on the CPU
+	// thread, the same context that owns the event list while running.
+	if (gip->cycle_stop_armed) {
+		gip->cycle_stop_armed = 0;
+		event_dequeue(&gip->cycle_stop_event);
+	}
 	gip->run_state = gdb_run_state_stopped;
 	gdb_handle_signal(gip, sig, 1);
 }
 
+// 1ms-poll handler for Qxroar.stopin. Mirrors xroar.c's handle_cycle_trigger
+// (patch 18): cycles don't map cleanly to event ticks, so poll every emulated
+// millisecond and compare the live counter. Overshoot is bounded by that 1ms
+// (~1789 cycles at the fast clock), fine for "advance ~a frame then observe"
+// and for click/drag edge spacing. Reaching the target calls gdb_stop (which
+// disarms), so this never requeues past the deadline.
+static void gdb_cycle_stop_poll(void *sptr) {
+	struct gdb_interface_private *gip = sptr;
+	if (!gip->cycle_stop_armed)
+		return;
+	if (xroar_cpu_cycles >= gip->cycle_stop_target) {
+		gdb_stop((struct gdb_interface *)gip, MACHINE_SIGTRAP);
+		return;
+	}
+	gip->cycle_stop_event.at_tick = event_current_tick + EVENT_MS(1);
+	event_queue(&gip->cycle_stop_event);
+}
+
 void gdb_single_step(struct gdb_interface *gi) {
 	struct gdb_interface_private *gip = (struct gdb_interface_private *)gi;
 	gip->run_state = gdb_run_state_stopped;
@@ -881,6 +988,99 @@ static void general_query(struct gdb_interface_private *gip, char *args) {
 		return;
 	}
 	char *query = strsep(&args, ":");
+	if (0 == strncmp(query, "xroar.", 6)) {
+		query += 6;
+#ifdef TRACE
+		if (0 == strcmp(query, "trace-pc")) {
+			LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.trace-pc\n");
+			sprintf((char *)packet, "%04x", mc6809_get_trace_pc(gip->cpu));
+			send_packet(gip, packet, 4);
+			return;
+		}
+#endif
+		// GIME-derived debug registers (coco3 only; gip->gime is NULL on
+		// non-MMU machines, in which case these just report E00 same as
+		// any other unrecognised query -- the run falls through below).
+		if (gip->gime) {
+			uint16_t pc = mc6809_get_pc(gip->cpu);
+			if (0 == strcmp(query, "task")) {
+				// $task: active MMU task mapping, 0 or 1 (live $FF91 TR bit).
+				LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.task\n");
+				sprintf((char *)packet, "%02x", tcc1014_get_task(gip->gime));
+				send_packet(gip, packet, 2);
+				return;
+			}
+			if (0 == strcmp(query, "block")) {
+				// $block: 8KB physical RAM block the MMU currently has
+				// mapped at the live $pc (top 6 bits of $xpc).
+				LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.block\n");
+				unsigned xpc = tcc1014_logical_to_physical(gip->gime, pc);
+				sprintf((char *)packet, "%02x", (xpc >> 13) & 0xff);
+				send_packet(gip, packet, 2);
+				return;
+			}
+			if (0 == strcmp(query, "paddr")) {
+				// $paddr: physical address of the GIME's last memory
+				// cycle (gimep->Z) -- the live bus target, instruction
+				// fetch or data, whichever happened most recently. 19-bit,
+				// 5 hex digits.
+				LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.paddr\n");
+				sprintf((char *)packet, "%05x", gip->gime->Z & 0x7ffff);
+				send_packet(gip, packet, 5);
+				return;
+			}
+			if (0 == strcmp(query, "xpc")) {
+				// $xpc: physical address the live logical $pc is mapped
+				// to right now. Computed fresh from $pc, not a stale bus
+				// snapshot -- always correct regardless of what the last
+				// bus cycle happened to be. 19-bit, 5 hex digits.
+				LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.xpc\n");
+				sprintf((char *)packet, "%05x", tcc1014_logical_to_physical(gip->gime, pc) & 0x7ffff);
+				send_packet(gip, packet, 5);
+				return;
+			}
+			if (0 == strcmp(query, "cycles")) {
+				// $cycles: master emulator tick counter
+				// (event_current_tick), 32-bit, 8 hex digits.
+				// Free-running; take deltas between two reads to
+				// measure elapsed cycles across a code region.
+				LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.cycles\n");
+				sprintf((char *)packet, "%08x", (unsigned)event_current_tick);
+				send_packet(gip, packet, 8);
+				return;
+			}
+		}
+		if (gip->ram && 0 == strcmp(query, "physmem")) {
+			// qxroar.physmem:ADDR,LEN -- read LEN bytes starting at flat
+			// physical ADDR (same addressing as -load-ram's addr=), raw
+			// hex pairs in the reply, same wire shape as a normal 'm'.
+			// Bypasses the CPU/MMU entirely: works on banks that aren't
+			// currently mapped into any logical window.
+			char *addrs = strsep(&args, ",");
+			if (!addrs || !args)
+				goto physmem_read_error;
+			size_t A = strtoul(addrs, NULL, 16);
+			unsigned long length = strtoul(args, NULL, 16);
+			if (length > sizeof(packet)/2)  // reply is hex pairs into packet[]: 2*len+NUL must fit
+				goto physmem_read_error;
+			LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: xroar.physmem\n");
+			char *p = (char *)packet;
+			for (unsigned long i = 0; i < length; i++) {
+				int b = ram_peek_flat(gip->ram, A + i);
+				if (b < 0)
+					goto physmem_read_error;
+				sprintf(p, "%02x", (unsigned)b);
+				p += 2;
+			}
+			send_packet(gip, packet, (size_t)(p - (char *)packet));
+			return;
+		physmem_read_error:
+			send_packet_string(gip, "E00");
+			return;
+		}
+		LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: unknown xroar vendor query\n");
+		send_packet(gip, NULL, 0);
+	} 
 	if (0 == strncmp(query, "Supported", 9) && (query[9] == 0 || query[9] == ':')) {
 		LOG_MOD_DEBUG_GDB(LOG_GDB_QUERY, "gdb", "query: Supported\n");
 		send_supported(gip, args);
@@ -912,6 +1112,148 @@ static void general_query(struct gdb_interface_private *gip, char *args) {
 
 static void general_set(struct gdb_interface_private *gip, char *args) {
 	char *set = strsep(&args, ":");
+	if (0 == strncmp(set, "xroar.", 6)) {
+		set += 6;
+		if (0 == strcmp(set, "physmem") && gip->ram) {
+			// Qxroar.physmem:ADDR,LEN:DATA -- write LEN hex-pair bytes
+			// from DATA starting at flat physical ADDR. Same addressing
+			// and same bypass-the-MMU rationale as the read side.
+			char *arglist = strsep(&args, ":");
+			char *data = args;
+			if (!arglist || !data)
+				goto physmem_write_error;
+			char *addrs = strsep(&arglist, ",");
+			if (!addrs || !arglist)
+				goto physmem_write_error;
+			size_t A = strtoul(addrs, NULL, 16);
+			unsigned long length = strtoul(arglist, NULL, 16);
+			for (unsigned long i = 0; i < length; i++) {
+				if (!*data || !*(data + 1))
+					goto physmem_write_error;
+				int v = hex8(data);
+				if (v < 0)
+					goto physmem_write_error;
+				if (!ram_poke_flat(gip->ram, A + i, (uint8_t)v))
+					goto physmem_write_error;
+				data += 2;
+			}
+			send_packet_string(gip, "OK");
+			return;
+		physmem_write_error:
+			send_packet_string(gip, "E00");
+			return;
+		}
+		if (0 == strcmp(set, "axis")) {
+			// Qxroar.axis:A,V -- set synthetic-joystick axis A (0=X, 1=Y)
+			// to raw value V (hex, 0..ffff, centre 8000). Drives
+			// script_js_set_axis(); the joystick module holds this as
+			// passive state that the CPU reads through joystick_read_axis
+			// on its next poll, so setting it while stopped and then
+			// continuing is how the harness moves the pointer. Only has an
+			// effect when -joy-right script is the active right-port
+			// pointer (same requirement as -input-script).
+			char *as = strsep(&args, ",");
+			if (!as || !args) { send_packet_string(gip, "E00"); return; }
+			unsigned axis = (unsigned)strtoul(as, NULL, 16);
+			int val = (int)strtoul(args, NULL, 16);
+			script_js_set_axis(axis, val);
+			send_packet_string(gip, "OK");
+			return;
+		}
+		if (0 == strcmp(set, "button")) {
+			// Qxroar.button:N,S -- press (S!=0) or release (S=0) synthetic
+			// button N (0 = the right fire button). Drives
+			// script_js_set_button(). A click is button down, continue a
+			// bounded amount of emulated time, button up; the M33ED
+			// double-click detector keys off the emulated-time spacing of
+			// these edges, so advance time by continuing, never by a host
+			// sleep.
+			char *ns = strsep(&args, ",");
+			if (!ns || !args) { send_packet_string(gip, "E00"); return; }
+			unsigned btn = (unsigned)strtoul(ns, NULL, 16);
+			_Bool down = strtoul(args, NULL, 16) != 0;
+			script_js_set_button(btn, down);
+			send_packet_string(gip, "OK");
+			return;
+		}
+		if (0 == strcmp(set, "stopin")) {
+			// Qxroar.stopin:N -- on the next continue, stop after N more
+			// emulated cycles (hex) wherever the PC is, unless a breakpoint
+			// stops it first. This is the harness's clock: set input, arm
+			// stopin, continue, observe -- no dependence on control flow
+			// returning to any particular address. Armed here on the
+			// listener thread while the machine is stopped (so touching the
+			// event list is safe), consumed by the following continue.
+			if (!gip->cycle_stop_event_init) {
+				event_init(&gip->cycle_stop_event, MACHINE_EVENT_LIST,
+				           DELEGATE_AS0(void, gdb_cycle_stop_poll, gip));
+				gip->cycle_stop_event_init = 1;
+			}
+			if (gip->cycle_stop_armed)
+				event_dequeue(&gip->cycle_stop_event);
+			gip->cycle_stop_target = xroar_cpu_cycles + strtoull(args, NULL, 16);
+			gip->cycle_stop_armed = 1;
+			gip->cycle_stop_event.at_tick = event_current_tick + EVENT_MS(1);
+			event_queue(&gip->cycle_stop_event);
+			send_packet_string(gip, "OK");
+			return;
+		}
+		if (0 == strcmp(set, "key")) {
+			// Qxroar.key:SCAN,S -- press (S!=0) / release (S=0) a raw
+			// keyboard-matrix key by DSCAN scancode (0x00..0x38; e.g.
+			// ENTER=0x30 CLEAR=0x31 BREAK=0x32 ALT=0x33 CTRL=0x34
+			// SHIFT=0x37 BACKSPACE=0x38, A=0x11..). This is the PIA-matrix
+			// path: the scancode maps through the live keymap to a col/row
+			// the CPU reads at $FF00, so GetModifierKeys and every direct
+			// matrix reader see it, unlike the auto_kbd ROM-poll `type`.
+			// Held until the matching release.
+			char *ks = strsep(&args, ",");
+			if (!ks || !args || !xroar.keyboard_interface) { send_packet_string(gip, "E00"); return; }
+			unsigned scan = (unsigned)strtoul(ks, NULL, 16);
+			if (scan >= DSCAN_INVALID) { send_packet_string(gip, "E00"); return; }
+			if (strtoul(args, NULL, 16))
+				KBD_MATRIX_PRESS(xroar.keyboard_interface, scan);
+			else
+				KBD_MATRIX_RELEASE(xroar.keyboard_interface, scan);
+			send_packet_string(gip, "OK");
+			return;
+		}
+		if (0 == strcmp(set, "type")) {
+			// Qxroar.type:HEX -- queue text to the ROM key-poll auto-typer
+			// (auto_kbd), the same path the -input-script `type` uses. Text
+			// is hex-encoded (2 digits/char) so spaces and specials survive
+			// the packet; \r (0d) is ENTER. Convenience over Qxroar.key for
+			// literal strings; use key= when you need matrix-level control.
+			if (!args || !xroar.auto_kbd) { send_packet_string(gip, "E00"); return; }
+			size_t hexlen = strlen(args);
+			if (hexlen & 1) { send_packet_string(gip, "E00"); return; }
+			char *txt = xmalloc(hexlen/2 + 1);
+			for (size_t i = 0; i < hexlen/2; i++) {
+				int v = hex8(args + 2*i);
+				if (v < 0) { free(txt); send_packet_string(gip, "E00"); return; }
+				txt[i] = (char)v;
+			}
+			txt[hexlen/2] = 0;
+			ak_parse_type_string(xroar.auto_kbd, txt);
+			free(txt);
+			send_packet_string(gip, "OK");
+			return;
+		}
+#ifdef SCREENSHOT
+		if (0 == strcmp(set, "screenshot")) {
+			// Qxroar.screenshot:FILE -- render the current frame to PNG, the
+			// same writer -trap-screenshot uses. Capture may defer to the next
+			// vsync (screenshot.c), so the harness should run a couple of frames
+			// after this for it to flush.
+			if (!args || !*args) { send_packet_string(gip, "E00"); return; }
+			if (!xroar.vo_interface || !xroar.vo_interface->renderer)
+				screenshot_setup_render(xroar.vo_interface);
+			screenshot_request(args, xroar.vo_interface);
+			send_packet_string(gip, "OK");
+			return;
+		}
+#endif
+	} 
 	if (0 == strcmp(set, "StartNoAckMode")) {
 		gip->no_ack_mode = 1;
 		send_packet_string(gip, "OK");
@@ -1052,29 +1394,6 @@ static int qRcmd(struct gdb_interface_private *gip, char *args) {
 	return 0;
 }
 
