 	int last_signal;
+
+	// gdb-driven cycle-bounded stop (Qxroar.stopin:N). A 1ms-poll event on
+	// MACHINE_EVENT_LIST checks xroar_cpu_cycles against a target and calls
+	// gdb_stop() when reached -- the same stop path a hardware breakpoint
+	// uses. Lets the harness "run N cycles then stop wherever the PC is",
+	// which a fixed-address breakpoint can't do once injected input diverts
+	// control flow off the idle loop.
+	struct event cycle_stop_event;
+	uint64_t cycle_stop_target;
+	_Bool cycle_stop_armed;
+	_Bool cycle_stop_event_init;
 };
 
