diff --git a/src/joystick_rat.c b/src/joystick_rat.c
new file mode 100644
index 0000000..0727fb2
--- /dev/null
+++ b/src/joystick_rat.c
@@ -0,0 +1,156 @@
+/** \file
+ *
+ *  \brief Diecom RAT quadrature mouse on a joystick port.
+ *
+ *  \copyright Public domain. Part of the xroar-dev fork.
+ *
+ *  WHY THIS IS A FILTER AND NOT A JOYSTICK MODULE
+ *
+ *  A joystick module supplies a position.  The RAT does not have one: it is a
+ *  pair of quadrature wheels, and what reaches the CoCo is a pot whose
+ *  resistance snaps between four discrete levels as the wheel turns.  Motion
+ *  is in the *sequence* of levels, not in any single reading, and the guest
+ *  integrates it into a cursor position the emulator never sees.
+ *
+ *  So this sits between an ordinary source and the port: the source still says
+ *  where the host pointer is, and the filter converts the difference between
+ *  that and the position it has already handed over into wheel detents, one at
+ *  a time.  Anything that can drive a port drives a RAT -- `-joy-right script`
+ *  from an input script, the mouse under a GUI build, a real stick -- and none
+ *  of them needed to know.
+ *
+ *  THE FOUR LEVELS
+ *
+ *  MAME's trs/coco.cpp carries them as joy_rat_table[] = { 15, 24, 42, 33 },
+ *  six-bit DAC codes in phase order.  They are deliberately not monotonic:
+ *  ordered by resistance the phases run 0, 1, 3, 2, so consecutive phases are
+ *  neighbours in the guest's bucketed reading and a change of one bucket
+ *  decodes to a direction.  Two levels apart is 180 degrees and has no
+ *  direction, which is why the step rate below matters.
+ *
+ *  A guest buckets a reading with a three-step threshold compare against the
+ *  same DAC the sound chip uses, so a level is presented here as the axis
+ *  value the comparator in the machine's joystick_update() maps back to that
+ *  DAC code -- RAT_AXIS_VALUE below is joystick_dac_target_value()'s formula
+ *  read backwards.  Nothing in this file knows what thresholds a particular
+ *  guest picks; it only has to land in the right bucket, and the four codes
+ *  are one per bucket by construction.
+ *
+ *  THE STEP RATE IS THE ONE THING THAT CAN BE WRONG
+ *
+ *  A quadrature decoder must see every transition, and what a guest does with
+ *  a skipped one was measured against Color Max Deluxe's decoder rather than
+ *  assumed.  Two detents between samples while it is ALREADY MOVING decodes
+ *  correctly, as two pixels in the direction it had; two detents from rest
+ *  decodes as no motion at all, and leaves the decoder's phase where it
+ *  started, so a wheel that only ever steps two at a time is invisible.
+ *  Three decodes as a reversal.  So the ceiling here has to sit below the
+ *  rate the guest samples at, and it is an option because only the guest
+ *  knows that rate.  The default is 150Hz, which is under both the ~157Hz the
+ *  original RAT2.BIN driver used and the 180.5Hz GIME timer Color Max Deluxe
+ *  samples on.  At one pixel per detent that is a 320-pixel screen crossed in
+ *  about two seconds, which is what the device really costs.
+ *
+ *  The rate limit is evaluated lazily, in the read, rather than from an event:
+ *  a port is read far more often than it is sampled (every $FF00 read runs the
+ *  comparator, and the keyboard scan does that constantly), so a step counter
+ *  driven by reads would be driven by the keyboard.  Emulated time is the only
+ *  honest clock here.  A level CAN therefore change in the middle of a guest's
+ *  threshold compare; that is safe, because the compare buckets monotonically
+ *  and a one-detent move lands it in one of the two adjacent buckets, both of
+ *  which are legal transitions.  It is also what real hardware does.
+ *
+ *  ABSOLUTE POSITION DOES NOT SURVIVE THE TRIP, and a script driving one of
+ *  these should not assume it does.  The guest's own decode table hands out
+ *  one or two pixels per detent depending on the phase it is in, and eats a
+ *  detent whenever the direction reverses.  Drive to a hard stop first if you
+ *  need a known origin, and peek the guest's cursor rather than computing it.
+ *
+ *  BUTTONS need nothing here.  The RAT has two; a port already carries two
+ *  (joystick_read_buttons() places both, and the CoCo 3 wires all four to PIA0
+ *  PA0-PA3), so `down 0` / `down 1` in an input script are the RAT's left and
+ *  right buttons already.  What a *guest* does with the second one is the
+ *  guest's business.
+ */
+
+#include "top-config.h"
+
+#include <stdint.h>
+
+#include "events.h"
+#include "joystick_rat.h"
+#include "xconfig.h"
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+// Configuration.  Written by the option parser before any of this runs.
+
+int joystick_rat_port = RAT_PORT_NONE;
+
+// 65536 axis units span the pot's whole travel, and a guest that moves one
+// pixel per detent wants one detent per pixel of a 320-pixel screen.
+int joystick_rat_scale = 205;
+
+int joystick_rat_rate = 150;
+
+struct xconfig_enum joystick_rat_port_list[] = {
+	{ XC_ENUM_INT("none", RAT_PORT_NONE, "No RAT attached") },
+	{ XC_ENUM_INT("right", 0, "Diecom RAT on the right port") },
+	{ XC_ENUM_INT("left", 1, "Diecom RAT on the left port") },
+	{ XC_ENUM_END() }
+};
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+// Six-bit DAC codes in phase order, MAME's joy_rat_table[].
+static const unsigned rat_dac_code[4] = { 15, 24, 42, 33 };
+
+// A six-bit code as the axis value whose comparison against the DAC picks it
+// out: the machine builds its threshold as ((PIA1 A & 0xfc) | 2) << 8, and the
+// six bits sit in 7..2, so a code v is centred at ((v << 2) | 2) << 8.
+#define RAT_AXIS_VALUE(v) ((int)((((unsigned)(v) << 2) | 2u) << 8))
+
+static struct {
+	int phase;             // 0..3, index into rat_dac_code[]
+	int detent;            // source position already handed over, in detents
+	_Bool primed;          // detent is meaningful
+	event_ticks next_step;  // earliest emulated time the wheel may turn again
+} rat_axis_state[2];
+
+int joystick_rat_axis(int axis, int value) {
+	if (axis < 0 || axis > 1)
+		return value;
+	if (joystick_rat_scale < 1)
+		joystick_rat_scale = 1;
+
+	int target = value / joystick_rat_scale;
+
+	// The first reading is where the wheel already is, not somewhere to
+	// move to: without this every run would open by winding the pot from
+	// zero to wherever the source happens to be pointing.
+	if (!rat_axis_state[axis].primed) {
+		rat_axis_state[axis].primed = 1;
+		rat_axis_state[axis].detent = target;
+		rat_axis_state[axis].next_step = event_current_tick;
+	}
+
+	if (rat_axis_state[axis].detent != target &&
+	    event_tick_delta(event_current_tick, rat_axis_state[axis].next_step) >= 0) {
+		// One detent.  Phase up is the direction the guest reads as
+		// increasing, because its decode is (old code - new code) & 3.
+		if (target > rat_axis_state[axis].detent) {
+			rat_axis_state[axis].detent++;
+			rat_axis_state[axis].phase = (rat_axis_state[axis].phase + 1) & 3;
+		} else {
+			rat_axis_state[axis].detent--;
+			rat_axis_state[axis].phase = (rat_axis_state[axis].phase + 3) & 3;
+		}
+		int rate = joystick_rat_rate > 0 ? joystick_rat_rate : 1;
+		// From now, not from the deadline: a port that goes unread for a
+		// while must not bank up steps and then spend them in one burst,
+		// which is precisely the skipped-transition case above.
+		rat_axis_state[axis].next_step = event_current_tick +
+			(event_ticks)(EVENT_TICK_RATE / (uintmax_t)rate);
+	}
+
+	return RAT_AXIS_VALUE(rat_dac_code[rat_axis_state[axis].phase]);
+}
diff --git a/src/joystick_rat.h b/src/joystick_rat.h
new file mode 100644
index 0000000..f68cd7e
--- /dev/null
+++ b/src/joystick_rat.h
@@ -0,0 +1,37 @@
+/** \file
+ *
+ *  \brief Diecom RAT quadrature mouse on a joystick port.
+ *
+ *  A filter over one port's axis readings, not a joystick module: it takes
+ *  whatever source is already mapped to that port (script, mouse, physical)
+ *  and re-presents its position as a quadrature wheel, so the guest sees the
+ *  four-level pot a RAT presents instead of a continuous one.
+ *
+ *  \copyright Public domain. Part of the xroar-dev fork.
+ */
+
+#ifndef XROAR_JOYSTICK_RAT_H_
+#define XROAR_JOYSTICK_RAT_H_
+
+#include "xconfig.h"
+
+// Port the RAT is attached to: RAT_PORT_NONE, or 0 (right) / 1 (left).  Set
+// directly by the -rat-mouse option.
+#define RAT_PORT_NONE (-1)
+extern int joystick_rat_port;
+
+// Source axis units (0..65535) per wheel detent.  -rat-scale.
+extern int joystick_rat_scale;
+
+// Ceiling on detent steps per second of emulated time.  -rat-rate.  MUST stay
+// below the rate the guest samples the port at; see joystick_rat.c.
+extern int joystick_rat_rate;
+
+// For -rat-mouse's XC_SET_ENUM.
+extern struct xconfig_enum joystick_rat_port_list[];
+
+// Called from joystick_read_axis() for the attached port only.  value is the
+// underlying source's reading; the return is the pot level to present.
+int joystick_rat_axis(int axis, int value);
+
+#endif
