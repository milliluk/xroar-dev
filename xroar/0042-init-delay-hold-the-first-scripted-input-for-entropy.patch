@@ -229,6 +236,18 @@ static void do_auto_event(void *sptr, bool RnW, uint32_t A) {
 	debug_set_register(ak->machine->debug.target, ak->regno_a, 0);
 	DELEGATE_CALL(ak->machine->debug.cpu.set_flag, debug_cpu_flag_zero, 1);
 
+	// Hold the first character. Returning here leaves the "no key pressed"
+	// state above in place and rts's back into the ROM's poll loop, which is
+	// exactly what a real keyboard looks like when nobody has typed yet --
+	// no event is cancelled and nothing else is rescheduled.
+	// One shared deadline (xroar.c): an -input-script run and an auto-typed
+	// one must not each start their own clock, or the delay means something
+	// different depending on how the machine is being driven.
+	if (event_tick_delta(event_current_tick, xroar_init_delay_deadline()) < 0) {
+		ak->machine->op_rts(ak->machine);
