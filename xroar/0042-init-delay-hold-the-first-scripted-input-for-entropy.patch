diff --git a/src/audiorec.c b/src/audiorec.c
new file mode 100644
index 0000000..95261aa
--- /dev/null
+++ b/src/audiorec.c
@@ -0,0 +1,215 @@
+/** \file
+ *
+ *  \brief Debug audio capture for the headless rig.
+ *
+ *  \copyright Public domain, part of the xroar-dev headless test harness.
+ *
+ *  See audiorec.h for what mix / dac / 1bit mean. WAV output goes through the
+ *  bundled sndfile_compat writer (no libsndfile needed); raw output is written
+ *  directly with no header. All capture is mono at the sound output rate.
+ */
+
+#include "top-config.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "audiorec.h"
+#include "logging.h"
+#include "sndfile_compat.h"
+
+// Staging buffer: floats accumulated per frame, flushed when full.
+#define AR_BUF_FRAMES (4096)
+
+int audiorec_active = 0;
+
+static struct {
+	int armed;
+	char *whole_run_path;              // -audio-record FILE, or NULL
+	enum audiorec_source source;
+	enum audiorec_fmt fmt;
+
+	// Open-file state.
+	int open;                          // file is open (may be paused)
+	SNDFILE *sf;                       // WAV path
+	FILE *raw;                         // raw path
+	int is_raw;
+	float buf[AR_BUF_FRAMES];
+	int nbuf;                          // frames staged
+} ar = {
+	.source = AUDIOREC_SRC_MIX,
+	.fmt = AUDIOREC_FMT_S16,
+};
+
+// --- option setters ----------------------------------------------------------
+
+void audiorec_arm(void) {
+	ar.armed = 1;
+}
+
+int audiorec_armed(void) {
+	return ar.armed;
+}
+
+int audiorec_set_whole_run_file(const char *path) {
+	free(ar.whole_run_path);
+	ar.whole_run_path = path ? strdup(path) : NULL;
+	ar.armed = 1;
+	return 0;
+}
+
+int audiorec_set_source(const char *name) {
+	if (!name) return -1;
+	if (!strcmp(name, "mix"))       ar.source = AUDIOREC_SRC_MIX;
+	else if (!strcmp(name, "dac"))  ar.source = AUDIOREC_SRC_DAC;
+	else if (!strcmp(name, "1bit")) ar.source = AUDIOREC_SRC_1BIT;
+	else {
+		LOG_MOD_ERROR("audiorec", "unknown source '%s' (want mix|dac|1bit)\n", name);
+		return -1;
+	}
+	ar.armed = 1;
+	return 0;
+}
+
+int audiorec_set_format(const char *name) {
+	if (!name) return -1;
+	if (!strcmp(name, "s16"))        ar.fmt = AUDIOREC_FMT_S16;
+	else if (!strcmp(name, "float")) ar.fmt = AUDIOREC_FMT_FLOAT;
+	else {
+		LOG_MOD_ERROR("audiorec", "unknown format '%s' (want s16|float)\n", name);
+		return -1;
+	}
+	ar.armed = 1;
+	return 0;
+}
+
+// --- helpers -----------------------------------------------------------------
+
+// Decide wav vs raw from the file extension. .raw/.pcm/.bin -> raw, anything
+// else -> wav. This is the only selector: name the file for what you want.
+static int resolve_is_raw(const char *path) {
+	const char *dot = strrchr(path, '.');
+	if (dot) {
+		if (!strcmp(dot, ".raw") || !strcmp(dot, ".pcm") || !strcmp(dot, ".bin"))
+			return 1;
+	}
+	return 0;
+}
+
+static void flush_buf(void) {
+	if (ar.nbuf <= 0) return;
+	if (ar.is_raw) {
+		if (ar.fmt == AUDIOREC_FMT_FLOAT) {
+			fwrite(ar.buf, sizeof(float), ar.nbuf, ar.raw);
+		} else {
+			int16_t out[AR_BUF_FRAMES];
+			for (int i = 0; i < ar.nbuf; i++) {
+				float v = ar.buf[i];
+				if (v > 1.0f) v = 1.0f;
+				if (v < -1.0f) v = -1.0f;
+				out[i] = (int16_t)(v * 32767.0f);
+			}
+			fwrite(out, sizeof(int16_t), ar.nbuf, ar.raw);
+		}
+	} else {
+		sf_writef_float(ar.sf, ar.buf, ar.nbuf);
+	}
+	ar.nbuf = 0;
+}
+
+// --- open / close ------------------------------------------------------------
+
+int audiorec_start(const char *path, int rate) {
+	if (!path) return -1;
+	if (ar.open) audiorec_stop();   // close any previous clip
+
+	ar.is_raw = resolve_is_raw(path);
+	ar.nbuf = 0;
+
+	if (ar.is_raw) {
+		ar.raw = fopen(path, "wb");
+		if (!ar.raw) {
+			LOG_MOD_ERROR("audiorec", "cannot open '%s' for raw write\n", path);
+			return -1;
+		}
+	} else {
+		SF_INFO info;
+		memset(&info, 0, sizeof(info));
+		info.samplerate = rate;
+		info.channels = 1;
+		info.format = SF_FORMAT_WAV |
+		    (ar.fmt == AUDIOREC_FMT_FLOAT ? SF_FORMAT_FLOAT : SF_FORMAT_PCM_16);
+		ar.sf = sf_open(path, SFM_WRITE, &info);
+		if (!ar.sf) {
+			LOG_MOD_ERROR("audiorec", "cannot open '%s' for wav write\n", path);
+			return -1;
+		}
+	}
+
+	ar.open = 1;
+	audiorec_active = 1;
+	LOG_MOD_DEBUG(1, "audiorec", "recording %s %s -> %s @ %dHz\n",
+	    ar.source == AUDIOREC_SRC_DAC ? "dac" :
+	    ar.source == AUDIOREC_SRC_1BIT ? "1bit" : "mix",
+	    ar.is_raw ? (ar.fmt == AUDIOREC_FMT_FLOAT ? "raw/float" : "raw/s16")
+	              : (ar.fmt == AUDIOREC_FMT_FLOAT ? "wav/float" : "wav/s16"),
+	    path, rate);
+	return 0;
+}
+
+int audiorec_start_whole_run(int rate) {
+	if (!ar.whole_run_path) return 0;
+	return audiorec_start(ar.whole_run_path, rate);
+}
+
+void audiorec_stop(void) {
+	if (!ar.open) return;
+	audiorec_active = 0;   // stop the tap before we tear the file down
+	flush_buf();
+	if (ar.is_raw) {
+		if (ar.raw) { fclose(ar.raw); ar.raw = NULL; }
+	} else {
+		if (ar.sf) { sf_close(ar.sf); ar.sf = NULL; }
+	}
+	ar.open = 0;
+	LOG_MOD_DEBUG(1, "audiorec", "recording stopped\n");
+}
+
+// Pause or resume without closing the file. This is how you splice several
+// disjoint windows into one clip: start once, toggle off at the end of a
+// window, toggle on at the start of the next. The paused samples are dropped,
+// not silenced, so the output concatenates the recorded windows with no gap.
+// A no-op if nothing is open, since there is no file to write to.
+void audiorec_toggle(void) {
+	if (!ar.open) {
+		LOG_MOD_DEBUG(1, "audiorec", "toggle ignored: nothing recording\n");
+		return;
+	}
+	audiorec_active = !audiorec_active;
+	LOG_MOD_DEBUG(1, "audiorec", "recording %s\n",
+	    audiorec_active ? "resumed" : "paused");
+}
+
+// --- per-frame tap -----------------------------------------------------------
+
+void audiorec_frame(float mix, float dac, int sbs_en, int sbs_lvl) {
+	if (!audiorec_active) return;
+	float v;
+	switch (ar.source) {
+	case AUDIOREC_SRC_DAC:
+		v = dac;
+		break;
+	case AUDIOREC_SRC_1BIT:
+		v = sbs_en ? (sbs_lvl ? 0.5f : -0.5f) : 0.0f;
+		break;
+	case AUDIOREC_SRC_MIX:
+	default:
+		v = mix;
+		break;
+	}
+	ar.buf[ar.nbuf++] = v;
+	if (ar.nbuf >= AR_BUF_FRAMES)
+		flush_buf();
+}
diff --git a/src/audiorec.h b/src/audiorec.h
new file mode 100644
index 0000000..cb52a0e
--- /dev/null
+++ b/src/audiorec.h
@@ -0,0 +1,67 @@
+/** \file
+ *
+ *  \brief Debug audio capture for the headless rig.
+ *
+ *  \copyright Public domain, part of the xroar-dev headless test harness.
+ *
+ *  Records one of three signals to a WAV or raw file, mono, at the sound
+ *  interface's output rate:
+ *
+ *    mix   the final speaker output (post gain and external mix)
+ *    dac   the 6-bit DAC voltage the CPU is driving, normalised 0..1
+ *    1bit  the single-bit sound output as a centred square wave
+ *
+ *  dac and 1bit capture the LOGICAL signal each source drives, not its scaled
+ *  analog share of the summing bus. The single-bit source is a bias on the
+ *  bus in this mixer, not an independent waveform, so there is nothing to tee
+ *  for its analog contribution. What you get instead is the debuggable signal:
+ *  what the sound code put on the DAC, and when it toggled the 1-bit output.
+ */
+
+#ifndef XROAR_AUDIOREC_H_
+#define XROAR_AUDIOREC_H_
+
+enum audiorec_source {
+	AUDIOREC_SRC_MIX = 0,   // final speaker output (default)
+	AUDIOREC_SRC_DAC,       // 6-bit DAC level, 0..1
+	AUDIOREC_SRC_1BIT,      // single-bit sound as a square wave
+};
+
+enum audiorec_fmt {
+	AUDIOREC_FMT_S16 = 0,   // 16-bit signed (default)
+	AUDIOREC_FMT_FLOAT,     // 32-bit float
+};
+
+// Command-line option setters. Each returns 0 on success, -1 on a bad value.
+// Any of these arms capture, so ao_null knows to request a real sample format.
+int audiorec_set_whole_run_file(const char *path);   // -audio-record FILE
+int audiorec_set_source(const char *name);           // -audio-record-source
+int audiorec_set_format(const char *name);           // -audio-record-format
+void audiorec_arm(void);                             // arm without a whole-run file
+
+// True if any capture option was given. Read by ao_null before it picks a
+// format: an armed recorder needs the mix path to actually render samples.
+int audiorec_armed(void);
+
+// Fast gate for the per-frame tap in sound.c: nonzero while a file is open.
+extern int audiorec_active;
+
+// Whole-run: open the -audio-record file if one was set. rate is the sound
+// interface output rate. No-op (returns 0) if no whole-run file was given.
+int audiorec_start_whole_run(int rate);
+
+// Trap-driven start/stop. start opens path; stop flushes and closes.
+int audiorec_start(const char *path, int rate);
+void audiorec_stop(void);
+
+// Pause/resume the open file without closing it. Lets several disjoint
+// windows land in one clip (start once, then toggle off/on around gaps).
+void audiorec_toggle(void);
+
+// Per output frame, called from sound.c's mix loop. Selects the configured
+// source and buffers one sample. Cheap: does nothing unless audiorec_active.
+// mix is the channel-0 speaker sample; dac is the current DAC level (0..1);
+// sbs_en / sbs_lvl are the single-bit enable and level.
+void audiorec_frame(float mix, float dac, int sbs_en, int sbs_lvl);
+
+#endif
diff --git a/src/audit.c b/src/audit.c
new file mode 100644
index 0000000..d486373
--- /dev/null
+++ b/src/audit.c
@@ -0,0 +1,270 @@
+/** \file
+ *
+ *  \brief Physical-address access audit map.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ */
+
+#include "top-config.h"
+
+// For strsep()
+#define _DEFAULT_SOURCE
+#define _BSD_SOURCE
+#define _DARWIN_C_SOURCE
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pl-string.h"
+#include "xalloc.h"
+
+#include "audit.h"
+#include "logging.h"
+
+uint8_t *audit_map = NULL;
+extern inline void audit_mark(unsigned phys, uint8_t bits);
+
+// The allocation, which outlives any pause.  audit_map is this pointer while
+// recording and NULL while not, so the per-cycle hook is one test.
+static uint8_t *audit_base = NULL;
+static char *audit_path = NULL;
+static char audit_build[40] = { 0 };
+static uint32_t audit_runs = 0;
+static _Bool audit_on = 0;
+
+static const char audit_magic[8] = { 'X','R','A','U','D','I','T','\0' };
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+static void audit_fatal(const char *what, const char *path) {
+	fprintf(stderr, "xroar: -audit %s: %s: %s\n", what, path, strerror(errno));
+	exit(EXIT_FAILURE);
+}
+
+// Read a map file and OR it into the live map.  Used by seed=.  A file whose
+// legend version differs is refused rather than merged: the bits would mean
+// different things in the two halves of the result, and nothing downstream
+// could tell which byte came from where.
+static void audit_seed(const char *path) {
+	FILE *f = fopen(path, "rb");
+	if (!f) {
+		audit_fatal("seed", path);
+	}
+	uint8_t hdr[AUDIT_HEADER_BYTES];
+	if (fread(hdr, 1, sizeof(hdr), f) != sizeof(hdr)) {
+		fprintf(stderr, "xroar: -audit seed: %s: short header\n", path);
+		exit(EXIT_FAILURE);
+	}
+	if (memcmp(hdr, audit_magic, sizeof(audit_magic)) != 0) {
+		fprintf(stderr, "xroar: -audit seed: %s: not an audit map\n", path);
+		exit(EXIT_FAILURE);
+	}
+	uint32_t fmt    = hdr[8]  | (hdr[9] << 8)  | (hdr[10] << 16) | ((uint32_t)hdr[11] << 24);
+	uint32_t legend = hdr[12] | (hdr[13] << 8) | (hdr[14] << 16) | ((uint32_t)hdr[15] << 24);
+	uint32_t span   = hdr[16] | (hdr[17] << 8) | (hdr[18] << 16) | ((uint32_t)hdr[19] << 24);
+	uint32_t runs   = hdr[20] | (hdr[21] << 8) | (hdr[22] << 16) | ((uint32_t)hdr[23] << 24);
+	if (fmt != AUDIT_FORMAT_VERSION || legend != AUDIT_LEGEND_VERSION) {
+		fprintf(stderr, "xroar: -audit seed: %s: format %u legend %u, "
+		        "this build writes format %u legend %u\n",
+		        path, fmt, legend, AUDIT_FORMAT_VERSION, AUDIT_LEGEND_VERSION);
+		exit(EXIT_FAILURE);
+	}
+	if (span != AUDIT_SPAN) {
+		fprintf(stderr, "xroar: -audit seed: %s: span 0x%x, this build uses 0x%x\n",
+		        path, span, AUDIT_SPAN);
+		exit(EXIT_FAILURE);
+	}
+	// The build id is carried forward but not enforced here: only the tool
+	// reading the finished map knows which build it means to report against.
+	// Warn on a mismatch so a cross-build union is at least visible.
+	hdr[63] = 0;
+	if (audit_build[0] && ((char *)hdr)[24] && 0 != strcmp((char *)hdr + 24, audit_build)) {
+		LOG_MOD_WARN("audit", "seed %s was built as '%s', this run is '%s'; "
+		             "unioning maps across builds\n", path, (char *)hdr + 24, audit_build);
+	} else if (!audit_build[0]) {
+		memcpy(audit_build, (char *)hdr + 24, sizeof(audit_build) - 1);
+	}
+	audit_runs = runs;
+
+	// OR in a chunk at a time; the map is larger than any sane stack frame.
+	uint8_t buf[65536];
+	unsigned off = 0;
+	size_t n;
+	while (off < AUDIT_SPAN && (n = fread(buf, 1, sizeof(buf), f)) > 0) {
+		if (n > AUDIT_SPAN - off)
+			n = AUDIT_SPAN - off;
+		for (size_t i = 0; i < n; i++)
+			audit_base[off + i] |= buf[i];
+		off += n;
+	}
+	fclose(f);
+	if (off != AUDIT_SPAN) {
+		fprintf(stderr, "xroar: -audit seed: %s: short map (%u of %u bytes)\n",
+		        path, off, (unsigned)AUDIT_SPAN);
+		exit(EXIT_FAILURE);
+	}
+	LOG_MOD_DEBUG(1, "audit", "seeded from %s (%u prior run%s)\n",
+	              path, runs, runs == 1 ? "" : "s");
+}
+
+// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+
+void audit_config(const char *spec) {
+	if (audit_base) {
+		fprintf(stderr, "xroar: -audit given more than once\n");
+		exit(EXIT_FAILURE);
+	}
+	char *copy = xstrdup(spec);
+	char *rest = copy;
+	char *file = strsep(&rest, ",");
+	if (!file || !*file) {
+		fprintf(stderr, "xroar: -audit: no filename\n");
+		exit(EXIT_FAILURE);
+	}
+
+	const char *seed = NULL;
+	const char *build = NULL;
+	_Bool start = 1;
+	_Bool reset = 0;
+	while (rest && *rest) {
+		char *opt = strsep(&rest, ",");
+		if (!opt || !*opt)
+			continue;
+		char *val = strchr(opt, '=');
+		if (val)
+			*(val++) = 0;
+		if (0 == strcmp(opt, "seed") && val) {
+			seed = val;
+		} else if (0 == strcmp(opt, "build") && val) {
+			// Which build this map describes.  Recorded in the header so a
+			// reader can refuse to report a map against source it does not
+			// match, and so seeding across builds warns instead of quietly
+			// unioning addresses that mean different things.  The harness
+			// feeds it the assembler .sym file's !build line.
+			build = val;
+		} else if (0 == strcmp(opt, "start") && val) {
+			if (0 == strcmp(val, "on")) {
+				start = 1;
+			} else if (0 == strcmp(val, "off")) {
+				start = 0;
+			} else {
+				fprintf(stderr, "xroar: -audit start=%s: want on or off\n", val);
+				exit(EXIT_FAILURE);
+			}
+		} else if (0 == strcmp(opt, "reset")) {
+			reset = 1;
+		} else {
+			fprintf(stderr, "xroar: -audit: unknown option '%s'\n", opt);
+			exit(EXIT_FAILURE);
+		}
+	}
+
+	audit_base = xzalloc(AUDIT_SPAN);
+	audit_path = xstrdup(file);
+	// Set before seeding: audit_seed() compares against it, and adopts the
+	// seed's id only when this run has none to state.
+	if (build)
+		audit_set_build_id(build);
+
+	// seed= names the map to start from.  Naming the output file there too
+	// is the accumulate-in-place idiom, and is why seeding reads before the
+	// output is ever opened.  reset= wins over seed=, which is only useful
+	// for "same command line, fresh map this time".
+	if (seed && !reset)
+		audit_seed(seed);
+
+	audit_on = start;
+	audit_map = audit_on ? audit_base : NULL;
+	LOG_MOD_DEBUG(1, "audit", "map armed, recording %s, output %s\n",
+	              audit_on ? "on" : "off", audit_path);
+	free(copy);
+}
+
+_Bool audit_configured(void) {
+	return audit_base != NULL;
+}
+
+void audit_set_active(_Bool active) {
+	if (!audit_base) {
+		LOG_MOD_WARN("audit", "-trap-audit with no -audit; ignored\n");
+		return;
+	}
+	if (audit_on == active)
+		return;
+	audit_on = active;
+	audit_map = audit_on ? audit_base : NULL;
+	LOG_MOD_DEBUG(1, "audit", "recording %s\n", audit_on ? "on" : "off");
+}
+
+void audit_clear(void) {
+	if (!audit_base)
+		return;
+	memset(audit_base, 0, AUDIT_SPAN);
+	audit_runs = 0;
+	LOG_MOD_DEBUG(1, "audit", "map cleared\n");
+}
+
+void audit_set_build_id(const char *id) {
+	if (!id)
+		return;
+	strncpy(audit_build, id, sizeof(audit_build) - 1);
+	audit_build[sizeof(audit_build) - 1] = 0;
+}
+
+void audit_write(const char *path) {
+	if (!audit_base) {
+		LOG_MOD_WARN("audit", "-trap-audit-write with no -audit; ignored\n");
+		return;
+	}
+	if (!path)
+		path = audit_path;
+	if (!path)
+		return;
+	FILE *f = fopen(path, "wb");
+	if (!f) {
+		LOG_MOD_WARN("audit", "%s: %s\n", path, strerror(errno));
+		return;
+	}
+	uint8_t hdr[AUDIT_HEADER_BYTES];
+	memset(hdr, 0, sizeof(hdr));
+	memcpy(hdr, audit_magic, sizeof(audit_magic));
+	uint32_t v[4] = { AUDIT_FORMAT_VERSION, AUDIT_LEGEND_VERSION,
+	                  AUDIT_SPAN, audit_runs + 1 };
+	for (int i = 0; i < 4; i++) {
+		hdr[8 + i*4 + 0] = v[i] & 0xff;
+		hdr[8 + i*4 + 1] = (v[i] >> 8) & 0xff;
+		hdr[8 + i*4 + 2] = (v[i] >> 16) & 0xff;
+		hdr[8 + i*4 + 3] = (v[i] >> 24) & 0xff;
+	}
+	memcpy(hdr + 24, audit_build, sizeof(audit_build) - 1);
+	if (fwrite(hdr, 1, sizeof(hdr), f) != sizeof(hdr) ||
+	    fwrite(audit_base, 1, AUDIT_SPAN, f) != AUDIT_SPAN) {
+		LOG_MOD_WARN("audit", "%s: short write: %s\n", path, strerror(errno));
+	}
+	fclose(f);
+	LOG_MOD_DEBUG(1, "audit", "wrote %s\n", path);
+}
+
+void audit_shutdown(void) {
+	if (!audit_base)
+		return;
+	audit_write(NULL);
+	audit_map = NULL;
+	free(audit_base);
+	audit_base = NULL;
+	free(audit_path);
+	audit_path = NULL;
+}
diff --git a/src/audit.h b/src/audit.h
new file mode 100644
index 0000000..82150fb
--- /dev/null
+++ b/src/audit.h
@@ -0,0 +1,146 @@
+/** \file
+ *
+ *  \brief Physical-address access audit map.
+ *
+ *  \copyright Copyright 2026 xroar-dev harness
+ *
+ *  \licenseblock This file is part of XRoar, a Dragon/Tandy CoCo emulator.
+ *
+ *  XRoar is free software; you can redistribute it and/or modify it under the
+ *  terms of the GNU General Public License as published by the Free Software
+ *  Foundation, either version 3 of the License, or (at your option) any later
+ *  version.
+ *
+ *  See COPYING.GPL for redistribution conditions.
+ *
+ *  \endlicenseblock
+ *
+ *  One byte per flat physical RAM address, one bit per access class, unioned
+ *  over a run and optionally over many runs.  Answers "did this ever execute",
+ *  "how deep did the stack get", and "what did the interrupt handlers touch"
+ *  as a lookup over the finished map rather than as a stakeout with a
+ *  breakpoint.
+ *
+ *  The map is keyed on the SAME flat physical address that -trap xpc=,
+ *  -load-ram addr= and Qxroar.physmem use, so a symbol's physical address
+ *  indexes it directly.
+ *
+ *  What this deliberately does NOT do is count.  Per-address hit and cycle
+ *  counts already exist as -profile-hist (a per-physical-PC hits+cycles
+ *  table); duplicating them here would cost four to eight bytes per address
+ *  to answer a question another flag already answers better.  This map is
+ *  flags: it tells you WHETHER, and the profiler tells you HOW OFTEN.
+ */
+
+#ifndef XROAR_AUDIT_H_
+#define XROAR_AUDIT_H_
+
+#include <stdint.h>
+
+#include "mc6809/mc6809.h"
+
+// Flat physical span covered.  512K is the stock GIME maximum; the DAT board's
+// extra bank bits extend the address by two more bits, and the trap code
+// already documents 0x1fffff as the ceiling.  Covering the whole thing costs
+// 2M of host memory once and removes any dependency on machine RAM sizing.
+#define AUDIT_SPAN (0x200000)
+
+// Bit legend.  Bumped as a unit via the header's legend version if it ever
+// changes meaning, so an old map can never be silently read with a new legend.
+#define AUDIT_READ    (0x01)  // read by the CPU as data
+#define AUDIT_WRITE   (0x02)  // written by the CPU
+#define AUDIT_EXEC    (0x04)  // consumed from the instruction stream
+#define AUDIT_OPCODE  (0x08)  // ... and it is the first byte of an instruction
+#define AUDIT_STACK_S (0x10)  // address derived from S (push, pull, or S-relative)
+#define AUDIT_STACK_U (0x20)  // address derived from U
+#define AUDIT_IRQ     (0x40)  // accessed while an interrupt handler was active
+#define AUDIT_PUSHPULL (0x80) // stack push/pull traffic, not indexed addressing
+
+// The two stack flags compose rather than partition, so nothing is lost:
+//   PUSHPULL & STACK_S   the S stack proper -- its extent is the high-water mark
+//   PUSHPULL & STACK_U   the U stack, where a program keeps one
+//   STACK_U without PUSHPULL   U used as a general pointer, e.g. `lda ,u+`
+// Measured on one cold boot, the last of those outnumbers the U stack by more
+// than two hundred to one, which is why they are not one flag.
+//
+// There is no vector flag.  The 6809's hardware vectors live in ROM on this
+// machine, so a vector fetch never reaches a RAM cycle and never reaches this
+// map; the class exists in the core (MC6809_MC_VECTOR) so a vector read is not
+// miscounted as an instruction fetch, and stops there.
+
+#define AUDIT_LEGEND_VERSION (1)
+#define AUDIT_FORMAT_VERSION (1)
+#define AUDIT_HEADER_BYTES   (64)
+
+// The live map, or NULL when recording is off.  Exposed so the per-cycle mark
+// is an inlined test-and-or in the machine's memory path rather than a call.
+extern uint8_t *audit_map;
+
+inline void audit_mark(unsigned phys, uint8_t bits) {
+	if (audit_map && phys < AUDIT_SPAN)
+		audit_map[phys] |= bits;
+}
+
+// Compose one audit byte from the CPU's access class for the cycle.  The core
+// is the only place that knows an instruction fetch from a data read or a dead
+// bus cycle from a real one; the machine then pairs the result with the
+// physical address its own decode produced.  One copy for every machine on
+// the 6809 core -- nothing in it is machine state.
+//
+// EXEC and READ are deliberately exclusive: an instruction fetch is a read, but
+// conflating them would make READ useless for finding the data reads, which is
+// most of what the flag is for.
+static inline uint8_t audit_bits_mc6809(const struct MC6809 *cpu, _Bool RnW) {
+	uint8_t cls = cpu->mem_class;
+	if (cls & MC6809_MC_DEAD)
+		return 0;
+	uint8_t bits;
+	if (cls & MC6809_MC_VECTOR) {
+		// A vector read is a read, not an instruction fetch.  The
+		// vectors live in ROM on these machines, so this branch never
+		// fires for a RAM cycle; it is here so that it cannot be
+		// wrong on a machine where they do not.
+		bits = AUDIT_READ;
+	} else if (cls & MC6809_MC_FETCH) {
+		bits = AUDIT_EXEC;
+		if (cls & MC6809_MC_OPCODE)
+			bits |= AUDIT_OPCODE;
+	} else {
+		bits = RnW ? AUDIT_READ : AUDIT_WRITE;
+	}
+	if (cls & MC6809_MC_STACK_S)
+		bits |= AUDIT_STACK_S;
+	if (cls & MC6809_MC_STACK_U)
+		bits |= AUDIT_STACK_U;
+	if (cls & MC6809_MC_PUSHPULL)
+		bits |= AUDIT_PUSHPULL;
+	if (cpu->irq_depth)
+		bits |= AUDIT_IRQ;
+	return bits;
+}
+
+// -audit FILE[,seed=FILE][,start=on|off][,reset].  Allocates the map and, for
+// seed=, unions an existing file in first.  Errors are fatal: an audit run
+// that silently recorded nothing is worse than one that did not start.
+void audit_config(const char *spec);
+
+// True if -audit was given at all (whether or not recording is currently on).
+_Bool audit_configured(void);
+
+// Turn recording on or off without discarding what is already recorded.
+void audit_set_active(_Bool active);
+
+// Zero the map, keeping it configured and its active state unchanged.
+void audit_clear(void);
+
+// Write the map.  path == NULL writes to the configured -audit file.
+void audit_write(const char *path);
+
+// Write the configured file (if any) and release the map.  Called from
+// xroar_shutdown, so a run that is killed cleanly still leaves a map.
+void audit_shutdown(void);
+
+// Build id recorded in the header, for the staleness check on the reader side.
+void audit_set_build_id(const char *id);
+
+#endif
