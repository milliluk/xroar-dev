 		if (!tok)
 			continue;
 
@@ -346,6 +410,7 @@ int script_js_load(const char *path) {
 			if (a && b) {
 				struct script_step *s = push_step(&pending_delay);
 				s->type = ACT_MOVE;
+				s->port = port;
