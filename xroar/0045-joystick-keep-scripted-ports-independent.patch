+		script_js_set_button_port(s->port, (unsigned)s->a, s->b ? 1 : 0);
 		break;
 	case ACT_TYPE:
 		// Reuse XRoar's auto-typer. It breakpoints the ROM key-poll at
@@ -308,6 +357,18 @@ static struct script_step *push_step(event_ticks *pending_delay) {
 	return s;
 }
 
+static unsigned parse_port_prefix(char **tok) {
+	if (*tok && strcmp(*tok, "right") == 0) {
+		*tok = strtok(NULL, " \t\r\n");
+		return SCRIPT_RIGHT_PORT;
+	}
+	if (*tok && strcmp(*tok, "left") == 0) {
+		*tok = strtok(NULL, " \t\r\n");
+		return SCRIPT_LEFT_PORT;
+	}
+	return SCRIPT_RIGHT_PORT;
+}
+
