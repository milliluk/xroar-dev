-	if (!joystick_config_by_name("script")) {
+	// Builtin deterministic scripted joystick profiles.  "script" is a
+	// compatibility alias for the right port; explicit profiles keep the two
+	// physical ports independent.
+	struct {
+		const char *name;
+		const char *submodule;
+		const char *description;
+	} script_profiles[] = {
+		{ "script",       "script",       "Scripted right joystick (compatibility alias)" },
+		{ "script-right", "script-right", "Scripted right joystick" },
+		{ "script-left",  "script-left",  "Scripted left joystick" },
+	};
+	for (unsigned i = 0; i < ARRAY_N_ELEMENTS(script_profiles); i++) {
+		if (joystick_config_by_name(script_profiles[i].name))
+			continue;
 		struct joystick_config *jc = joystick_config_new();
-		jc->name = xstrdup("script");
-		jc->description = xstrdup("Scripted synthetic pointer");
-		jc->axis_specs[0] = xstrdup("script:x");
-		jc->axis_specs[1] = xstrdup("script:y");
-		jc->button_specs[0] = xstrdup("script:0");
+		jc->name = xstrdup(script_profiles[i].name);
+		jc->description = xstrdup(script_profiles[i].description);
+		char spec[64];
+		snprintf(spec, sizeof(spec), "%s:x", script_profiles[i].submodule);
+		jc->axis_specs[0] = xstrdup(spec);
+		snprintf(spec, sizeof(spec), "%s:y", script_profiles[i].submodule);
+		jc->axis_specs[1] = xstrdup(spec);
+		snprintf(spec, sizeof(spec), "%s:0", script_profiles[i].submodule);
+		jc->button_specs[0] = xstrdup(spec);
 	}
